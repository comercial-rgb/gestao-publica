{
  "//": "tsconfig do APP (Next.js). O backend (packages/modules) tem o seu proprio: tsconfig.backend.json — NodeNext, sem JSX/DOM. Sao incompativeis num so arquivo (bundler x NodeNext), por isso sao dois. Ver components/ui/MODULO-UI.md.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }],
    // Ver a nota longa em tsconfig.backend.json: aliases DECLARADOS, imports ainda relativos.
    "paths": {
      "@siafic/tribunais-core": ["./packages/tribunais-core/index.ts"],
      "@siafic/tribunais-core/*": ["./packages/tribunais-core/*"],
      "adapters/*": ["./adapters/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    // ⚠️ `middleware.ts` ENTROU EM 2026-09-10, PELA VARREDURA DE COBERTURA. Ele estava
    // fora dos TRÊS tsconfig — e roda em TODA requisição. Código de produção no caminho
    // mais quente do sistema, que o compilador nunca tinha olhado.
    "middleware.ts",
    // ⚠️ E os testes de UI, que precisam de `jsx` e `lib: dom` — que só este config tem.
    // Eles estavam fora por ficarem sob `test/`, que este config excluía inteiro.
    "test/ui/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  // ⚠️ `test` SAIU DO EXCLUDE, e o `include` acima é que passa a mandar: só
  // `test/ui/**/*.tsx` entra. `exclude` vence `include` no TypeScript, então manter
  // "test" aqui deixaria os testes de UI fora por mais que fossem incluídos.
  "exclude": ["node_modules", "packages", "modules", "adapters", "prisma"]
}
