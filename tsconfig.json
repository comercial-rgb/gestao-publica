{
  "//": "tsconfig do APP (Next.js). O backend (packages/modules) tem o seu proprio: tsconfig.backend.json — NodeNext, sem JSX/DOM. Sao incompativeis num so arquivo (bundler x NodeNext), por isso sao dois. Ver components/ui/MODULO-UI.md.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }],
    // Ver a nota longa em tsconfig.backend.json: aliases DECLARADOS, imports ainda relativos.
    "paths": {
      "@siafic/tribunais-core": ["./packages/tribunais-core/index.ts"],
      "@siafic/tribunais-core/*": ["./packages/tribunais-core/*"],
      "adapters/*": ["./adapters/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "packages", "modules", "adapters", "prisma", "test"]
}
