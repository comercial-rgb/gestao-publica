{
  "//": "tsconfig do APP (Next.js). O backend (packages/modules) tem o seu proprio: tsconfig.backend.json — NodeNext, sem JSX/DOM. Sao incompativeis num so arquivo (bundler x NodeNext), por isso sao dois. Ver components/ui/MODULO-UI.md.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }],
    // Ver a nota longa em tsconfig.backend.json: aliases DECLARADOS, imports ainda relativos.
    "paths": {
      "@siafic/tribunais-core": ["./packages/tribunais-core/index.ts"],
      "@siafic/tribunais-core/*": ["./packages/tribunais-core/*"],
      "adapters/*": ["./adapters/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    // ⚠️ `middleware.ts` ENTROU EM 2026-09-10, PELA VARREDURA DE COBERTURA. Ele estava
    // fora dos TRÊS tsconfig — e roda em TODA requisição. Código de produção no caminho
    // mais quente do sistema, que o compilador nunca tinha olhado.
    "middleware.ts",
    // ⚠️ E os testes de UI, que precisam de `jsx` e `lib: dom` — que só este config tem.
    // Eles estavam fora por ficarem sob `test/`, que este config excluía inteiro.
    "test/ui/**/*.tsx",
    // ⚠️ E DOIS TESTES `.ts` QUE ALCANÇAM `lib/` — ENT10. O MOTIVO É MEDIDO, NÃO ESTÉTICO.
    //
    // `lib/` é escrito para a resolução DESTE config (`bundler`: import relativo SEM
    // extensão) e mora no `include` logo abaixo. Sob `tsconfig.backend.json`, que é
    // NodeNext, o MESMO import exige `.js`. Estes dois testes são os PRIMEIROS sob `test/`
    // a importar as portas de leitura de verdade (`lib/portas/empenho`,
    // `lib/portas/contexto`) e a decisão pura de `lib/recorte` — e, por entrarem no
    // `test/**/*.ts` daquele config, arrastaram `lib/portas/**` para o alvo NodeNext pela
    // PRIMEIRA VEZ, acendendo 25 erros TS2835/TS7006 em arquivos que ninguém tinha tocado.
    //
    // ⚠️ A ALTERNATIVA MEDIDA ERA PIOR: pôr `.js` em **255 imports** de ~50 arquivos de
    // porta (só `rreo.ts` tem 33) — e `tsconfig.backend.json` avisa, no próprio comentário
    // dos aliases, que trocar a forma dos specifiers MUDA A RESOLUÇÃO EM RUNTIME. Dois
    // arquivos nomeados aqui, e os mesmos dois no `exclude` de lá, trocam alvo sem tocar
    // uma linha de código de produção.
    //
    // ⚠️ NOMEADOS UM A UM, NÃO POR GLOB. Um `test/ui/**/*.ts` mudaria de alvo outros oito
    // testes que hoje compilam bem no backend — e mudança de alvo que ninguém pediu é
    // como um config passa a divergir do que seu comentário promete.
    "test/ui/recorte-autorizado.test.ts",
    "test/caracterizacao/leitura-por-unidade.test.ts",
    "test/leitura-por-acao.test.ts",
    "test/acervo-pesquisa.test.ts",
    "test/pessoal-eixos-de-consulta.test.ts",
    "test/portal-do-servidor.test.ts",
    "test/ui/acoes-despachadas.test.ts",
    "test/ui/chave-de-comando.test.ts",
    "test/ui/descritores-consistentes.test.ts",
    // V6.2 — importa `lib/portas/opcoes-referenciadas` (resolução bundler); mesma troca medida acima.
    "test/ficha-pela-tela.test.ts",
    "test/ui/fornecedores-catalogo.test.ts",
    "test/ui/recebimentos-catalogo.test.ts",
    "test/ui/empenhos-liquidar-catalogo.test.ts",
    "test/ui/resumo-da-folha.test.ts",
    "test/ui/nota-de-estorno.test.ts",
    "test/ui/livros-com-termos.test.ts",
    "test/ui/busca-da-ficha.test.ts",
    "test/ui/pagamentos-efetuados-pdf.test.ts",
    "test/ui/cheques-porta.test.ts",
    "test/ui/bordero-de-movimentos-pdf.test.ts",
    "test/ui/ofx-texto.test.ts",
    "test/ui/conciliacao-pdf.test.ts",
    "test/ui/conciliacao-filtro.test.ts",
    "test/ui/portal-sem-encargos.test.ts",
    "test/carta-de-servicos.test.ts",
    "test/ouvidoria-e-avaliacao.test.ts",
    "test/ui/demonstrativo-das-obrigacoes.test.ts",
    "test/demonstracoes-contabeis.test.ts",
    // V9 N2 — a consulta pública de bens e a neutralização de fórmula no CSV alcançam
    // `lib/` e `lib/csv`, escritos para a resolução `bundler` deste config. Mesma troca de
    // alvo medida acima, nomeada um a um.
    "test/bens-publicos-contrato.test.ts",
    "test/csv-injecao.test.ts",
    "test/despesas-publicas-contrato.test.ts",
    // V33 — onze testes que alcançam portas escritas para esta resolução; a mesma troca, medida, nomeada um a um
    // (o motivo está no `exclude` de `tsconfig.backend.json`).
    "test/anulacoes-registradas.test.ts",
    "test/sagres-recorte-por-ug.test.ts",
    "test/sagres-por-registro.test.ts",
    "test/sagres-ugs-do-dia.test.ts",
    "test/exportacoes-federais-leitura.test.ts",
    "test/ui/contexto-do-trabalho.test.ts",
    "test/ui/menu-do-contador.test.ts",
    "test/ui/periodo-das-demonstracoes.test.ts",
    "test/ui/csv-ida-e-volta.test.ts",
    "modules/m02-planejamento/m02-comparacao-de-exercicios.test.ts",
    "modules/m05-despesa/m05-adiantamentos.test.ts",
    "modules/m12-relatorios/m12-composicao.test.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  // ⚠️ `test` SAIU DO EXCLUDE, e o `include` acima é que passa a mandar: só
  // `test/ui/**/*.tsx` entra. `exclude` vence `include` no TypeScript, então manter
  // "test" aqui deixaria os testes de UI fora por mais que fossem incluídos.
  // ⚠️ `doador` — repositório ABSORVIDO, inerte por decisão. Ver docs/doador.md.
  //
  // MEDIDO: os `include` deste arquivo são lista branca e já não o alcançavam — a
  // importação NÃO quebrou nenhum dos três typecheck. Esta linha é DECLARAÇÃO, não
  // conserto: diz, no arquivo que decide, que aquele código não é para ser compilado
  // aqui. Sem ela, a próxima linha de `include` que alargar uma raiz (um `**/*.ts`
  // apressado) puxaria 199 arquivos de terceiro para dentro do nosso gate de tipos, e o
  // primeiro erro apareceria como se fosse nosso.
  "exclude": ["node_modules", "packages", "modules", "adapters", "prisma", "doador"]
}
