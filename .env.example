DATABASE_URL="postgresql://usuario:senha@localhost:5432/siafic_cg?schema=public"

# Banco SÓ de teste — OBRIGATÓRIO para rodar a suíte.
# A suíte de integração TRUNCA as tabelas de domínio no beforeEach: ela NUNCA
# pode rodar contra dev/prod. O setup do Vitest ABORTA se esta variável faltar,
# ou se apontar para o mesmo host+porta+database+schema que DATABASE_URL.
DATABASE_URL_TEST="postgresql://usuario:senha@localhost:5432/siafic_cg_test?schema=public"

# Senha do administrador criado pelo bootstrap de instalação, e a mesma que os
# percursos de navegador usam para entrar. Sem ela, o smoke falha no login — e a
# mensagem que chega é "timeout de navegação", que acusa o lugar errado.
# NUNCA ponha aqui a senha de uma instalação real: este arquivo é versionado.
SEED_ADMIN_SENHA="troque-esta-senha"

# Quem está concedendo. `scripts/conceder-acoes-ao-perfil.ts` grava esta string
# no `criadoPor` de CADA permissão que concede, e RECUSA rodar sem ela.
#
# A razão é de desenho, não de configuração: quando uma versão nova acrescenta
# ações ao censo, elas não chegam sozinhas aos perfis que já existem — o
# administrador abre a tela nova e recebe ACESSO NEGADO. O caminho de atualização
# é este script, e conceder poder é um ATO: ele fica com o nome de quem o
# praticou. Um valor genérico aqui esvazia a auditoria que o campo existe para dar.
SEED_IDENTIDADE="nome.sobrenome@municipio.gov.br"

# OPCIONAL — e é a única das quatro que é. Senha inicial do usuário de
# demonstração que `scripts/poc-usuario-restrito.ts` cria para mostrar a
# segregação por unidade gestora: um operador que enxerga a tela e NÃO executa.
#
# Ausente, o script cai numa senha de demonstração escrita no próprio código.
# Isso é aceitável para uma apresentação e não é aceitável em mais lugar nenhum:
# a senha padrão está versionada e qualquer um a lê.
POC_SENHA_RESTRITO="troque-se-for-demonstrar-fora-da-maquina"

# Banco SÓ dos PERCURSOS DE NAVEGADOR (orquestração V3, 4.4) — o terceiro banco: nem o de
# desenvolvimento, nem o da suíte. Os percursos gravam pela tela (roteiros, bens, empenhos,
# perfis); num banco compartilhado eles deixam configuração instrumental como se fosse
# operacional. `npm run percursos:preparar` cria e povoa; `npm run percursos:servir` sobe o
# servidor em 3010 apontando para ele. O preparador RECUSA se coincidir com os outros dois.
DATABASE_URL_PERCURSOS="postgresql://usuario:senha@localhost:5432/siafic_cg_percursos?schema=public"
