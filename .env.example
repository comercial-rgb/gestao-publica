# ⚠️  Copie este arquivo para .env e preencha os valores.
# NUNCA faça commit do .env.

### ─── Portas (ajuste se já tem Postgres/Redis local rodando) ─
POSTGRES_PORT=5432
REDIS_PORT=6379
# Exemplo se houver conflito com outros containers:
# POSTGRES_PORT=5434
# REDIS_PORT=6380

### ─── Database ──────────────────────────────────────────────
# Se mudar POSTGRES_PORT acima, ajustar a porta aqui também.
DATABASE_URL="postgresql://saas:saas@localhost:5432/saas_municipal"

### ─── Redis (filas, cache, rate limit distribuído) ──────────
REDIS_URL="redis://localhost:6379"

### ─── Auth ──────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
# Ou: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Tempo de expiração do JWT em segundos. Default: 8h
AUTH_JWT_EXPIRES_IN=28800
# Tempo de expiração do refresh token em segundos. Default: 30d
AUTH_REFRESH_EXPIRES_IN=2592000

### ─── API ───────────────────────────────────────────────────
API_HOST="0.0.0.0"
API_PORT=3333
NODE_ENV="development"
# Lista de IPs isentos de rate limit (vírgula-separada). Em branco = ninguém isento.
RATE_LIMIT_ALLOWLIST=""
# Habilita Swagger em produção (deixe false em ambiente real, true só pra staging)
ENABLE_SWAGGER_IN_PROD=false

### ─── Web (Next.js) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3333"

### ─── SMTP (Mailpit em dev) ─────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SaaS Municipal <[email protected]>"

### ─── AWS S3 (anexos, textos jurídicos) ─────────────────────
AWS_REGION="sa-east-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

### ─── Seed inicial (opcional) ───────────────────────────────
# Descomente as duas linhas abaixo e defina valores para o seed
# criar o primeiro super admin ao rodar `pnpm db:seed`.
# [email protected]
# SEED_ADMIN_PASSWORD="TrocaIsso@2026!"
