// ============================================================================
// M05 — despesa: reserva → empenho → liquidação → pagamento.
//
// SALDO MATERIALIZADO POR RECÁLCULO:
//   `MovimentoDotacao` é a FONTE DA VERDADE. As colunas de saldo da
//   FichaOrcamentaria são CACHE, e só são escritas como
//   `coluna = SELECT SUM(MovimentoDotacao...)` dentro da MESMA transação que
//   insere o movimento. NUNCA `saldo = saldo ± valor` (UPDATE cego).
//   `reconciliarFicha()` compara cache vs SUM e tem de dar zero SEMPRE.
//
// APPEND-ONLY: reserva, empenho, liquidação, pagamento e seus movimentos são
// imutáveis. Sem updatedAt, sem deletedAt. Anulação = registro NOVO.
//
// STATUS É DERIVADO, NÃO COLUNA — ver nota no fim do arquivo.
// ============================================================================

enum TipoMovimentoDotacao {
  DOTACAO_INICIAL
  CREDITO_ADICIONAL
  ANULACAO_CREDITO
  RESERVA
  RESERVA_LIBERADA
  EMPENHO
  EMPENHO_ANULADO
  /// V21 — a dotação que uma LEI ESPECÍFICA move de uma programação para outra (CF art. 167, VI:
  /// remanejamento, transposição e transferência). NÃO é crédito adicional: não traz recurso
  /// novo, não consome o limite de crédito da LOA, e no plano de contas mora em
  /// 5.2.2.1.9.02 ALTERAÇÃO DA LEI ORÇAMENTÁRIA, não em 5.2.2.1.2. Por isso é tipo PRÓPRIO, e não
  /// um quarto valor de TipoCredito — aquele enum governa o limite, e dez sítios o enumeram.
  REALOCACAO_ACRESCIMO
  REALOCACAO_REDUCAO
}

enum TipoEmpenho {
  ORDINARIO
  GLOBAL
  ESTIMATIVO
}

// ----------------------------------------------------------------------------
// MovimentoDotacao — o razão do saldo orçamentário. APPEND-ONLY.
// `valor` é SEMPRE > 0; quem dá o sinal é o `tipo`.
// ----------------------------------------------------------------------------

model MovimentoDotacao {
  id      String              @id @default(cuid())
  fichaId String
  ficha   FichaOrcamentaria   @relation(fields: [fichaId], references: [id])
  tipo    TipoMovimentoDotacao
  /// SEMPRE positivo. O sinal vem do tipo (ver SINAIS em dominio.ts).
  valor   Decimal             @db.Decimal(18, 2)

  origemTipo String
  origemId   String?
  /// Movimento que ESTORNA outro (ex.: EMPENHO_ANULADO -> o EMPENHO original).
  estornoDeId String?

  /// ══ O EIXO DE REGISTRO. Instante da GRAVAÇÃO. Nunca é substituído: sem ele
  /// não há como reproduzir um demonstrativo já publicado nem investigar
  /// divergência. Ver docs/adr/ADR-competencia-no-movimento-de-dotacao.md.
  criadoEm  DateTime @default(now())
  criadoPor String

  /// ══ O EIXO DE COMPETÊNCIA. Data do EFEITO LEGAL do ato, não da digitação.
  /// É ELA que corta saldo por data, cotas, contingenciamento e demonstrativo
  /// de período — `criadoEm` NÃO serve para isso e responder por ele é o
  /// defeito que este campo cura (decreto de 20/06 digitado em 15/07).
  competencia DateTime
  /// ⚠️ A INCERTEZA MORA NO DADO, NÃO NA MEMÓRIA DE QUEM MIGROU. `true` quando
  /// a competência foi derivada de `criadoEm` por não haver ato de origem com
  /// data — hoje, as reservas, que não têm data própria. Marcar permite
  /// encontrá-las no dia em que `ReservaDotacao` ganhar data.
  competenciaDerivada Boolean @default(false)

  /// back-relation M03 — campo VIRTUAL, não gera coluna.
  itemCredito ItemCredito?
  /// back-relation M03 V21 — campo VIRTUAL, não gera coluna.
  itemDeRealocacao ItemDeRealocacao?

  @@index([fichaId, tipo])
  @@index([origemTipo, origemId])
  /// O índice do corte por data: `saldosDaFicha` com competência filtra por
  /// (ficha, competencia <= X) e agrupa por tipo.
  @@index([fichaId, competencia])
}

// ----------------------------------------------------------------------------
// ReservaDotacao — pré-empenho. APPEND-ONLY.
// NÃO tem coluna `status`: "liberada?" é DERIVADO de `estornos` e do quanto já
// foi empenhado contra ela.
// ----------------------------------------------------------------------------

model ReservaDotacao {
  id      String            @id @default(cuid())
  fichaId String
  ficha   FichaOrcamentaria @relation(fields: [fichaId], references: [id])
  valor   Decimal           @db.Decimal(18, 2)
  /// M11 — TR 4.41/4.42: a reserva pode nascer VINCULADA a um processo
  /// licitatório. NULLABLE de propósito: reserva sem licitação continua válida
  /// (é o caminho de sempre). Quando preenchida, o empenho que a consome TEM de
  /// informar um contrato DO MESMO PROCESSO — é o que a 4.42 exige ("liberado
  /// apenas quando houver vinculação com uma licitação e esta informada na
  /// emissão da nota de empenho").
  processoId String?
  processo   ProcessoLicitatorio? @relation(fields: [processoId], references: [id])

  historico   String

  estornoDeId String?
  estornoDe   ReservaDotacao?  @relation("EstornoReserva", fields: [estornoDeId], references: [id])
  estornos    ReservaDotacao[] @relation("EstornoReserva")

  empenhos ReservaEmpenho[]

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([fichaId])
  @@index([estornoDeId])
}

/// Um empenho nasce de no máximo uma reserva; o join fica explícito para não
/// pendurar FK opcional no Empenho e ter de mexer nele depois.
model ReservaEmpenho {
  reservaId String
  reserva   ReservaDotacao @relation(fields: [reservaId], references: [id])
  empenhoId String         @unique
  empenho   Empenho        @relation(fields: [empenhoId], references: [id])

  @@id([reservaId, empenhoId])
  @@index([reservaId])
}

// ----------------------------------------------------------------------------
// Empenho — APPEND-ONLY. Sem coluna `status` (ver nota no fim).
// ----------------------------------------------------------------------------

model Empenho {
  id      String            @id @default(cuid())
  fichaId String
  ficha   FichaOrcamentaria @relation(fields: [fichaId], references: [id])

  /// ADITIVO M05: opcional. O Subelemento (M02) ainda não tem seed real
  /// (arquivo TCE-PB pendente) — empenho é válido sem ele.
  subelementoId String?
  subelemento   Subelemento? @relation(fields: [subelementoId], references: [id])

  /// M11 — a dimensão CONTRATO do empenho (TR 5.6/5.101/5.102/5.112).
  ///
  /// NULLABLE de propósito: nem toda despesa vem de contrato (diárias, folha,
  /// sentenças). Um NOT NULL aqui quebraria metade do M05 e obrigaria a inventar
  /// um "contrato genérico" — que é como um sistema começa a mentir.
  ///
  /// ⚠️ A ANULAÇÃO **COPIA** este campo do original. Sem isso, a soma do
  /// empenhado por contrato veria o empenho original e não veria a anulação dele:
  /// o contrato ficaria eternamente empenhado.
  contratoId String?
  contrato   Contrato? @relation(fields: [contratoId], references: [id])

  /// M11/M10 (TR 4.49 e 5.15) — a CLASSE DE BENS que este empenho vai adquirir.
  ///
  /// NULLABLE de propósito: só é exigida quando o empenho é de CAPITAL (grupos 4 e
  /// 5) E vem de contrato — a cadeia licitatória é o escopo do TR. Custeio não
  /// compra bem, e o grupo 6 (amortização da dívida) é capital SEM bem (a lição do
  /// M10).
  ///
  /// É um vínculo SINTÉTICO — a promessa do empenho. O fato patrimonial é o
  /// `MovimentoPatrimonial` (M10), e o `adquirirBem` recusa divergir dele.
  classeDeBensId String?
  classeDeBens   ClasseDeBens? @relation(fields: [classeDeBensId], references: [id])

  /// M10 (TR 4.48) — a DÍVIDA que este empenho amortiza.
  ///
  /// NULLABLE, mas OBRIGATÓRIO no grupo 6 (Amortização da Dívida) e PROIBIDO fora
  /// dele: amortizar sem dizer QUAL dívida é pagar no escuro; e vincular dívida a
  /// um empenho de custeio é um vínculo sem sentido. Os dois lados são guard.
  dividaId String?
  divida   DividaConsolidada? @relation(fields: [dividaId], references: [id])

  /// M11 (TR 4.50) — a OBRA que este empenho executa.
  ///
  /// ⚠️ O GUARD É **UNIDIRECIONAL**, e essa é a diferença deliberada para o 4.48.
  ///   · elemento 51 (Obras e Instalações) SEM obra  -> REJEITA.
  ///   · obra num empenho de OUTRO elemento          -> PERMITIDO.
  ///
  /// O 4.48 é bicondicional (dívida fora do grupo 6 é vínculo sem sentido). Aqui não:
  /// a instalação elétrica de uma escola pode vir no elemento 39, e o ente ter todo o
  /// direito de rastreá-la na obra. Um vínculo VOLUNTÁRIO não é erro — proibi-lo
  /// obrigaria o ente a mentir na classificação para conseguir rastrear.
  ///
  /// A ANULAÇÃO (total e parcial) COPIA este campo — como copia o `contratoId`, e pelo
  /// mesmo motivo: sem isso, a soma por obra veria o empenho e não veria a redução dele.
  obraId String?
  obra   Obra?   @relation(fields: [obraId], references: [id])

  /// M28 (ENT03b) — o CONVÊNIO que este empenho executa.
  ///
  /// ⚠️ VOLUNTÁRIO, como o vínculo da obra e ao contrário do da dívida. Nem toda despesa de
  /// convênio cai num elemento exclusivo (o repasse vai no 41/42/43, mas a contrapartida do
  /// convenente vai no elemento da despesa que ela custeia) — exigir o vínculo por elemento
  /// obrigaria o ente a classificar errado para conseguir rastrear. O que o guard COBRA é o
  /// outro lado: liberar parcela de convênio sem empenho é repasse que despesa nenhuma
  /// explica.
  convenioId String?
  convenio   Convenio? @relation(fields: [convenioId], references: [id])

  /// V22 — a CAMPANHA PUBLICITÁRIA que este empenho custeia (o termo de referência pede o
  /// vínculo da nota de empenho com a campanha). VOLUNTÁRIO, como o do convênio e o da obra: a
  /// despesa de publicidade não cai num elemento exclusivo. É DIMENSÃO: a anulação o copia
  /// (DIMENSOES_DO_EMPENHO), para que o empenhado por campanha feche.
  campanhaPublicitariaId String?
  campanhaPublicitaria   CampanhaPublicitaria? @relation(fields: [campanhaPublicitariaId], references: [id])

  /// M29 (ENT03b) — o PRECATÓRIO que este empenho paga.
  precatorioId String?
  precatorio   Precatorio? @relation(fields: [precatorioId], references: [id])

  /// M30 (ENT03b) — o CONSÓRCIO a que este empenho repassa.
  consorcioId String?
  consorcio   ConsorcioPublico? @relation(fields: [consorcioId], references: [id])

  /// V5 — a ordem de compra da qual este empenho nasceu. NULLABLE: nem todo empenho
  /// vem de ordem. A anulação COPIA este campo, como copia o contratoId.
  ordemDeCompraId String?
  ordemDeCompra   OrdemDeCompra? @relation(fields: [ordemDeCompraId], references: [id])

  /// V22 — a SOLICITAÇÃO AUTORIZADA da qual este empenho foi emitido. NULLABLE: o empenho
  /// direto continua existindo (folha, encargos, ordem de compra), e exigir solicitação é
  /// decisão do ente, não do schema.
  ///
  /// ⚠️ ÚNICO, e a anulação NÃO o copia. A solicitação autoriza UM ato: a unicidade é a
  /// garantia dura contra duas emissões da mesma autorização (a trava e a situação derivada
  /// são a primeira linha, dentro da transação). Copiá-lo para a linha da anulação violaria a
  /// unicidade — e não há soma por solicitação que precise dele: ele é ORIGEM, não dimensão.
  solicitacaoDeEmpenhoId String?               @unique
  solicitacaoDeEmpenho   SolicitacaoDeEmpenho? @relation(fields: [solicitacaoDeEmpenhoId], references: [id])

  /// back-relations ENT03b — os movimentos que ESTE empenho executou. Campos VIRTUAIS.
  movimentosConvenio  MovimentoConvenio[]
  movimentosConsorcio MovimentoConsorcio[]

  numero       String
  tipo         TipoEmpenho
  valor        Decimal     @db.Decimal(18, 2)
  data         DateTime
  credorCpfCnpj String
  historico     String

  /// M06 — Lei 14.133/2021, art. 141: a ordem cronológica é por fonte,
  /// subdividida por categoria de contrato. OBRIGATÓRIO e SEM DEFAULT: um
  /// default no schema faria todo empenho silenciosamente virar
  /// FORNECIMENTO_BENS, e a fila de obras se misturaria com a de bens sem
  /// ninguém perceber. A liquidação HERDA a categoria do seu empenho.
  categoriaOrdemCronologica CategoriaOrdemCronologica

  /// A contabilização do empenho. 1-1.
  lancamentoId String             @unique
  lancamento   LancamentoContabil @relation(fields: [lancamentoId], references: [id])

  estornoDeId String?
  estornoDe   Empenho?  @relation("EstornoEmpenho", fields: [estornoDeId], references: [id])
  estornos    Empenho[] @relation("EstornoEmpenho")

  /// TR 5.35 — ANULAÇÃO PARCIAL. NÃO é estorno: o fato original CONTINUA valendo, por
  /// MENOS. Por isso a coluna é PRÓPRIA — usar `estornoDeId` faria toda leitura
  /// líquida do repositório ZERAR o fato inteiro (a fila do art. 141, o saldo do
  /// contrato, o superávit por fonte, o relatório de restos — todos de uma vez).
  /// Quem soma: packages/estornaveis.
  anulacaoParcialDeId String?
  anulacaoParcialDe   Empenho? @relation("AnulacaoParcialEmpenho", fields: [anulacaoParcialDeId], references: [id])
  anulacoesParciais   Empenho[] @relation("AnulacaoParcialEmpenho")

  reserva     ReservaEmpenho?
  liquidacoes Liquidacao[]
  /// back-relation M08 — campo VIRTUAL, não gera coluna.
  inscricoesRestos InscricaoRestosAPagar[]
  /// back-relation V6 P2.3b — o elo com a folha que o gerou, quando veio de uma apropriação.
  daFolha EmpenhoDaFolha?
  /// V6.2 — o elo com a apuração dos encargos da folha. VIRTUAL.
  dosEncargos EmpenhoDosEncargos? @relation("EmpenhoDosEncargos")
  /// V7 M1 U3 — o rastro do ajuste para baixo dos encargos quando ESTA linha é a anulação parcial. VIRTUAL.
  ajusteDosEncargos AjusteDosEncargos? @relation("AnulacaoDeEmpenhoDosEncargos")

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([fichaId, numero])
  @@index([fichaId])
  @@index([estornoDeId])
  @@index([credorCpfCnpj])
  @@index([ordemDeCompraId])

  /// M22 (ENT03a) — o documento gerado para assinatura. Campo VIRTUAL.
  anexos Anexo[]
  /// V5 — documentos fiscais que declararam este empenho na origem.
  documentosFiscais DocumentoFiscalRecebido[] @relation("DocumentoFiscalDoEmpenho")
  /// V7 M2 U1 — as ordens de serviço do contrato que indicaram este empenho. VIRTUAL.
  ordensDeServicoDoContrato OrdemDeServicoDoContrato[] @relation("EmpenhoDaOrdemDeServico")
}

// ----------------------------------------------------------------------------
// BLOCO 2 — liquidação e pagamento. APPEND-ONLY, como tudo aqui.
// Nenhuma coluna de status: o estado do empenho é DERIVADO dos SUMs
// (statusDoEmpenho, em dominio.ts).
// ----------------------------------------------------------------------------

model Liquidacao {
  id        String  @id @default(cuid())
  empenhoId String
  empenho   Empenho @relation(fields: [empenhoId], references: [id])

  /// M11 (ENT03b) — a MEDIÇÃO que autorizou esta liquidação.
  ///
  /// ⚠️ NULLABLE NA COLUNA, OBRIGATÓRIA NO GUARD quando o empenho tem obra. O NOT NULL aqui
  /// invalidaria toda liquidação já gravada, e a liquidação de custeio não tem medição
  /// nenhuma. Quem cobra é o caso de uso: empenho COM obra exige medição APROVADA, e a
  /// medição tem de ser da mesma obra.
  medicaoId String?
  medicao   MedicaoDeObra? @relation(fields: [medicaoId], references: [id])

  numero            String
  valor             Decimal  @db.Decimal(18, 2)
  data              DateTime
  responsavelAtesto String

  /// V23 — o MOTIVO da anulação (inteira ou parcial) da liquidação: SAGRES EstornoLiquidacao §4.11,
  /// obrigatório, até 120. Nulo na liquidação genuína e nas anulações gravadas antes (inventar um
  /// motivo retroativo seria pior que não ter nenhum; o gerador recusa nomeando).
  motivo String?

  /// Nota fiscal — opcional (nem toda liquidação tem NF). Quando há
  /// `documentoFiscalId`, estes campos são COPIADOS do documento na gravação para
  /// os leiautes de tribunal continuarem lendo a liquidação.
  notaFiscalChave  String?
  notaFiscalNum    String?
  notaFiscalSerie  String?
  notaFiscalData   DateTime?
  notaFiscalValor  Decimal?  @db.Decimal(18, 2)

  /// V5 — o documento fiscal recebido que lastreia esta liquidação. Registrar a nota
  /// NÃO liquida; liquidar aponta para a nota já conferida.
  documentoFiscalId String?
  documentoFiscal   DocumentoFiscalRecebido? @relation(fields: [documentoFiscalId], references: [id])

  lancamentoId String             @unique
  lancamento   LancamentoContabil @relation(fields: [lancamentoId], references: [id])

  estornoDeId String?
  estornoDe   Liquidacao?  @relation("EstornoLiquidacao", fields: [estornoDeId], references: [id])
  estornos    Liquidacao[] @relation("EstornoLiquidacao")

  /// TR 5.35 — ANULAÇÃO PARCIAL. NÃO é estorno: o fato original CONTINUA valendo, por
  /// MENOS. Por isso a coluna é PRÓPRIA — usar `estornoDeId` faria toda leitura
  /// líquida do repositório ZERAR o fato inteiro (a fila do art. 141, o saldo do
  /// contrato, o superávit por fonte, o relatório de restos — todos de uma vez).
  /// Quem soma: packages/estornaveis.
  anulacaoParcialDeId String?
  anulacaoParcialDe   Liquidacao? @relation("AnulacaoParcialLiquidacao", fields: [anulacaoParcialDeId], references: [id])
  anulacoesParciais   Liquidacao[] @relation("AnulacaoParcialLiquidacao")

  pagamentos Pagamento[]
  /// back-relation T07 — as ordens de pagamento preparadas sobre esta liquidação.
  ordensDePagamento OrdemDePagamento[]
  /// back-relation M06 — campo VIRTUAL, não gera coluna.
  quebrasDeOrdem JustificativaQuebraOrdem[]
  /// back-relation M10 — campo VIRTUAL, não gera coluna.
  movimentosPatrimoniais MovimentoPatrimonial[]

  /// V19/C05 — as apropriações de CUSTO deste fato. Campo VIRTUAL: a apropriação
  /// referencia a liquidação e NÃO lança no razão (não se reconhece a despesa duas vezes).
  apropriacoesDeCusto ApropriacaoDeCusto[]

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([empenhoId, numero])
  @@index([empenhoId])
  @@index([estornoDeId])
  /// A fila do art. 141 ordena por data de liquidação.
  @@index([data])
  @@index([documentoFiscalId])
  /// back-relation M10 (TR 5.85) — a entrada no almoxarifado nasce da liquidação.
  entradasAlmoxarifado MovimentoAlmoxarifado[]

  /// M22 (ENT03a) — o documento gerado para assinatura. Campo VIRTUAL.
  anexos Anexo[]

  /// M33 (V6.1) — o elo com o empenho da folha, quando esta liquidação nasceu da folha. VIRTUAL.
  liquidacaoDaFolha LiquidacaoDaFolha?
  /// V6.2 — o elo com a liquidação dos encargos da folha. VIRTUAL.
  liquidacaoDosEncargos LiquidacaoDosEncargos? @relation("LiquidacaoDosEncargos")
  /// V7 M1 U3 — o rastro do ajuste para baixo quando ESTA linha é a anulação parcial. VIRTUAL.
  ajusteDosEncargos     AjusteDosEncargos?     @relation("AnulacaoDeLiquidacaoDosEncargos")
  /// V7 M2 U3 — as parcelas recebidas do contrato que esta liquidação consumiu. VIRTUAL.
  alocacoesNaParcela    AlocacaoDaLiquidacaoNaParcela[] @relation("AlocacoesDaLiquidacao")
}

/// Conta bancária do ente. Existe para que a TR 5.23 seja VERIFICÁVEL: sem
/// saber a fonte da conta, "a fonte do pagamento tem de casar com a fonte da
/// conta" é uma regra que não dá para checar. `Pagamento.contaBancaria` guarda
/// o código, e o adapter confere a fonte contra esta tabela.
model ContaBancaria {
  id        String       @id @default(cuid())
  codigo    String       @unique
  descricao String
  fonteId   String
  fonte     FonteRecurso @relation(fields: [fonteId], references: [id])

  /// M09 — a conta do PCASP que ESTA conta bancária movimenta.
  ///
  /// NULLABLE de propósito: a coluna entra sem backfill e sem default (migration
  /// aditiva pura, um passo só). Um default seria pior que nulo — apontaria toda
  /// conta bancária para uma conta contábil inventada, e a conciliação
  /// compararia o extrato de um banco com o razão de outro.
  /// A conciliação EXIGE o mapeamento e FALHA com mensagem se ele faltar: é o
  /// operador que sabe qual conta contábil é qual, não o sistema.
  contaContabilId String?
  contaContabil   ContaPcasp? @relation(fields: [contaContabilId], references: [id])

  /// ── ADITIVO SAGRES (M15, S2) — a IDENTIFICAÇÃO BANCÁRIA estruturada ──
  ///
  /// O SAGRES (CadastroContaBancaria §4.23, SaldoMensal §4.26) exige banco (FEBRABAN, 3),
  /// agência e conta COM DÍGITO. O modelo só tinha um `codigo` interno — insuficiente. Estes
  /// campos são o DADO CRU (só dígitos, sem máscara); a máscara BR (`00000-0`) é da UI.
  ///
  /// NULLABLE, aditiva, SEM backfill e SEM default — exatamente a doutrina do `contaContabilId`
  /// logo acima: um default carimbaria toda conta com um banco inventado. Quem exporta SAGRES é
  /// FAIL-CLOSED e recusa a conta sem a tripla, nomeando-a; quem não exporta não é afetado.
  banco         String? @db.VarChar(3)
  agencia       String?
  digitoAgencia String?
  conta         String?
  digitoConta   String?

  /// back-relations M07 / M09 — campos VIRTUAIS, não geram coluna.
  movimentosExtra    MovimentoExtraorcamentario[]
  extratos           ExtratoBancario[]
  lancamentosExtrato LancamentoExtrato[]
  transferenciasOrigem  TransferenciaEntreContas[] @relation("TransferenciaOrigem")
  transferenciasDestino TransferenciaEntreContas[] @relation("TransferenciaDestino")
  /// M09 — depósito, saque, aplicação, resgate, rendimento e tarifa. Campo VIRTUAL.
  movimentosBancarios   MovimentoBancario[]
  /// M09/ENT03a — o rol de fontes que ESTA conta pode conter (TR 5.10.2.6). VIRTUAL.
  fontesPermitidas      FonteDaContaBancaria[]
  /// M09/ENT03a — as conciliações desta conta, por período. VIRTUAL.
  conciliacoes          ConciliacaoBancaria[]
  /// V6 P1.2 — as arrecadações que declararam esta conta, e as atribuições do legado.
  arrecadacoes             ReceitaArrecadada[]
  atribuicoesDeArrecadacao AtribuicaoDeContaDaArrecadacao[]
  /// M01 — as declarações de TITULARIDADE desta conta, versionadas (a vigente é a de maior
  /// versão). Campo VIRTUAL: nenhuma coluna nova em `ContaBancaria`. Ver
  /// `m01-entidade-contabil.prisma` — o titular é decisão vigente, e trocar de titular é fato
  /// novo, não `UPDATE` numa coluna daqui.
  declaracoesDeTitular     DeclaracaoDeTitularDaConta[]

  @@index([fonteId])

  /// back-relation M09 — os lotes de pagamento que saem desta conta. Campo VIRTUAL.
  lotesDePagamento LoteDePagamento[]
}

model Pagamento {
  id           String     @id @default(cuid())
  /// V26 — retenção própria do Tesouro (m07-retencao-propria.prisma).
  retencoesProprias RetencaoPropriaDoPagamento[] @relation("RetencoesPropriasDoPagamento")
  liquidacaoId String
  liquidacao   Liquidacao @relation(fields: [liquidacaoId], references: [id])

  numero String
  valor  Decimal  @db.Decimal(18, 2)
  data   DateTime

  /// Código da ContaBancaria de onde saiu o dinheiro.
  contaBancaria String
  /// TR 5.23: TEM de ser igual à fonte da conta bancária acima.
  fonteId       String
  fonte         FonteRecurso @relation(fields: [fonteId], references: [id])

  lancamentoId String             @unique
  lancamento   LancamentoContabil @relation(fields: [lancamentoId], references: [id])

  /// T07 — a ORDEM que autorizou este pagamento. NULLABLE, aditiva, sem backfill:
  /// os pagamentos que já existem nasceram antes de a ordem existir, e inventar
  /// uma autorização retroativa seria pior que não ter nenhuma.
  ///
  /// ⚠️ `@unique`: uma ordem autorizada paga UMA vez. Sem isto, a mesma
  /// autorização poderia lastrear dois desembolsos — e os dois pareceriam
  /// regulares, cada um com a sua assinatura.
  ordemDePagamentoId String?           @unique
  ordemDePagamento   OrdemDePagamento? @relation(fields: [ordemDePagamentoId], references: [id])

  /// V21 — POR QUE o pagamento foi anulado (inteiro ou em parte). Só existe nas linhas de ANULAÇÃO;
  /// nulo no pagamento genuíno e nas anulações gravadas antes da V21 (sem backfill: inventar um
  /// motivo retroativo seria pior que não ter nenhum). A tela sempre exigiu o texto e o serviço o
  /// DESCARTAVA antes do banco — e o SAGRES (§4.13, EstornoPagamento) o exige, até 120 caracteres.
  motivo String?

  estornoDeId String?
  estornoDe   Pagamento?  @relation("EstornoPagamento", fields: [estornoDeId], references: [id])
  estornos    Pagamento[] @relation("EstornoPagamento")

  /// TR 5.35 — ANULAÇÃO PARCIAL. NÃO é estorno: o fato original CONTINUA valendo, por
  /// MENOS. Por isso a coluna é PRÓPRIA — usar `estornoDeId` faria toda leitura
  /// líquida do repositório ZERAR o fato inteiro (a fila do art. 141, o saldo do
  /// contrato, o superávit por fonte, o relatório de restos — todos de uma vez).
  /// Quem soma: packages/estornaveis.
  anulacaoParcialDeId String?
  anulacaoParcialDe   Pagamento? @relation("AnulacaoParcialPagamento", fields: [anulacaoParcialDeId], references: [id])
  anulacoesParciais   Pagamento[] @relation("AnulacaoParcialPagamento")

  /// back-relations M08 / M07 — campos VIRTUAIS, não geram coluna.
  movimentosRestos MovimentoRestosAPagar[]
  retencoes        MovimentoExtraorcamentario[]
  /// V24 — back-relation VIRTUAL: a memória do cálculo das retenções deste pagamento.
  calculosDaRetencao CalculoDaRetencao[]
  /// back-relation M10 — a AMORTIZACAO nasce dentro do pagamento e morre com ele.
  movimentosDivida MovimentoDivida[]
  /// ENT03b — o precatório que este pagamento quitou. Campo VIRTUAL.
  movimentosPrecatorio MovimentoPrecatorio[]
  /// V7 M1 U3 — a guia de recolhimento que este pagamento baixou. Campo VIRTUAL.
  baixaDeGuia BaixaDaGuia? @relation("BaixaDeGuiaDeRecolhimento")

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([liquidacaoId, numero])
  @@index([liquidacaoId])
  @@index([fonteId])
  @@index([estornoDeId])
}

// ----------------------------------------------------------------------------
// NOTA — POR QUE NÃO EXISTE COLUNA `status`
//
// O spec pedia `status StatusEmpenho` no Empenho E append-only na mesma frase.
// As duas coisas não coexistem: para o status andar (EMPENHADO ->
// PARCIAL_LIQUIDADO -> ...) seria preciso dar UPDATE no empenho, que é
// exatamente o que o append-only proíbe. Um status gravado na criação ficaria
// congelado em EMPENHADO para sempre — pior que não ter.
//
// O próprio spec diz "máquinas de estado DERIVADAS dos valores, não campo
// editável solto". É o que fizemos: `statusDoEmpenho()` (dominio.ts, puro)
// calcula o estado a partir dos SUMs de liquidação/pagamento/anulação — mesmo
// padrão do saldo da ficha, mas sem nem precisar de cache.
// ----------------------------------------------------------------------------

/// ROTEIRO CONTÁBIL DO SUBSISTEMA ORÇAMENTÁRIO (tabela-parâmetro).
///
/// ⚠️ POR QUE ELE NASCE AGORA, E O QUE ELE CURA.
/// Até 09406c1 o razão só conhecia DUAS pernas da dotação: o EMPENHO (D crédito
/// disponível / C crédito empenhado) e o seu estorno. A LOA, os créditos adicionais e
/// as reservas viviam SÓ no `MovimentoDotacao` — nunca tocaram o razão. Resultado, que
/// a MSC (M14) expôs no t1 de 46dfd5d: o CRÉDITO DISPONÍVEL era **debitado** pelo
/// empenho e **nunca creditado** pela dotação. Uma conta CREDORA com saldo DEVEDOR,
/// permanente — e o subsistema orçamentário do razão simplesmente NÃO refletia o
/// orçamento. O balancete fechava (todo lançamento é balanceado), e foi por isso que
/// nenhuma amarração pegou.
///
/// FAIL-CLOSED: tipo que deve lançar e não tem roteiro = a operação INTEIRA cai. Um
/// movimento de dotação sem a sua perna no razão é a volta do mesmo furo.
///
/// O EMPENHO e o EMPENHO_ANULADO **não entram aqui** — o M05 já os lança pelo roteiro
/// que o chamador passa. Um roteiro paralelo os lançaria DUAS vezes: é a lição da
/// ENTRADA do almoxarifado (que não tem roteiro próprio porque a liquidação já debitou
/// o estoque).
///
/// ⚠️ A CHAVE NÃO É MAIS SÓ O TIPO DE MOVIMENTO (V11 V7.1). O PCASP particiona
/// `5.2.2.1.2 DOTAÇÃO ADICIONAL POR TIPO DE CREDITO` — o nome da conta sintética diz
/// literalmente por que: o crédito adicional se classifica pelo TIPO DE CRÉDITO, e
/// suplementar, especial e extraordinário vão para contas DIFERENTES. Com `tipo @unique`
/// havia lugar para UM roteiro de `CREDITO_ADICIONAL`, e apontá-lo para a suplementar
/// lançaria todo especial e todo extraordinário como suplementar — erro que só apareceria
/// no balancete e na remessa.
///
/// `tipoCredito` é o discriminador, e ele é NULO para todo movimento que não seja crédito
/// adicional. O CHECK `ck_roteiro_tipo_de_credito` (migration) amarra a equivalência nos
/// dois sentidos: preenchido SE E SOMENTE SE `tipo = CREDITO_ADICIONAL`. Um roteiro de
/// RESERVA com tipo de crédito, ou um crédito adicional sem ele, não entram no banco.
///
/// ⚠️ E O `@@unique` COMPOSTO NÃO FECHA SOZINHO: no Postgres, dois NULL são distintos, e
/// (DOTACAO_INICIAL, NULL) caberia duas vezes. Quem fecha é o índice parcial
/// `uq_roteiro_sem_tipo_de_credito` em `prisma/sql/` — a mesma divisão de trabalho do
/// `uq_dotacao_inicial_unica`.
model RoteiroOrcamentario {
  id   String               @id @default(cuid())
  tipo TipoMovimentoDotacao

  /// O tipo de crédito, SÓ para `CREDITO_ADICIONAL`. Vem da LEI que autorizou
  /// (`LeiCredito.tipoCredito`), pelo caminho movimento -> item -> decreto -> lei, o
  /// mesmo que o MANAD (M14) já percorre. NÃO é coluna de `MovimentoDotacao`: gravá-lo lá
  /// criaria a segunda verdade sobre o tipo do mesmo crédito.
  tipoCredito TipoCredito?

  /// ⚠️ A TERCEIRA DIMENSÃO DA CHAVE (V11 V8.8) — e ela fecha `ROTEIRO-SEM-DIMENSAO-DA-ABERTURA`.
  ///
  /// O PCASP parte o ramo do ESPECIAL e do EXTRAORDINÁRIO em ABERTOS e REABERTOS. Sem esta
  /// coluna, o crédito reaberto do exercício seguinte lançava na MESMA conta do aberto — e é
  /// exatamente essa diferença que o TCE lê.
  ///
  /// NULO onde a abertura não se aplica: dotação inicial, reserva, anulação e o crédito
  /// SUPLEMENTAR, que não se reabre (o § 2º alcança só especial e extraordinário). O CHECK
  /// `ck_roteiro_abertura_so_de_credito_reabrivel` é quem impede que ela apareça fora daí —
  /// uma abertura numa linha de RESERVA criaria uma chave que nenhuma leitura procura.
  ///
  /// ⚠️ NULO TAMBÉM NAS LINHAS ANTERIORES À DIMENSÃO, e essas o razão NÃO usa mais para
  /// especial/extraordinário: ler uma delas classificaria o reaberto pela decisão tomada quando
  /// a pergunta ainda não existia. A leitura é fail-closed e nomeia a abertura que falta.
  abertura AberturaDoCredito?

  contaDebitoId String
  contaDebito   ContaPcasp @relation("DebitoOrcamentario", fields: [contaDebitoId], references: [id])

  contaCreditoId String
  contaCredito   ContaPcasp @relation("CreditoOrcamentario", fields: [contaCreditoId], references: [id])

  /// ⚠️ VERSIONADO (V11 V8.4), pela mesma razão da `DisponibilidadeRecursoNovo`: o ente TROCA a
  /// classificação — o plano dele muda, o TCE orienta diferente — e o razão escriturado ontem foi
  /// feito contra o roteiro de ontem. Um `UPDATE` apagaria a resposta para "contra que roteiro
  /// este lançamento foi feito?", e o papel de runtime não tem UPDATE nesta tabela de todo jeito.
  /// A VIGENTE é a de maior versão.
  versao Int @default(1)

  /// Por que ESTAS contas. Nulo nas linhas que o seed criou — o seed não tem fundamento a dar, e
  /// fingir um seria pior que a ausência. A tela NOMEIA a diferença.
  fundamento String?

  criadoEm  DateTime @default(now())
  criadoPor String

  /// ⚠️ A VERSÃO CONTINUA SENDO ÚNICA POR (tipo, tipoCredito) — e a abertura NÃO entra aqui,
  /// de propósito. A versão é a SEQUÊNCIA DAS DECISÕES do ente sobre aquele tipo de crédito:
  /// publicar o ABERTO e depois o REABERTO dá v1 e v2, e a vigente de cada um é a maior versão
  /// COM A SUA abertura. Pôr a abertura na chave da versão obrigaria a derrubar este índice —
  /// e migration aqui é aditiva, zero DROP.
  @@unique([tipo, tipoCredito, versao])
  @@index([tipo, tipoCredito, versao])
  @@index([tipo, tipoCredito, abertura, versao])
}

/// ═══ EM QUE EIXO O ENTE REGISTRA A DOTAÇÃO ADICIONAL (V11 V8.9) ═══
///
/// `5.2.2.1.2 DOTAÇÃO ADICIONAL POR TIPO DE CREDITO` e `5.2.2.1.3 DOTAÇÃO ADICIONAL POR FONTE`
/// são IRMÃS sob `5.2.2.1 DOTAÇÃO ORÇAMENTÁRIA`, e as duas descrevem o MESMO crédito por eixos
/// diferentes: uma pergunta "que espécie de crédito é" (suplementar, especial, extraordinário) e
/// a outra "de onde veio o dinheiro" (superávit, excesso, anulação, operação de crédito).
///
/// ⚠️ O SISTEMA SÓ LANÇAVA NA `.2`, e a `.3` ficava vazia em todo demonstrativo que a lesse —
/// pendência `DOTACAO-ADICIONAL-POR-TIPO-E-POR-FONTE`. Qual das duas o ente adota é decisão
/// contábil dele, e é isto que este modelo guarda: append-only, versionado, com fundamento.
///
/// ⚠️ E NÃO EXISTE "AS DUAS AO MESMO TEMPO" AQUI, com motivo medido no plano. A perna do
/// crédito, nos dois eixos, é a MESMA conta — o crédito disponível (`6.2.2.1.1`). Lançar os dois
/// eixos creditaria o disponível DUAS VEZES pelo mesmo decreto: o ente passaria a poder empenhar
/// o dobro do que a lei autorizou. Não há, no plano, contrapartida para uma segunda perna que
/// não faça isso — e inventá-la seria inventar norma da STN. Por isso o eixo é UM.
enum EixoDaDotacaoAdicional {
  /// O que o sistema faz desde sempre: a conta sai do TIPO do crédito (`RoteiroOrcamentario`).
  POR_TIPO_DE_CREDITO

  /// A conta sai da ORIGEM do recurso do decreto (`RoteiroDaDotacaoPorFonte`).
  POR_FONTE
}

/// A decisão do ente sobre o eixo — um FATO, com autor, data e fundamento (V11 V8.9).
///
/// ⚠️ APPEND-ONLY E VERSIONADA, pela mesma razão do `RoteiroOrcamentario`: o razão escriturado
/// ontem foi feito sob a política de ontem, e a pergunta "sob que política este lançamento foi
/// feito?" tem de ter resposta. A VIGENTE é a de maior versão.
///
/// ⚠️ AUSENTE NÃO É ERRO: é a instalação que ninguém configurou, e ela vale como
/// `POR_TIPO_DE_CREDITO` — o comportamento que todo banco existente já tem. Fail-closed aqui
/// derrubaria todo crédito adicional de toda instalação viva para cobrar uma decisão que elas já
/// tomaram por omissão. A tela NOMEIA a diferença entre decidido e herdado.
model PoliticaDaDotacaoAdicional {
  id   String                 @id @default(cuid())
  eixo EixoDaDotacaoAdicional

  /// Por que ESTE eixo. Obrigatório — é o que a prestação de contas lê.
  fundamento String

  versao    Int
  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([versao])
  @@index([versao])
}

/// O ROTEIRO DO EIXO POR FONTE — a conta sai da ORIGEM do recurso (V11 V8.9).
///
/// ⚠️ TABELA PRÓPRIA, E NÃO UMA QUINTA DIMENSÃO DO `RoteiroOrcamentario`. A origem só classifica
/// o crédito adicional; pendurá-la na chave que também serve dotação inicial, reserva e anulação
/// criaria uma coluna nula em quase toda linha e uma combinação de nulos que nenhum índice
/// representa. O molde não cresce para acomodar exceção.
///
/// ⚠️ AS QUATRO ORIGENS DO DOMÍNIO TÊM UMA ANALÍTICA CADA no ramo `5.2.2.1.3`, e a partição do
/// plano é o MESMO eixo do enum (`OrigemRecurso`) — como já era com o suplementar em V7.1. Por
/// isso o seed as semeia; o que ele não faz é escolher o EIXO, que é a decisão de verdade.
model RoteiroDaDotacaoPorFonte {
  id     String        @id @default(cuid())
  origem OrigemRecurso

  contaDebitoId String
  contaDebito   ContaPcasp @relation("DebitoPorFonte", fields: [contaDebitoId], references: [id])

  contaCreditoId String
  contaCredito   ContaPcasp @relation("CreditoPorFonte", fields: [contaCreditoId], references: [id])

  /// Nulo nas linhas que o seed criou — o seed não tem fundamento a dar, e fingir um seria pior
  /// que a ausência. A tela NOMEIA a diferença.
  fundamento String?

  versao    Int      @default(1)
  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([origem, versao])
  @@index([origem, versao])
}


/// V22 — O NUMERADOR DOS DOCUMENTOS QUE O SISTEMA NUMERA (a folha e os encargos).
///
/// O SAGRES (TCE-PB) recebe o número do empenho, da liquidação e da anulação como NUMÉRICO de 7
/// posições. O número digitado pelo operador continua dele; o que o SISTEMA gera (empenho da folha,
/// empenho e anulações dos encargos) vem daqui: a `chave` é a identidade determinística do documento
/// (o texto que antes era gravado como número, com a ficha), e o `numero` é o próximo do sequencial
/// do exercício, acima do maior número numérico já usado em empenho ou liquidação. Mesma chave, mesmo
/// número — é o que mantém a retomada idempotente. E número reservado só é gravado por quem traz a
/// chave (`exigirUsoDoNumero`, no adapter do M05). Append-only: o runtime só insere.
model NumeroReservado {
  id        String @id @default(cuid())
  exercicio Int
  /// Hoje sempre DOCUMENTO: empenho e liquidação dividem UM espaço de números por exercício (a
  /// liquidação da folha leva o número do empenho). A coluna fica para uma espécie futura.
  especie   String
  chave     String
  numero    String
  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([exercicio, especie, chave])
  @@unique([exercicio, especie, numero])
}
