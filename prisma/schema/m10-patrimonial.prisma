// ============================================================================
// M10 — patrimonial: classes de bens, bens individualizados e movimentos.
//
// TR 3.1  — registro INDIVIDUALIZADO do bem (cadastro + amarração opcional).
// TR 5.84 — lançamentos contábeis SINTÉTICOS, por CLASSE. Rol de tipos FECHADO.
// TR 5.15 — levantamento por classe.
//
// ═══ O GRÃO É A CLASSE ═══
// O lançamento contábil é da CLASSE, sempre. O bem é IDENTIDADE (o que é, onde
// está, quando entrou) — e o `bemId` no movimento é uma AMARRAÇÃO OPCIONAL: ela
// permite responder "quanto vale ESTE bem?" sem quebrar o sintético.
//
// ═══ O CADASTRO NÃO TEM VALOR ═══
// `BemPatrimonial` NÃO tem coluna de valor, e isso é o ponto: valor é FUNÇÃO dos
// movimentos (SUM com sinal), nunca um número guardado. Uma coluna `valorAtual`
// precisaria de UPDATE a cada depreciação — e derraparia no primeiro estorno.
//
// APPEND-ONLY em tudo. Sem updatedAt, sem deletedAt.
// ============================================================================

enum EspecieDeBem {
  MOVEL
  IMOVEL
}

/// ⚠️ ROL FECHADO (TR 5.84). Os ESTORNOS existem DESDE O DIA 1 — a lição do M08,
/// onde o estorno chegou depois e custou dois bugs seguidos (345af7d, 4768cff).
/// O sinal de cada tipo vive em `SINAL_MOVIMENTO_PATRIMONIAL` (dominio.ts), e o
/// `Record` exaustivo faz o TypeScript apontar quem esquecer de tratar um tipo.
enum TipoMovimentoPatrimonial {
  // ── AUMENTAM o valor contábil (+1) ──
  AQUISICAO
  AVALIACAO_INICIAL
  CUSTO_SUBSEQUENTE
  DOACAO_RECEBIDA
  REAVALIACAO_AUMENTO

  // ── REDUZEM o valor contábil (−1) ──
  DEPRECIACAO
  /// MCASP 1.1.5 — o trio da redução do valor recuperável é depreciação (bens
  /// tangíveis), AMORTIZAÇÃO (intangíveis) e exaustão (recursos naturais). O rol
  /// do TR 5.84 é exemplificativo ("tais como"), e o MCASP exige os três.
  AMORTIZACAO
  EXAUSTAO
  IMPAIRMENT
  REAVALIACAO_REDUCAO
  DOACAO_REALIZADA
  BAIXA_ALIENACAO

  // ── AUMENTA o valor contábil (+1), mas é RETIFICADORA ──
  /// A baixa da DEPRECIAÇÃO ACUMULADA do bem alienado (TR 4.65).
  ///
  /// ⚠️ DUAS CLASSIFICAÇÕES, E AS DUAS SÃO DELIBERADAS:
  ///  · SINAL = +1 — ela REDUZ a acumulada, e a acumulada é NEGATIVA no contábil;
  ///    tirar um número negativo AUMENTA o valor contábil. (Faz sentido: o bem
  ///    sai com valor bruto E com a depreciação dele; o líquido baixado é a
  ///    diferença.)
  ///  · EH_ATUALIZACAO_ACUMULADA = true — ela é RETIFICADORA: mexe na acumulada,
  ///    NÃO no valor bruto. Se entrasse no bruto, o bem alienado sairia do ativo
  ///    pelo líquido e a base depreciável das parcelas seguintes ficaria maior do
  ///    que o ativo que sobrou.
  BAIXA_DE_ATUALIZACAO_ACUMULADA

  // ── ESTORNOS: sinal OPOSTO ao do movimento que desfazem ──
  ESTORNO_AQUISICAO
  ESTORNO_AVALIACAO_INICIAL
  ESTORNO_CUSTO_SUBSEQUENTE
  ESTORNO_DOACAO_RECEBIDA
  ESTORNO_REAVALIACAO_AUMENTO
  ESTORNO_DEPRECIACAO
  ESTORNO_AMORTIZACAO
  ESTORNO_EXAUSTAO
  ESTORNO_IMPAIRMENT
  ESTORNO_REAVALIACAO_REDUCAO
  ESTORNO_DOACAO_REALIZADA
  ESTORNO_BAIXA_ALIENACAO
  ESTORNO_BAIXA_DE_ATUALIZACAO_ACUMULADA
}

/// As chaves de roteiro do RESULTADO da alienação (TR 4.65).
///
/// NÃO são tipos de movimento: o ganho/perda não muda o ativo — ele já saiu pela
/// baixa. É só um lançamento de resultado. Por isso vivem num enum PRÓPRIO, e não
/// dentro de `TipoMovimentoPatrimonial`: enfiá-las lá poluiria os dois Records
/// exaustivos (sinal e retificadora) com valores que não são movimento nenhum — e
/// são justamente esses Records que seguram a corretude do módulo.
enum ChaveResultadoAlienacao {
  GANHO_ALIENACAO
  PERDA_ALIENACAO
}

// ----------------------------------------------------------------------------
// ClasseDeBens — o grão do sintético (TR 5.84 / 5.15).
// ----------------------------------------------------------------------------

model ClasseDeBens {
  id        String       @id @default(cuid())
  codigo    String       @unique
  descricao String
  especie   EspecieDeBem

  /// A conta de ATIVO do PCASP que esta classe movimenta. Vem por PARÂMETRO,
  /// como todo código contábil do projeto — nada é inventado no código.
  contaContabilAtivoId String
  contaContabilAtivo   ContaPcasp @relation("AtivoDaClasse", fields: [contaContabilAtivoId], references: [id])
  /// V3 (pacote 2) — as versões do parâmetro de atualização desta classe.
  versoesDeParametro VersaoDeParametroDeAtualizacao[] @relation("VersoesDeParametro")

  ativa Boolean @default(true)

  bens       BemPatrimonial[]
  movimentos MovimentoPatrimonial[]
  /// back-relation M05/M11 (TR 4.49) — campo VIRTUAL, não gera coluna.
  empenhos   Empenho[]
  parametro  ParametroAtualizacaoClasse?
  execucoesDeAtualizacao ExecucaoDeAtualizacao[]

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// O método de redução do valor recuperável (MCASP 1.1.5).
enum MetodoAtualizacao {
  /// Bens tangíveis (móveis, imóveis).
  DEPRECIACAO
  /// Intangíveis.
  AMORTIZACAO
  /// Recursos naturais.
  EXAUSTAO
}

// ----------------------------------------------------------------------------
// ParametroAtualizacaoClasse — vida útil e residual, POR CLASSE.
//
// ⚠️ O MÉTODO MORA AQUI, e não num mapa `especie → método` no código: o MCASP
// SUGERE, o ENTE DECIDE. Um imóvel deprecia; uma licença de software amortiza; uma
// jazida exaure — e nada disso se deduz da espécie MOVEL/IMOVEL. Quem sabe é quem
// parametriza.
//
// Sem parâmetro, `atualizarCompetencia` LANÇA: não existe vida útil default.
// ----------------------------------------------------------------------------

model ParametroAtualizacaoClasse {
  id String @id @default(cuid())

  classeDeBensId String       @unique
  classeDeBens   ClasseDeBens @relation(fields: [classeDeBensId], references: [id])

  metodo MetodoAtualizacao

  /// Em MESES. > 0 (conferido no serviço — fail-closed).
  vidaUtilMeses Int

  /// Fração do valor que NÃO se deprecia (0 a 1, exclusive). Taxa = Decimal(9,6),
  /// como toda alíquota do projeto — nunca float.
  percentualResidual Decimal @db.Decimal(9, 6)

  ativo Boolean @default(true)

  criadoEm  DateTime @default(now())
  criadoPor String
}

// ----------------------------------------------------------------------------
// BemPatrimonial — IDENTIDADE (TR 3.1). ZERO coluna de valor.
// ----------------------------------------------------------------------------

model BemPatrimonial {
  id               String @id @default(cuid())
  numeroTombamento String @unique
  descricao        String

  classeDeBensId String
  classeDeBens   ClasseDeBens @relation(fields: [classeDeBensId], references: [id])

  dataAquisicao DateTime

  movimentos MovimentoPatrimonial[]

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([classeDeBensId])

  // ── ENT05 — o eixo de GESTÃO (TR 5.19) ──
  /// TR 5.19.2 — a etiqueta com código de barras. O conteúdo é o número de tombamento;
  /// a coluna guarda o código EMITIDO, para que reimprimir dê a mesma etiqueta.
  ///
  /// ⚠️ A UNICIDADE É ÍNDICE PARCIAL DECLARADO, e não `@unique`: a coluna é anulável (o
  /// bem antigo não tem etiqueta), e no Postgres um índice único não restringe linhas com
  /// NULL. Ver `prisma/sql/uq_codigo_de_barras_do_bem.sql` — é a mesma escolha da
  /// contagem de inventário sem lote.
  codigoDeBarras String? @db.VarChar(60)

  /// TR 5.19.3 — adquirido, doação, comodato, permuta, e o que o ente acrescentar.
  /// NULLABLE (aditivo, sem backfill): bem antigo sem tipo continua válido.
  tipoDeIncorporacaoId String?
  tipoDeIncorporacao   TipoDeIncorporacao? @relation(fields: [tipoDeIncorporacaoId], references: [id])

  movimentosDeGestao MovimentoDeGestaoDoBem[]
  contagens          ContagemDeBem[]          @relation("ContagemDeBem")
  itensDeTermo       ItemDeTermoPatrimonial[] @relation("ItemDeTermoPatrimonial")
}

// ----------------------------------------------------------------------------
// MovimentoPatrimonial — o razão do patrimônio. APPEND-ONLY.
//
// `valor` é SEMPRE > 0; quem dá o sinal é o TIPO. Não existe movimento com valor
// negativo escondendo uma baixa.
// ----------------------------------------------------------------------------

model MovimentoPatrimonial {
  id String @id @default(cuid())

  /// OBRIGATÓRIO: o lançamento contábil é sempre da CLASSE (TR 5.84).
  classeDeBensId String
  classeDeBens   ClasseDeBens @relation(fields: [classeDeBensId], references: [id])

  /// OPCIONAL: a amarração individualizada (TR 3.1). Nulo = movimento sintético
  /// da classe (uma depreciação em lote, p.ex.) — e ele é tão válido quanto.
  bemId String?
  bem   BemPatrimonial? @relation(fields: [bemId], references: [id])

  tipo  TipoMovimentoPatrimonial
  /// SEMPRE positivo. O sinal vem do tipo.
  valor Decimal                  @db.Decimal(18, 2)

  dataMovimento DateTime
  /// Competência do fato (uso no bloco 2 — depreciação mensal).
  competencia   DateTime?

  /// Só na AQUISICAO: a liquidação (M05) que trouxe o bem.
  liquidacaoId String?
  liquidacao   Liquidacao? @relation(fields: [liquidacaoId], references: [id])

  /// TR 4.65 — a receita de alienação que este movimento gerou.
  ///
  /// ⚠️ GUARD DEGRADADO: o M04 NÃO classifica receita "de alienação" (não há
  /// campo nem natureza dedicada no modelo). Só dá para conferir que a receita
  /// EXISTE e não foi anulada. Amarrar a NATUREZA da receita à alienação é
  /// pendência do M04 — quando ela chegar, o guard aperta aqui sem migração.
  receitaArrecadadaId String?
  receitaArrecadada   ReceitaArrecadada? @relation(fields: [receitaArrecadadaId], references: [id])

  /// Agrupa os movimentos de UMA OPERAÇÃO composta (a alienação gera dois: a
  /// baixa do bruto e a baixa da acumulada). Estornar um estorna TODOS — meia
  /// alienação estornada deixaria o ativo com o bruto de volta e a depreciação
  /// não, ou vice-versa.
  operacaoId String?

  /// APPEND-ONLY: o estorno referencia o movimento que desfaz.
  estornoDeId String?
  estornoDe   MovimentoPatrimonial?  @relation("EstornoPatrimonial", fields: [estornoDeId], references: [id])
  estornos    MovimentoPatrimonial[] @relation("EstornoPatrimonial")

  /// A contabilização deste movimento (TR 5.84).
  lancamentoId String
  lancamento   LancamentoContabil @relation(fields: [lancamentoId], references: [id])

  /// ORQUESTRAÇÃO V3 (4.5) — a VERSÃO do roteiro que este movimento usou. É o vínculo entre a
  /// configuração e o fato: trocar o roteiro depois não muda este movimento, e ele diz qual
  /// par de contas valia quando foi lançado. Nulo = lançado pela linha legada de
  /// `RoteiroPatrimonial`, anterior ao versionamento.
  versaoDeRoteiroId String?
  /// RESTRICT é deliberado (como a migration que criou a coluna): uma versão referenciada
  /// por movimento não se apaga, e `SET NULL` detacharia o movimento em silêncio.
  versaoDeRoteiro   VersaoDeRoteiro? @relation(fields: [versaoDeRoteiroId], references: [id], onDelete: Restrict)

  /// V3 (pacote 2) — O MOTIVO DE BAIXA DO ROL DO ENTE (TR 5.19.30), ligado ao ATO. O texto
  /// livre em `motivo` continua sendo o histórico do movimento; esta é a classificação. Só
  /// os tipos de baixa a preenchem; o domínio recusa motivo inativo ou inexistente.
  motivoDeBaixaId String?
  motivoDeBaixa   MotivoDeBaixa? @relation(fields: [motivoDeBaixaId], references: [id], onDelete: Restrict)

  /// V3 (pacote 2) — a memória de cálculo, quando o movimento é uma atualização por competência.
  memoriaDeAtualizacao MemoriaDeAtualizacao?

  motivo String?

  /// V4 (§4.3) — A ORDEM DE REGISTRO, ESTÁVEL. `criadoEm` empata (dois movimentos no mesmo
  /// milissegundo) e a análise de dependências precisa de um desempate que não mude entre
  /// leituras: a sequência do banco. Só o banco a atribui.
  sequencia Int @unique @default(autoincrement())

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([classeDeBensId, tipo])
  @@index([versaoDeRoteiroId])
  @@index([motivoDeBaixaId])
  @@index([bemId])
  @@index([estornoDeId])
  @@index([liquidacaoId])
  @@index([dataMovimento])
  @@index([operacaoId])
}

// ----------------------------------------------------------------------------
// RoteiroResultadoAlienacao — o roteiro do GANHO/PERDA (TR 4.65).
//
// Model IRMÃO do RoteiroPatrimonial, e não uma linha dele, porque a chave é de
// outro enum. Trocar o tipo da coluna `RoteiroPatrimonial.tipo` para um enum
// maior NÃO seria migração aditiva (o Prisma dropa e recria a coluna) — e o
// invariante do projeto é aditiva pura.
// ----------------------------------------------------------------------------

model RoteiroResultadoAlienacao {
  id    String                  @id @default(cuid())
  chave ChaveResultadoAlienacao @unique

  contaDebitoId String
  contaDebito   ContaPcasp @relation("DebitoResultado", fields: [contaDebitoId], references: [id])

  contaCreditoId String
  contaCredito   ContaPcasp @relation("CreditoResultado", fields: [contaCreditoId], references: [id])

  criadoEm  DateTime @default(now())
  criadoPor String
}

// ----------------------------------------------------------------------------
// RoteiroPatrimonial — o roteiro contábil de cada tipo, POR PARÂMETRO.
//
// É uma TABELA, e não um mapa no código, porque os códigos do PCASP são dado do
// ente, não constante de programa. Tipo sem roteiro parametrizado = o serviço
// LANÇA (fail-closed): melhor não contabilizar do que contabilizar na conta
// errada.
//
// Os ESTORNOS não precisam de roteiro: o lançamento de estorno é gerado pelo
// motor do M01 (`gerarEstorno`), invertendo as pernas do original.
// ----------------------------------------------------------------------------

model RoteiroPatrimonial {
  id   String                   @id @default(cuid())
  tipo TipoMovimentoPatrimonial @unique

  contaDebitoId String
  contaDebito   ContaPcasp @relation("DebitoPatrimonial", fields: [contaDebitoId], references: [id])

  contaCreditoId String
  contaCredito   ContaPcasp @relation("CreditoPatrimonial", fields: [contaCreditoId], references: [id])

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// ORQUESTRAÇÃO V3 (4.5) — a família de roteiros que uma versão parametriza.
enum FamiliaDeRoteiro {
  /// `RoteiroPatrimonial`: a chave é um `TipoMovimentoPatrimentario` (sem os estornos).
  PATRIMONIAL
  /// `RoteiroResultadoAlienacao`: a chave é GANHO_ALIENACAO ou PERDA_ALIENACAO.
  RESULTADO_ALIENACAO
}

enum SituacaoDeVersaoDeRoteiro {
  /// Validada pelo motor contábil, ainda NÃO em vigor. Ninguém lança por ela.
  PROPOSTA
  /// Em vigor desde `publicadaEm` até a publicação da versão seguinte (derivado, nunca gravado).
  PUBLICADA
}

/// ORQUESTRAÇÃO V3 (4.5) — A VERSÃO DE UM ROTEIRO, APPEND-ONLY.
///
/// A tabela legada (`RoteiroPatrimonial`, `RoteiroResultadoAlienacao`) tinha UMA linha por
/// evento e a reparametrização a atualizava em silêncio: versão anterior, autor e motivo
/// se perdiam. Aqui cada parametrização é uma LINHA NOVA: quem propôs, quando, por quê,
/// com que par de contas; quem publicou e quando. A vigência é DERIVADA — a versão em
/// vigor é a PUBLICADA de `publicadaEm` mais recente, e a anterior termina onde a seguinte
/// começa. O fato aponta para a versão que usou (`MovimentoPatrimonial.versaoDeRoteiroId`).
///
/// ⚠️ A ÚNICA ESCRITA DEPOIS DA CRIAÇÃO é a publicação (situacao, publicadaEm, publicadaPor),
/// e ela está no censo de UPDATE do papel de runtime por COLUNA. As contas e o motivo não
/// mudam: para outro par, outra versão.
///
/// ⚠️ A CONCORRÊNCIA É DO BANCO: `(familia, chave, numero)` é único, e o número nasce de
/// `max + 1` na transação — duas propostas simultâneas para o mesmo evento não sobrescrevem,
/// a segunda estoura e é recusada nomeando.
model VersaoDeRoteiro {
  id      String           @id @default(cuid())
  familia FamiliaDeRoteiro
  /// O tipo do movimento (PATRIMONIAL) ou a chave do resultado (RESULTADO_ALIENACAO).
  chave   String           @db.VarChar(60)
  numero  Int

  contaDebitoId String
  contaDebito   ContaPcasp @relation("DebitoDaVersao", fields: [contaDebitoId], references: [id])

  contaCreditoId String
  contaCredito   ContaPcasp @relation("CreditoDaVersao", fields: [contaCreditoId], references: [id])

  /// Por que esta versão existe — obrigatório. "Ajuste" não é motivo.
  motivo String

  situacao    SituacaoDeVersaoDeRoteiro @default(PROPOSTA)
  publicadaEm DateTime?
  publicadaPor String?

  movimentos MovimentoPatrimonial[]

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([familia, chave, numero])
  @@index([familia, chave, situacao, publicadaEm])
}

// ----------------------------------------------------------------------------
// V3 (pacote 2, unidade 3) — O PARÂMETRO DE ATUALIZAÇÃO É VERSIONADO.
//
// `ParametroAtualizacaoClasse` (uma linha por classe, mutável) vira ORIGEM: o resolvedor
// lê a última versão desta tabela e só cai na linha legada enquanto a classe não tiver
// versão nenhuma. Append-only; a vigente é a de maior número; vigência derivada.
// ----------------------------------------------------------------------------
model VersaoDeParametroDeAtualizacao {
  id String @id @default(cuid())

  classeDeBensId String
  classeDeBens   ClasseDeBens @relation("VersoesDeParametro", fields: [classeDeBensId], references: [id])

  /// Sequencial por classe: 1, 2, 3… A unicidade é a trava de concorrência.
  numero Int

  metodo             MetodoAtualizacao
  /// Em MESES. > 0 (conferido no serviço — fail-closed).
  vidaUtilMeses      Int
  /// Fração do valor que NÃO se deprecia (0 a 1, exclusive). Decimal(9,6) — nunca float.
  percentualResidual Decimal @db.Decimal(9, 6)
  /// `false` = a partir desta versão a classe NÃO é mais atualizada.
  ativo              Boolean @default(true)

  /// Por que esta versão existe. Quem ler o histórico não terá a quem perguntar.
  motivo String

  /// V4 (§4.1) — A VIGÊNCIA DE NEGÓCIO: a primeira competência (dia 1, instante civil) a que
  /// esta versão se aplica. Nula = desde o início (a versão vale para toda competência ainda
  /// não calculada por outra). O número da versão é ordem de GRAVAÇÃO; isto é vigência.
  vigenteDesde DateTime?

  memorias  MemoriaDeAtualizacao[]
  execucoes ExecucaoDeAtualizacao[]

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([classeDeBensId, numero])
}

// ----------------------------------------------------------------------------
// A MEMÓRIA DE CÁLCULO de cada atualização por competência — gravada na MESMA
// transação do movimento e do lançamento. Sem ela, "por que 450,00?" só se responde
// refazendo a conta com parâmetros que podem já ter mudado.
// ----------------------------------------------------------------------------
model MemoriaDeAtualizacao {
  id String @id @default(cuid())

  movimentoId String               @unique
  movimento   MovimentoPatrimonial @relation(fields: [movimentoId], references: [id])

  /// A versão do parâmetro que a calculou — `null` quando veio da linha legada.
  versaoDeParametroId String?
  versaoDeParametro   VersaoDeParametroDeAtualizacao? @relation(fields: [versaoDeParametroId], references: [id], onDelete: Restrict)

  metodo             MetodoAtualizacao
  vidaUtilMeses      Int
  percentualResidual Decimal @db.Decimal(9, 6)

  base               Decimal @db.Decimal(18, 2)
  valorContabilAntes Decimal @db.Decimal(18, 2)
  valorResidual      Decimal @db.Decimal(18, 2)
  parcelaCheia       Decimal @db.Decimal(18, 2)
  teto               Decimal @db.Decimal(18, 2)
  valorDaParcela     Decimal @db.Decimal(18, 2)

  /// V4 (§4.2) — a execução mensal a que este item pertence, e o CORTE (último instante da
  /// competência): só movimentos com data de negócio até o corte compuseram a base.
  execucaoId String?
  execucao   ExecucaoDeAtualizacao? @relation(fields: [execucaoId], references: [id], onDelete: Restrict)
  corte      DateTime?

  criadoEm DateTime @default(now())

  @@index([versaoDeParametroId])
}

// ----------------------------------------------------------------------------
// ExecucaoDeAtualizacao — V4 (§4.3): A IDENTIDADE DA EXECUÇÃO MENSAL.
//
// Uma execução processa UMA classe numa competência, com escopo explícito (a classe
// inteira ou um bem), sob UMA versão de parâmetro e UM lançamento contábil (a soma dos
// itens). Os itens são os `MovimentoPatrimonial` cujo `operacaoId` é o id daqui — e por
// isso o estorno de um item arrasta a execução inteira (o lançamento é um só), e NUNCA a
// "virada" de todas as classes: cada classe é a sua execução.
// ----------------------------------------------------------------------------
model ExecucaoDeAtualizacao {
  id String @id @default(cuid())

  classeDeBensId String
  classeDeBens   ClasseDeBens @relation(fields: [classeDeBensId], references: [id])

  /// O primeiro instante civil do mês.
  competencia DateTime
  /// O último instante civil do mês — a data de corte da base.
  corte       DateTime
  /// "CLASSE" (todos os bens elegíveis e o acervo sem individualização) ou "BEM" (um só).
  escopo String
  bemId  String?

  versaoDeParametroId String?
  versaoDeParametro   VersaoDeParametroDeAtualizacao? @relation(fields: [versaoDeParametroId], references: [id], onDelete: Restrict)

  metodo            MetodoAtualizacao
  quantidadeDeItens Int
  /// Somas dos itens (cada item arredondado a 2 casas; o agregado é a soma dos itens).
  base           Decimal @db.Decimal(18, 2)
  valorDaParcela Decimal @db.Decimal(18, 2)

  /// O lançamento contábil ÚNICO da execução (os itens o compartilham).
  lancamentoId String

  memorias MemoriaDeAtualizacao[]

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([classeDeBensId, competencia])
  @@index([lancamentoId])
}
