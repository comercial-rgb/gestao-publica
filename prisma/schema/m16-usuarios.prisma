  ENCERRAR_CONTROLES_ORCAMENTARIOS
  ESTORNAR_ENCERRAMENTO_CONTROLES
  LIQUIDAR_RESTOS_A_PAGAR
  PAGAR_RESTOS_A_PAGAR
  CANCELAR_RESTOS_A_PAGAR
  ANULAR_PAGAMENTO_RESTOS_A_PAGAR
  ANULAR_CANCELAMENTO_RESTOS_A_PAGAR

