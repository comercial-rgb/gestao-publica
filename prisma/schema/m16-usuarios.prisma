  REGISTRAR_CONTRATO_DE_RATEIO
  REPASSAR_AO_CONSORCIO
  REGISTRAR_DEVOLUCAO_DE_CONSORCIO
  ESTORNAR_MOVIMENTO_DE_CONSORCIO

