  ABRIR_CONCILIACAO
  ENCERRAR_CONCILIACAO
  /// Declarar pendência e explicar pendência são atos distintos de registrar o juízo.
  REGISTRAR_PENDENCIA_MANUAL
  JUSTIFICAR_PENDENCIA
