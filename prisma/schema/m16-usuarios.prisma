  ABRIR_AUDITORIA_INTERNA
  RESPONDER_CHECKLIST_DE_AUDITORIA
  REGISTRAR_IRREGULARIDADE
  REGISTRAR_PROVIDENCIA
  APRECIAR_PROVIDENCIA
  ENCERRAR_AUDITORIA_INTERNA
  EMITIR_RELATORIO_CIRCUNSTANCIADO

