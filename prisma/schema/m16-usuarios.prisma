  CADASTRAR_ENCARGO_DA_FOLHA
  APROVAR_ENCARGO_DA_FOLHA
  APURAR_ENCARGOS_DA_FOLHA
  CERTIFICAR_ENCARGOS_DA_FOLHA
  /// V7 M1 U3.2 — a guia de recolhimento do emissor: registrar, baixar (pelo pagamento do M05) e cancelar.
  GERIR_GUIA_DE_RECOLHIMENTO
  /// V7 M1 U4 — a triagem e a resposta da ouvidoria; a moderação das avaliações.
  TRIAR_MANIFESTACAO_DE_OUVIDORIA
  MODERAR_AVALIACAO_DE_SERVICO
  DESIGNAR_NO_CONTRATO
  DEFINIR_ADMINISTRADOR_DA_FISCALIZACAO
  CONFIGURAR_EXECUCAO_DO_CONTRATO
  EMITIR_ORDEM_DE_SERVICO_DO_CONTRATO
  REGISTRAR_RECEBIMENTO_PROVISORIO
  REGISTRAR_RECEBIMENTO_DEFINITIVO
  /// V9 N4 — desfazer um recebimento definitivo assinado. Acao propria: desfazer nao e receber.
  ESTORNAR_RECEBIMENTO_DEFINITIVO

  // ── V10 T1 (N6.1) — AS ACOES DO FORNECEDOR. Reservadas: `concederAcaoAoPerfil` as recusa,
  // porque o municipio nao concede a si proprio a habilitacao comercial do software. Quem as
  // recebe e o operador do fornecedor, provisionado por ato explicito de instalacao. ──
  REGISTRAR_CONTRATO_COMERCIAL
  ENCERRAR_CONTRATO_COMERCIAL
  HABILITAR_MODULO_CONTRATADO
  PROGRAMAR_VIGENCIA_DE_MODULO
  SUSPENDER_MODULO_CONTRATADO
  REATIVAR_MODULO_CONTRATADO
  CONSULTAR_LICENCIAMENTO

  // ── V10 T2 (N5) — M34 B2: o lancamento tributario e a certidao. Quatro atos, quatro acoes:
  // preparar e revisar nao constitui nada; constituir faz nascer o credito e mexe no razao;
  // retificar e cancelar desfazem o que ja foi constituido. ──
  PREPARAR_LANCAMENTO_TRIBUTARIO
  CONSTITUIR_CREDITO_TRIBUTARIO
  RETIFICAR_LANCAMENTO_TRIBUTARIO
  CANCELAR_LANCAMENTO_TRIBUTARIO
  SOLICITAR_CERTIDAO
  DECIDIR_CERTIDAO

  // ── V10 T3 (N2) — a politica de DIVULGACAO de uma localizacao fisica. Acao PROPRIA, e nao a
  // de cadastrar: quem cadastra o deposito nao e necessariamente quem decide o que vai ao
  // portal publico do municipio. ──
  DEFINIR_DIVULGACAO_DA_LOCALIZACAO
  CADASTRAR_ITEM_DO_CONTRATO
  PROGRAMAR_FISCALIZACAO_DO_CONTRATO
  REGISTRAR_OCORRENCIA_DE_FISCALIZACAO
  RESOLVER_OCORRENCIA_DE_FISCALIZACAO

  // V6.2 — P3: a carta de serviços e as solicitações do requerente. Configurar/publicar a carta, pedir
  // um serviço (o titular ou o representante), decidir a solicitação e registrar representação são
  // quatro sujeitos diferentes; a leitura da área do requerente é CONSULTAR_MEUS_SERVICOS.
  CONFIGURAR_CARTA_DE_SERVICOS
  SOLICITAR_SERVICO
  DECIDIR_SOLICITACAO_DE_SERVICO
  REGISTRAR_REPRESENTACAO

  // M07 V11 V8.3 — o cadastro dos tipos de consignação (parametrização contábil do ente)
  GERIR_TIPOS_DE_CONSIGNACAO

  // M05 V11 V8.4 — o roteiro orçamentário pela tela
  PARAMETRIZAR_ROTEIRO_ORCAMENTARIO

  // M21 V11 V8 — a agenda do guichê (TR 5.39.92)
  CONFIGURAR_AGENDA_DO_GUICHE
  RESERVAR_ATENDIMENTO_NO_GUICHE
  REGISTRAR_ATENDIMENTO_NO_GUICHE
  CONSULTAR_MEUS_SERVICOS

  // V6 P2.4 — o portal do servidor: a leitura do PRÓPRIO vínculo e dos PRÓPRIOS contracheques.
  // Não abre a folha do ente: a porta recorta pela pessoa da sessão.
  CONSULTAR_PORTAL_DO_SERVIDOR
  // ── V4 (§8, Fila A) — M02b, o planejamento PLURIANUAL (PPA e LDO): dez ações para vinte
  // serviços, agrupadas pelos ANEXOS DA LRF (ver `acoes.ts`). Conciliado do siafic-cg c04ad5a. ──
  CADASTRAR_PPA
  CADASTRAR_ESTRUTURA_PPA
  CADASTRAR_PROGRAMA_PPA
  CADASTRAR_RECEITA_PPA
  CADASTRAR_LDO
  CADASTRAR_PRIORIDADE_LDO
  CADASTRAR_METAS_FISCAIS_LDO
  CADASTRAR_RISCOS_FISCAIS_LDO
  CADASTRAR_RENUNCIA_RECEITA_LDO
  CADASTRAR_ALIENACAO_LDO

  // ── M01 V11 V9 — a ENTIDADE CONTÁBIL e a titularidade da receita (TR 5.10.1.3 · 5.38.7).
  // Três ações para quatro serviços: publicar versão é a MESMA autoridade de cadastrar (dizer
  // quem a entidade é), e partir em duas daria ao ente a chance de conceder uma sem a outra,
  // o que não significaria nada. Ver `modules/m16-travamento/acoes.ts`.
  CADASTRAR_ENTIDADE_CONTABIL
  DECLARAR_TITULAR_DA_CONTA_BANCARIA
  ATRIBUIR_ENTIDADE_A_ARRECADACAO
}

/// O USUÁRIO. TR 4.55.
///
/// ⚠️ O `identificador` É O QUE O `criadoPor` DO LANÇAMENTO CARREGA. Hoje um e-mail —
/// e é por essa string que o funil confere a identidade e o travamento por usuário
/// (TR 4.54) encontra o alvo. Antes deste bloco ela era uma string livre comparada com
/// outra string livre: um typo no `usuarioAlvo` travava NINGUÉM, em silêncio.
///
/// ⚠️ `ativo` É COLUNA, e isso é o PADRÃO DA CASA — não uma escolha nova. A
/// `ClasseDeMaterial`, a `ClasseDeBens`, o `Contrato`, a `Obra` e o `TipoConsignacao`
/// todos usam `ativa/ativo Boolean @default(true)`. Um `MovimentoUsuario` append-only
/// seria um padrão que o repositório não tem, inventado para um cadastro — e cadastro
/// não é fato contábil. (O que É append-only aqui é o RAZÃO: um usuário desativado não
/// apaga os lançamentos que ele fez, e o `criadoPor` deles continua apontando para cá.)
model Usuario {
  id String @id @default(cuid())

  /// A string que aparece no `criadoPor` de todo fato. Único — é a identidade.
  identificador String @unique
  nome          String

  /// Desativado NÃO pode lançar (o funil recusa) nem executar ação (o `autorizar`
  /// recusa). Mas os fatos que ele já criou FICAM — o razão é append-only.
  ativo Boolean @default(true)

  vinculos VinculoUsuarioPerfil[]

  // ── back-relations do bloco de AUTENTICAÇÃO (m16-autenticacao.prisma) ──
  // Campos VIRTUAIS: não geram coluna. A credencial e a sessão apontam para cá, nunca o
  // contrário — o `Usuario` não guarda senha nem token, e é isso que o schema diz em voz alta.
  credenciais CredencialDeUsuario[]
  sessoes     SessaoAberta[]

  criadoPor String
  criadoEm  DateTime @default(now())

  /// V3 (pacote 2) — back-relation VIRTUAL: os vínculos deste usuário com uma pessoa.
  vinculosDePessoa VinculoUsuarioPessoa[]

  /// V6.1 — back-relation VIRTUAL: as designações de certificação da folha deste usuário.
  designacoesNaFolha DesignacaoNaFolha[] @relation("DesignacaoNaFolha")
  designacoesNoContrato DesignacaoNoContrato[] @relation("DesignacaoNoContrato")
  administracoesDaFiscalizacao AdministradorDaFiscalizacao[] @relation("AdministradorDaFiscalizacao")

  @@index([ativo])
  /// V6.2 — as representações de pessoa que esta conta exerce. VIRTUAL.
  representacoesExercidas RepresentacaoDePessoa[] @relation("RepresentanteDePessoa")
}

/// V3 (pacote 2) — VÍNCULO ENTRE O USUÁRIO QUE AUTENTICA E A PESSOA DO CADASTRO, append-only.
///
/// Quem autentica é `Usuario`; quem responde por um bem é `Pessoa` — e nada ligava os dois
/// (`USUARIO-SEM-PESSOA`). O vínculo é EXPLÍCITO (nunca por semelhança de nome), OPCIONAL
/// (uma conta técnica de integração não representa pessoa física), AUDITÁVEL (cada
/// vínculo e cada desvínculo é uma linha, com autor e motivo) e NÃO CONCEDE PERMISSÃO:
/// ele só diz "este usuário É esta pessoa" para as consultas que dependem disso ("meus
/// bens"). O vínculo vigente é a ÚLTIMA linha do usuário, se for VINCULO.
enum TipoDeVinculoUsuarioPessoa {
  VINCULO
  DESVINCULO
}

model VinculoUsuarioPessoa {
  id String @id @default(cuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  pessoaId String
  pessoa   Pessoa @relation("PessoaDoUsuario", fields: [pessoaId], references: [id])

  tipo   TipoDeVinculoUsuarioPessoa
  motivo String

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([usuarioId, criadoEm])
  @@index([pessoaId, criadoEm])
}

/// O PERFIL — o crachá. TR 4.56.
///
/// A permissão não se dá ao USUÁRIO: dá-se ao PERFIL, e o usuário recebe perfis. É o que
/// torna a segregação do 6.4 auditável — o TCE pergunta "quem pode pagar?", e a resposta
/// é uma consulta a UM perfil, não a varredura de trezentos usuários.
model Perfil {
  id String @id @default(cuid())

  nome      String @unique
  descricao String

  permissoes PermissaoDePerfil[]
  vinculos   VinculoUsuarioPerfil[]

  criadoPor String
  criadoEm  DateTime @default(now())
}

/// A PERMISSÃO: um perfil pode uma ação — e, opcionalmente, SÓ numa unidade gestora.
///
/// ⚠️ `unidadeOrcId` NULO = TODAS as unidades. E isso é uma CONCESSÃO EXPLÍCITA, não um
/// default preguiçoso: quem cadastra a permissão sem UG está dizendo "este perfil pode
/// isto em qualquer lugar do ente". A alternativa (nulo = nenhuma) tornaria a permissão
/// global impossível de expressar, e o ente teria de listar as 40 unidades uma a uma —
/// e esquecer a 41ª quando ela nascesse.
///
/// ⚠️ E É ELA QUE IMPLEMENTA A SEGREGAÇÃO POR UG DO 6.5. O perfil "TESOURARIA_SAUDE"
/// pode PAGAR, mas só na unidade da Saúde: um pagamento da Educação por ele é negado
/// nomeando as três coisas (usuário, ação, UG).
model PermissaoDePerfil {
  id String @id @default(cuid())

  perfilId String
  perfil   Perfil @relation(fields: [perfilId], references: [id])

  acao AcaoDoSistema

  /// NULO = todas as UGs. Ver acima — é concessão, não default.
  unidadeOrcId String?
  unidadeOrc   UnidadeOrcamentaria? @relation(fields: [unidadeOrcId], references: [id])

  criadoPor String
  criadoEm  DateTime @default(now())

  /// Uma permissão por (perfil, ação, UG). A unicidade é do banco.
  @@unique([perfilId, acao, unidadeOrcId])
  @@index([perfilId])
  @@index([acao])
}

/// O VÍNCULO usuário ↔ perfil. Um usuário pode ter vários perfis; a autorização é a UNIÃO
/// deles (quem tem dois crachás pode o que qualquer um dos dois permite).
model VinculoUsuarioPerfil {
  id String @id @default(cuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  perfilId String
  perfil   Perfil @relation(fields: [perfilId], references: [id])

  criadoPor String
  criadoEm  DateTime @default(now())

  @@unique([usuarioId, perfilId])
  @@index([usuarioId])
}

/// ORQUESTRACAO V3 (4.2) - o registro de cada ATUALIZACAO VERSIONADA de permissoes
/// aplicada nesta instalacao. Uma linha por versao, e a unicidade e a trava: a
/// atualizacao roda uma vez, e reaplica-la e recusado nomeando quem e quando - e isso
/// que preserva uma revogacao deliberada feita depois. Ver
/// `modules/m16-travamento/atualizacoes-de-permissoes.ts`.
model AtualizacaoDePermissoes {
  id String @id @default(cuid())

  versao Int    @unique
  nome   String

  aplicadaEm  DateTime @default(now())
  aplicadaPor String
  /// Quantas permissoes a aplicacao criou.
  concessoes  Int
  /// Perfil: acao @ escopo, uma por linha - a memoria do que foi concedido.
  detalhe     String
}
