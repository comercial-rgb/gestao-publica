// ============================================================================
// M16 — USUÁRIOS, PERFIS E PERMISSÕES.
//
// TR 4.55/4.56 (cadastro de usuários e permissões) · 6.4/6.5 (SEGREGAÇÃO DE
// FUNÇÕES: execução × controle × consulta, e a separação por unidade gestora).
//
// ⚠️ POR QUE ISTO MORA NO M16, E NÃO NUM MÓDULO PRÓPRIO.
// O travamento (bloco 1) já perguntava "QUEM está lançando?" — e respondia com uma
// string livre. Permissão e travamento são a MESMA pergunta feita duas vezes ("este
// usuário pode fazer isto, aqui, agora?"), e separá-las em dois módulos criaria duas
// noções de usuário que divergiriam no primeiro cadastro.
// ============================================================================

/// O ROL DE AÇÕES — o CENSO dos serviços de mutação do sistema.
///
/// ⚠️ Ele é gerado do censo em `modules/m16-travamento/acoes.ts`, e o grep-teste
/// (`m16-censo.test.ts`) prova que os dois não divergem: um serviço novo sem ação
/// classificada FALHA a suíte, nomeando arquivo e função.
///
/// ⚠️ E as LEITURAS ficam de fora, nesta fase. A segregação de LEITURA por unidade
/// gestora (o outro lado do 6.4) é camada de APLICAÇÃO — um `where` em cada consulta,
/// não uma permissão. Negar um relatório a alguém não protege nada se ele lê o razão
/// por outro caminho. PENDÊNCIA NOMEADA.
enum AcaoDoSistema {
  /// TR 5.95 — o LANÇAMENTO MANUAL. Partidas arbitrárias, sem fato de origem: é a
  /// chave-mestra do razão. Se alguma ação tem de ser rara e vigiada, é esta.
  REGISTRAR_LANCAMENTO_MANUAL
  ESTORNAR_LANCAMENTO_MANUAL

  CRIAR_FICHA
  CRIAR_RECEITA_PREVISTA
  REPREVISAR_RECEITA

  CRIAR_LEI_DE_CREDITO
  CRIAR_DECRETO_DE_CREDITO
  EXECUTAR_CREDITO
  ANULAR_CREDITO
  ENCERRAR_DECRETO

  REGISTRAR_ARRECADACAO
  ANULAR_ARRECADACAO

  // M04 — reconhecimento pelo fato gerador (TR 5.87/5.88)
  RECONHECER_RECEITA
  ESTORNAR_RECONHECIMENTO
  CANCELAR_RECONHECIMENTO

  // M02 — programação financeira (CMD/MBA · TR 4.18/4.43/4.44)
  CRIAR_VERSAO_CMD
  CRIAR_VERSAO_MBA
  LIBERAR_PROGRAMACAO
  CONFIGURAR_LIMITACAO_EMPENHO

  RESERVAR_DOTACAO
  LIBERAR_RESERVA
  EMPENHAR
  ANULAR_EMPENHO
  ANULAR_EMPENHO_PARCIAL
  LIQUIDAR
  ANULAR_LIQUIDACAO
  ANULAR_LIQUIDACAO_PARCIAL
  PAGAR
  PREPARAR_ORDEM_PAGAMENTO
  AUTORIZAR_ORDEM_PAGAMENTO
  CANCELAR_ORDEM_PAGAMENTO
  ANULAR_PAGAMENTO
  ANULAR_PAGAMENTO_PARCIAL
  ESTORNAR_ANULACAO_PARCIAL

  REGISTRAR_INGRESSO_EXTRA
  REGISTRAR_DISPENDIO_EXTRA
  ESTORNAR_MOVIMENTO_EXTRA

  ABRIR_EXERCICIO
  ENCERRAR_EXERCICIO
  APURAR_RESULTADO
  ESTORNAR_APURACAO
  ENCERRAR_CONTROLES_ORCAMENTARIOS
  ESTORNAR_ENCERRAMENTO_CONTROLES
  LIQUIDAR_RESTOS_A_PAGAR
  PAGAR_RESTOS_A_PAGAR
  CANCELAR_RESTOS_A_PAGAR
  ANULAR_PAGAMENTO_RESTOS_A_PAGAR
  ANULAR_CANCELAMENTO_RESTOS_A_PAGAR

  IMPORTAR_EXTRATO
  VINCULAR_CONCILIACAO
  ESTORNAR_VINCULO
  TRANSFERIR_ENTRE_CONTAS
  /// M09 — TR 5.62: depósito, saque, aplicação, resgate, rendimento e tarifa.
  /// Ação PRÓPRIA, e não reuso de TRANSFERIR_ENTRE_CONTAS: mover dinheiro entre
  /// contas do ente e tirar dinheiro da conta são atos diferentes, e quem pode um
  /// não necessariamente pode o outro.
  REGISTRAR_MOVIMENTO_BANCARIO
  /// Desfazer o movimento é ato SEPARADO de registrá-lo — a mesma disciplina do
  /// ESTORNAR_VINCULO.
  ESTORNAR_MOVIMENTO_BANCARIO
  SUBMETER_CAPTURA

  // M20 — importadores de arquivo externo (folha/tributário).
  IMPORTAR_FOLHA
  IMPORTAR_TRIBUTOS

  CADASTRAR_CLASSE_DE_MATERIAL
  REGISTRAR_ENTRADA_ALMOXARIFADO
  REGISTRAR_SAIDA_CONSUMO
  REGISTRAR_AJUSTE_ALMOXARIFADO
  ESTORNAR_MOVIMENTO_ALMOXARIFADO

  ADQUIRIR_BEM
  REGISTRAR_ENTRADA_AVULSA
  ALIENAR_BEM
  BAIXAR_BEM
  REGISTRAR_REAVALIACAO
  REGISTRAR_IMPAIRMENT
  REGISTRAR_CUSTO_SUBSEQUENTE
  ATUALIZAR_COMPETENCIA_PATRIMONIAL
  ESTORNAR_MOVIMENTO_PATRIMONIAL

  CADASTRAR_DIVIDA
  REGISTRAR_ATUALIZACAO_MONETARIA
  ESTORNAR_MOVIMENTO_DIVIDA

  CADASTRAR_DIVIDA_ATIVA
  INSCREVER_DIVIDA_ATIVA
  ATUALIZAR_DIVIDA_ATIVA
  CANCELAR_DIVIDA_ATIVA
  ESTORNAR_MOVIMENTO_DIVIDA_ATIVA

  CADASTRAR_PROVISAO
  CONSTITUIR_PROVISAO
  REVERTER_PROVISAO
  ATUALIZAR_PROVISAO
  ESTORNAR_MOVIMENTO_PROVISAO

  CADASTRAR_PROCESSO
  HOMOLOGAR_PROCESSO
  CADASTRAR_PESSOA
  ALTERAR_PESSOA
  MOVER_PAPEL_DE_PESSOA
  CADASTRAR_CONTRATO
  REGISTRAR_ADITIVO
  ESTORNAR_MOVIMENTO_CONTRATUAL
  CADASTRAR_LIMITE
  CADASTRAR_OBRA

  CADASTRAR_LINHA_DEMONSTRATIVO

  TRAVAR_COMPETENCIA
  DESTRAVAR_COMPETENCIA

  // M16 — administração de usuários (TR 4.55/4.56). A família ADMINISTRACAO: quem cria/gerencia
  // usuários não é quem executa despesa. Cada ação concedida átomo a átomo, nunca por herança.
  CRIAR_USUARIO
  CONCEDER_PERFIL
  REVOGAR_PERFIL
  ATIVAR_USUARIO
  INATIVAR_USUARIO
  RESETAR_SENHA

  // ── M21 — protocolo e processo digital (ENT02) ──
  //
  /// ⚠️ UMA AÇÃO POR ATO. Abrir, tramitar e encerrar são decisões de peso diferente:
  /// o atendente do balcão abre e tramita; quem encerra responde pelo mérito. Um
  /// "GERIR_PROCESSO" único daria os três a quem precisa de um.
  ABRIR_PROCESSO
  TRAMITAR_PROCESSO
  RECEBER_PROCESSO
  COMPLEMENTAR_PROCESSO
  SOLICITAR_PARECER
  RESPONDER_PARECER
  SOLICITAR_READEQUACAO
  ATENDER_READEQUACAO
  ENCERRAR_PROCESSO
  ARQUIVAR_PROCESSO
  REABRIR_PROCESSO
  APENSAR_PROCESSO
  DESAPENSAR_PROCESSO
  TORNAR_MOVIMENTO_SEM_EFEITO

  // ── M21 — os CADASTROS do protocolo (ENT02) ──
  //
  /// ⚠️ CONFIGURAR NÃO É OPERAR. Quem desenha o roteiro de um assunto decide por
  /// quantos setores todo processo daquele tipo vai passar e em quantos dias; quem
  /// abre o processo apenas o usa.
  CRIAR_SETOR
  LOTAR_USUARIO_NO_SETOR
  CRIAR_ASSUNTO
  REGISTRAR_TAXA_DO_PROCESSO
  BAIXAR_TAXA_DO_PROCESSO

  // ── M22 — anexos e assinatura (ENT02) ──
  //
  /// ⚠️ ASSINAR é ação PRÓPRIA. Quem instrui o processo não é necessariamente quem
  /// responde por ele: juntar a assinatura ao trâmite faria do despacho um ato
  /// assinado por quem apenas o encaminhou.
  ANEXAR_ARQUIVO
  ASSINAR_DOCUMENTO
  CRIAR_FILA_DE_ASSINATURA
  ASSINAR_NA_FILA

  // ── M23 — comunicação interna (ENT02) ──
  //
  /// ⚠️ `GERIR_MINHA_CAIXA` cobre arquivar, desarquivar, favoritar e desfavoritar:
  /// é o MESMO poder — organizar a própria caixa —, e nenhum deles muda o documento
  /// para outra pessoa. Etiquetar fica separado porque a tag é visível a todos.
  CRIAR_TIPO_DE_COMUNICADO
  RASCUNHAR_COMUNICADO
  EDITAR_RASCUNHO_DE_COMUNICADO
  ENVIAR_COMUNICADO
  RESPONDER_COMUNICADO
  ENCAMINHAR_COMUNICADO
  MARCAR_LEITURA_DE_COMUNICADO
  GERIR_MINHA_CAIXA
  ETIQUETAR_COMUNICADO

  // ── M25 — campos adicionais (ENT02) ──
  //
  /// ⚠️ DEFINIR e PREENCHER sao poderes diferentes: quem preenche o formulário não é
  /// quem decide o que ele pergunta. Uma ação única deixaria qualquer atendente criar
  /// campo novo no cadastro do ente.
  DEFINIR_CAMPO_ADICIONAL
  DESATIVAR_CAMPO_ADICIONAL
  PREENCHER_CAMPOS_ADICIONAIS

  // ── M26 — designer de relatórios (ENT02) ──
  //
  /// ⚠️ DISTRIBUIR tem ação PRÓPRIA porque o catálogo pede permissão própria: desenhar
  /// um relatório para a própria unidade é uma coisa; empurrá-lo para outra entidade é
  /// outra, e envolve terceiros.
  CRIAR_MODELO_DE_RELATORIO
  NOVA_VERSAO_DE_MODELO
  COPIAR_MODELO_DE_RELATORIO
  DISTRIBUIR_MODELO_DE_RELATORIO
  RETIRAR_MODELO_DE_RELATORIO
  EXECUTAR_RELATORIO

  // ── M27 — ajuda contextual e chamados (ENT02) ──
  //
  /// ⚠️ RESPONDER e ENCERRAR são ações SEPARADAS: quem abriu o chamado é quem sabe se
  /// o problema acabou. Encerrar junto com a resposta faria a métrica de resolução
  /// medir a velocidade de digitar, não a de resolver.
  ESCREVER_AJUDA_DE_ROTA
  CRIAR_NIVEL_DE_SEVERIDADE
  ABRIR_CHAMADO
  RESPONDER_CHAMADO
  ENCERRAR_CHAMADO
  REABRIR_CHAMADO
  RESPONDER_PESQUISA_DE_SATISFACAO

  // ── M09 — lote de pagamento e borderô (ENT03) ──
  CRIAR_LOTE_DE_PAGAMENTO
  INCLUIR_NO_LOTE
  FECHAR_LOTE
  GERAR_BORDERO
  PROCESSAR_RETORNO_BANCARIO
}

/// O USUÁRIO. TR 4.55.
///
/// ⚠️ O `identificador` É O QUE O `criadoPor` DO LANÇAMENTO CARREGA. Hoje um e-mail —
/// e é por essa string que o funil confere a identidade e o travamento por usuário
/// (TR 4.54) encontra o alvo. Antes deste bloco ela era uma string livre comparada com
/// outra string livre: um typo no `usuarioAlvo` travava NINGUÉM, em silêncio.
///
/// ⚠️ `ativo` É COLUNA, e isso é o PADRÃO DA CASA — não uma escolha nova. A
/// `ClasseDeMaterial`, a `ClasseDeBens`, o `Contrato`, a `Obra` e o `TipoConsignacao`
/// todos usam `ativa/ativo Boolean @default(true)`. Um `MovimentoUsuario` append-only
/// seria um padrão que o repositório não tem, inventado para um cadastro — e cadastro
/// não é fato contábil. (O que É append-only aqui é o RAZÃO: um usuário desativado não
/// apaga os lançamentos que ele fez, e o `criadoPor` deles continua apontando para cá.)
model Usuario {
  id String @id @default(cuid())

  /// A string que aparece no `criadoPor` de todo fato. Único — é a identidade.
  identificador String @unique
  nome          String

  /// Desativado NÃO pode lançar (o funil recusa) nem executar ação (o `autorizar`
  /// recusa). Mas os fatos que ele já criou FICAM — o razão é append-only.
  ativo Boolean @default(true)

  vinculos VinculoUsuarioPerfil[]

  // ── back-relations do bloco de AUTENTICAÇÃO (m16-autenticacao.prisma) ──
  // Campos VIRTUAIS: não geram coluna. A credencial e a sessão apontam para cá, nunca o
  // contrário — o `Usuario` não guarda senha nem token, e é isso que o schema diz em voz alta.
  credenciais CredencialDeUsuario[]
  sessoes     SessaoAberta[]

  criadoPor String
  criadoEm  DateTime @default(now())

  @@index([ativo])
}

/// O PERFIL — o crachá. TR 4.56.
///
/// A permissão não se dá ao USUÁRIO: dá-se ao PERFIL, e o usuário recebe perfis. É o que
/// torna a segregação do 6.4 auditável — o TCE pergunta "quem pode pagar?", e a resposta
/// é uma consulta a UM perfil, não a varredura de trezentos usuários.
model Perfil {
  id String @id @default(cuid())

  nome      String @unique
  descricao String

  permissoes PermissaoDePerfil[]
  vinculos   VinculoUsuarioPerfil[]

  criadoPor String
  criadoEm  DateTime @default(now())
}

/// A PERMISSÃO: um perfil pode uma ação — e, opcionalmente, SÓ numa unidade gestora.
///
/// ⚠️ `unidadeOrcId` NULO = TODAS as unidades. E isso é uma CONCESSÃO EXPLÍCITA, não um
/// default preguiçoso: quem cadastra a permissão sem UG está dizendo "este perfil pode
/// isto em qualquer lugar do ente". A alternativa (nulo = nenhuma) tornaria a permissão
/// global impossível de expressar, e o ente teria de listar as 40 unidades uma a uma —
/// e esquecer a 41ª quando ela nascesse.
///
/// ⚠️ E É ELA QUE IMPLEMENTA A SEGREGAÇÃO POR UG DO 6.5. O perfil "TESOURARIA_SAUDE"
/// pode PAGAR, mas só na unidade da Saúde: um pagamento da Educação por ele é negado
/// nomeando as três coisas (usuário, ação, UG).
model PermissaoDePerfil {
  id String @id @default(cuid())

  perfilId String
  perfil   Perfil @relation(fields: [perfilId], references: [id])

  acao AcaoDoSistema

  /// NULO = todas as UGs. Ver acima — é concessão, não default.
  unidadeOrcId String?
  unidadeOrc   UnidadeOrcamentaria? @relation(fields: [unidadeOrcId], references: [id])

  criadoPor String
  criadoEm  DateTime @default(now())

  /// Uma permissão por (perfil, ação, UG). A unicidade é do banco.
  @@unique([perfilId, acao, unidadeOrcId])
  @@index([perfilId])
  @@index([acao])
}

/// O VÍNCULO usuário ↔ perfil. Um usuário pode ter vários perfis; a autorização é a UNIÃO
/// deles (quem tem dois crachás pode o que qualquer um dos dois permite).
model VinculoUsuarioPerfil {
  id String @id @default(cuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  perfilId String
  perfil   Perfil @relation(fields: [perfilId], references: [id])

  criadoPor String
  criadoEm  DateTime @default(now())

  @@unique([usuarioId, perfilId])
  @@index([usuarioId])
}
