// ============================================================================
// V29 — A PROPOSTA ORÇAMENTÁRIA DO EXERCÍCIO SEGUINTE (M02).
//
// A proposta importa as receitas previstas e as fichas de um exercício (a ORIGEM) para montar
// o orçamento de outro (o DESTINO), com a base e o percentual escolhidos. Ela NÃO toca o razão:
// a ficha, ao nascer, grava a dotação inicial no razão (append-only), e uma proposta ainda se
// altera antes de virar lei. Quem cria as fichas e a receita prevista do destino é a
// EFETIVAÇÃO, uma vez por exercício.
//
// ⚠️ INSERT-ONLY EM TODAS AS TABELAS. O valor de uma linha muda por AJUSTE (linha nova, com
// motivo); o vigente é o do ajuste mais recente, ou o projetado se não houver ajuste. Nenhuma
// destas tabelas entra no censo de UPDATE/DELETE do papel de runtime.
// ============================================================================

/// A base da despesa: qual valor da ficha de origem a proposta lê.
enum BaseDaDespesaDaProposta {
  /// O `valorDotado` da ficha (a dotação da LOA de origem).
  DOTACAO_INICIAL
  /// A dotação inicial mais créditos e realocações, menos anulações (Σ dos movimentos).
  DOTACAO_AUTORIZADA
  /// O empenhado líquido (empenhos menos anulações).
  EMPENHADO
  /// Só a estrutura: a ficha vem com valor zero, para ser preenchida na proposta.
  SEM_VALOR
}

/// A base da receita: qual valor da previsão de origem a proposta lê.
enum BaseDaReceitaDaProposta {
  /// O `valorPrevisto` da receita prevista (a previsão da LOA de origem).
  PREVISAO_INICIAL
  /// A previsão inicial mais a Σ das reprevisões da mesma natureza, fonte e tipo (LRF art. 12).
  PREVISAO_ATUALIZADA
  /// Só a estrutura: a previsão vem com valor zero, para ser preenchida na proposta.
  SEM_VALOR
}

model PropostaOrcamentaria {
  id                            String                  @id @default(cuid())
  /// O exercício que a proposta orça (o destino).
  exercicio                     Int
  /// O exercício de onde as linhas foram importadas.
  exercicioDeOrigem             Int
  descricao                     String
  baseDaReceita                 BaseDaReceitaDaProposta
  /// Percentual aplicado sobre a base da receita (5.5 = mais 5,5 %; pode ser negativo).
  percentualDaReceita           Decimal                 @db.Decimal(9, 6)
  baseDaDespesa                 BaseDaDespesaDaProposta
  percentualDaDespesa           Decimal                 @db.Decimal(9, 6)
  /// O que a proposta aproveitou do exercício de origem (ao menos um dos dois).
  aproveitaReceitas             Boolean
  aproveitaFichas               Boolean
  /// Falso: projetos e operações especiais entram pela base, sem o reajuste.
  reajustaProjetos              Boolean
  /// As fichas abertas na origem por crédito especial ou extraordinário (sem dotação na lei).
  incluiFichasAbertasPorCredito Boolean

  criadoEm  DateTime @default(now())
  criadoPor String

  linhasDeReceita LinhaDeReceitaDaProposta[]
  linhasDeDespesa LinhaDeDespesaDaProposta[]
  efetivacao      EfetivacaoDaProposta?
  emendas         EmendaAoOrcamento[]

  @@index([exercicio])
}

model LinhaDeReceitaDaProposta {
  id                     String               @id @default(cuid())
  propostaOrcamentariaId String
  proposta               PropostaOrcamentaria @relation(fields: [propostaOrcamentariaId], references: [id])
  /// A previsão de origem: natureza, fonte, exercício da fonte e tipo vêm dela.
  /// V38 — nula na LINHA NOVA (receita que a lei de origem não tinha). Ou origem, ou a classificação própria
  /// abaixo: o CHECK `ck_linha_de_receita_da_proposta_origem_ou_nova` (prisma/sql) barra o INSERT direto sem nenhuma
  /// das duas ou com as duas.
  receitaDeOrigemId      String?
  receitaDeOrigem        ReceitaPrevista?     @relation(fields: [receitaDeOrigemId], references: [id], onDelete: Restrict)
  naturezaReceitaId String?
  naturezaReceita   NaturezaReceita? @relation("LinhaNovaDeReceitaNatureza", fields: [naturezaReceitaId], references: [id], onDelete: Restrict)
  fonteId           String?
  fonte             FonteRecurso?    @relation("LinhaNovaDeReceitaFonte", fields: [fonteId], references: [id], onDelete: Restrict)
  exercicioFonte    Int?
  tipoReceita       TipoReceita?
  /// Por que a linha nova existe (a importada não tem motivo: veio da lei de origem).
  motivo    String?
  criadoPor String?
  criadoEm  DateTime?
  /// A previsão da lei de origem, para a comparação entre os exercícios.
  valorNaLeiDeOrigem     Decimal              @db.Decimal(18, 2)
  /// O valor da base no exercício de origem, congelado na importação.
  valorBase              Decimal              @db.Decimal(18, 2)
  /// Base mais o percentual da proposta, em 2 casas.
  valorProjetado         Decimal              @db.Decimal(18, 2)

  ajustes AjusteDeReceitaDaProposta[]

  @@unique([propostaOrcamentariaId, receitaDeOrigemId])
  @@index([propostaOrcamentariaId])
}

model AjusteDeReceitaDaProposta {
  id        String                   @id @default(cuid())
  linhaId   String
  linha     LinhaDeReceitaDaProposta @relation(fields: [linhaId], references: [id])
  /// O valor que a linha passa a ter (não a diferença).
  valor     Decimal                  @db.Decimal(18, 2)
  motivo    String
  criadoEm  DateTime                 @default(now())
  criadoPor String

  @@index([linhaId, criadoEm])
}

model LinhaDeDespesaDaProposta {
  id                     String               @id @default(cuid())
  propostaOrcamentariaId String
  proposta               PropostaOrcamentaria @relation(fields: [propostaOrcamentariaId], references: [id])
  /// A ficha de origem: a classificação inteira e o número vêm dela.
  /// V38 — nula na LINHA NOVA (ficha que a lei de origem não tinha). Ou origem, ou a classificação própria abaixo:
  /// o CHECK `ck_linha_de_despesa_da_proposta_origem_ou_nova` (prisma/sql) barra o INSERT direto sem nenhuma das
  /// duas ou com as duas. A efetivação dá o número da ficha nova depois dos números importados.
  fichaDeOrigemId        String?
  fichaDeOrigem          FichaOrcamentaria?   @relation(fields: [fichaDeOrigemId], references: [id], onDelete: Restrict)
  orgaoId           String?
  orgao             Orgao?                @relation("LinhaNovaDaPropostaOrgao", fields: [orgaoId], references: [id], onDelete: Restrict)
  unidadeOrcId      String?
  unidadeOrc        UnidadeOrcamentaria?  @relation("LinhaNovaDaPropostaUnidade", fields: [unidadeOrcId], references: [id], onDelete: Restrict)
  funcaoId          String?
  funcao            Funcao?               @relation("LinhaNovaDaPropostaFuncao", fields: [funcaoId], references: [id], onDelete: Restrict)
  subfuncaoId       String?
  subfuncao         Subfuncao?            @relation("LinhaNovaDaPropostaSubfuncao", fields: [subfuncaoId], references: [id], onDelete: Restrict)
  programaId        String?
  programa          Programa?             @relation("LinhaNovaDaPropostaPrograma", fields: [programaId], references: [id], onDelete: Restrict)
  acaoId            String?
  acao              Acao?                 @relation("LinhaNovaDaPropostaAcao", fields: [acaoId], references: [id], onDelete: Restrict)
  naturezaDespesaId String?
  naturezaDespesa   NaturezaDespesa?      @relation("LinhaNovaDaPropostaNatureza", fields: [naturezaDespesaId], references: [id], onDelete: Restrict)
  fonteId           String?
  fonte             FonteRecurso?         @relation("LinhaNovaDaPropostaFonte", fields: [fonteId], references: [id], onDelete: Restrict)
  coId              String?
  co                CodigoAcompanhamento? @relation("LinhaNovaDaPropostaCo", fields: [coId], references: [id], onDelete: Restrict)
  exercicioFonte    Int?
  motivo    String?
  criadoPor String?
  criadoEm  DateTime?
  /// A dotação inicial da lei de origem, para a comparação entre os exercícios.
  valorNaLeiDeOrigem     Decimal              @db.Decimal(18, 2)
  valorBase              Decimal              @db.Decimal(18, 2)
  valorProjetado         Decimal              @db.Decimal(18, 2)

  ajustes AjusteDeDespesaDaProposta[]
  itensDeEmenda ItemDaEmenda[]
  bloqueiosDeEmenda BloqueioDeEmenda[]

  @@unique([propostaOrcamentariaId, fichaDeOrigemId])
  @@index([propostaOrcamentariaId])
}

model AjusteDeDespesaDaProposta {
  id        String                   @id @default(cuid())
  linhaId   String
  linha     LinhaDeDespesaDaProposta @relation(fields: [linhaId], references: [id])
  valor     Decimal                  @db.Decimal(18, 2)
  motivo    String
  criadoEm  DateTime                 @default(now())
  criadoPor String
  /// V36 — quando o ajuste veio da sanção de uma emenda, o item sancionado que o gravou.
  itemSancionado ItemSancionado?

  @@index([linhaId, criadoEm])
}

/// O FATO "esta proposta virou o orçamento do exercício". Um por proposta e um por exercício:
/// a garantia é do banco (os dois `@unique`), e a recusa legível é do caso de uso.
model EfetivacaoDaProposta {
  id                     String               @id @default(cuid())
  propostaOrcamentariaId String               @unique
  proposta               PropostaOrcamentaria @relation(fields: [propostaOrcamentariaId], references: [id])
  exercicio              Int                  @unique
  fichasCriadas          Int
  receitasCriadas        Int
  criadoEm               DateTime             @default(now())
  criadoPor              String
}
