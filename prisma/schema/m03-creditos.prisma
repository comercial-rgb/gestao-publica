// ============================================================================
// M03 — créditos adicionais (TR 4.20–4.40).
//
// REUSA o mecanismo de saldo do M05: cada item de crédito gera um
// MovimentoDotacao (CREDITO_ADICIONAL na ficha suplementada, ANULACAO_CREDITO na
// ficha anulada), e as colunas de saldo são recalculadas por SUM na MESMA
// transação. Nada disso é reimplementado aqui.
//
// APPEND-ONLY em tudo. Sem updatedAt, sem deletedAt.
// ============================================================================

enum TipoCredito {
  SUPLEMENTAR
  ESPECIAL
  EXTRAORDINARIO
}

/// ═══ ABERTO OU REABERTO — a partição que a CF art. 167 § 2º impõe (V11 V8.8) ═══
///
/// O PCASP parte o ramo do crédito ESPECIAL e do EXTRAORDINÁRIO em ABERTOS e REABERTOS —
/// contas DIFERENTES, e é o TCE que lê a diferença. Até aqui o roteiro orçamentário era
/// chaveado só por (movimento, tipo de crédito), e por isso um crédito REABERTO lançava na
/// MESMA conta de um ABERTO (pendência `ROTEIRO-SEM-DIMENSAO-DA-ABERTURA`).
///
/// ⚠️ ESTE ENUM NÃO É COLUNA DE DECRETO NEM DE MOVIMENTO, e isso é deliberado: a abertura se
/// DERIVA do ano do decreto contra o ano e a data de publicação da lei
/// (`modules/m03-creditos/abertura-do-credito.ts`), pelo mesmo caminho por onde o tipo de
/// crédito já vem. Gravá-la seria a segunda verdade sobre o mesmo crédito — o mesmo motivo
/// pelo qual `tipoCredito` não é coluna de `MovimentoDotacao`.
///
/// Ele existe aqui só para dar TIPO à dimensão do roteiro, que é onde o ente decide as contas.
enum AberturaDoCredito {
  /// Autorizado e aberto NESTE exercício.
  ABERTO

  /// Saldo de um crédito autorizado nos últimos quatro meses do exercício anterior, reaberto
  /// no seguinte pelo remanescente (CF art. 167 § 2º).
  REABERTO
}

enum OrigemRecurso {
  /// Tira de outra(s) ficha(s). Operação de DOIS LADOS que TEM de fechar.
  ANULACAO
  /// Recurso NOVO — o total autorizado sobe legitimamente.
  SUPERAVIT_FINANCEIRO
  EXCESSO_ARRECADACAO
  OPERACAO_CREDITO
}

enum TipoItemCredito {
  SUPLEMENTACAO
  ANULACAO
}

// ----------------------------------------------------------------------------
// LeiCredito — autoriza um TETO (TR 4.30). Os decretos consomem esse teto.
// ----------------------------------------------------------------------------

model LeiCredito {
  id     String @id @default(cuid())
  /// V26 — a norma no banco de legislação do TCE-PB (m03-normas-no-tce.prisma).
  normasNoTce NormaOrcamentariaNoTce[] @relation("NormaDaLeiDeCredito")
  numero String
  ano    Int
  tipoCredito TipoCredito
  /// TETO que os decretos desta lei podem consumir, somados.
  valorAutorizado Decimal  @db.Decimal(18, 2)
  /// Percentual da LOA autorizado (quando a lei se expressa em %).
  percentualLimite Decimal? @db.Decimal(9, 6)
  dataPublicacao   DateTime

  decretos DecretoCredito[]

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([ano, numero])
  @@index([ano])
}

// ----------------------------------------------------------------------------
// DecretoCredito — executa (parte do) teto da lei.
//
// NÃO existe coluna `status`. "Encerrado?" é DERIVADO da EXISTÊNCIA de um
// DecretoEncerramento — mesmo padrão do estorno no ledger e do status do empenho
// no M05. Uma coluna `status` exigiria UPDATE no decreto, que o append-only
// proíbe; e o encerramento é um FATO (alguém encerrou, numa data), não um
// atributo do decreto.
// ----------------------------------------------------------------------------

model DecretoCredito {
  id     String     @id @default(cuid())
  /// V26 — o PDF do decreto, que o SAGRES exige junto (§4.6).
  anexos Anexo[] @relation("AnexoDoDecreto")
  leiId  String
  lei    LeiCredito @relation(fields: [leiId], references: [id])
  numero String
  ano    Int
  data   DateTime

  origemRecurso OrigemRecurso

  itens       ItemCredito[]
  encerramento DecretoEncerramento?

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([ano, numero])
  @@index([leiId])
}

/// O FATO "este decreto foi encerrado". Append-only: existir = encerrado.
model DecretoEncerramento {
  id        String         @id @default(cuid())
  decretoId String         @unique
  decreto   DecretoCredito @relation(fields: [decretoId], references: [id])
  data      DateTime
  motivo    String
  criadoEm  DateTime       @default(now())
  criadoPor String
}

// ----------------------------------------------------------------------------
// ItemCredito — uma perna do crédito. Cada item gera UM MovimentoDotacao.
//
// É o "partidas dobradas da dotação": num decreto por ANULACAO,
// Σ(ANULACAO) == Σ(SUPLEMENTACAO) por fonte (TR 5.111).
// ----------------------------------------------------------------------------

model ItemCredito {
  id        String         @id @default(cuid())
  decretoId String
  decreto   DecretoCredito @relation(fields: [decretoId], references: [id])

  fichaId String
  ficha   FichaOrcamentaria @relation(fields: [fichaId], references: [id])

  tipo  TipoItemCredito
  valor Decimal         @db.Decimal(18, 2)

  /// Fonte do recurso desta perna. TEM de bater com a fonte da ficha.
  fonteId String
  fonte   FonteRecurso @relation(fields: [fonteId], references: [id])

  /// O movimento de saldo que este item gerou (M05). 1-1.
  movimentoDotacaoId String           @unique
  movimentoDotacao   MovimentoDotacao @relation(fields: [movimentoDotacaoId], references: [id])

  estornoDeId String?
  estornoDe   ItemCredito?  @relation("EstornoItemCredito", fields: [estornoDeId], references: [id])
  estornos    ItemCredito[] @relation("EstornoItemCredito")

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([decretoId])
  @@index([fichaId])
  @@index([estornoDeId])
}

// ----------------------------------------------------------------------------
// DisponibilidadeRecursoNovo — o "saldo da fonte" para crédito SEM anulação.
//
// POR QUE EXISTE: o spec manda "validar saldo da fonte de superávit/excesso",
// mas não havia NADA no sistema contra o que validar. Sem esta tabela, o
// invariante 5 seria uma checagem que sempre passa — pior que não ter.
// Aqui se DECLARA a disponibilidade apurada (superávit do balanço anterior,
// excesso de arrecadação, valor da operação de crédito contratada), e o crédito
// por recurso novo não pode ultrapassá-la.
// ----------------------------------------------------------------------------

/// ⚠️ A DECLARAÇÃO É VERSIONADA, E NÃO SOBRESCRITA (V11 V7.3).
///
/// Até aqui havia UMA linha por (exercício, fonte, origem), e redeclarar significava trocar o
/// `valor` dela. Isso REESCREVIA O HISTÓRICO em silêncio: um decreto aprovado contra "superávit
/// de 100.000" passava a constar aprovado contra "superávit de 40.000", e a prestação de contas
/// não teria como mostrar contra o que a autorização foi dada. É a mesma lição da configuração do
/// acesso à informação, que por isso nasceu versionada.
///
/// Agora cada declaração é um FATO: `versao` cresce, nada é apagado, e a VIGENTE é a de maior
/// versão. O guard do crédito lê a maior; a consulta mostra a maior e sabe dizer que houve outras.
///
/// ⚠️ E O LOCK MUDOU DE CHAVE JUNTO. Ele travava o `id` da linha — que agora muda a cada versão,
/// e duas transações passariam a travar postes diferentes para a mesma fonte. A chave virou
/// `exercicio:fonteId:origem`, que é estável por construção. Ver `adapter-prisma.ts`.
model DisponibilidadeRecursoNovo {
  id        String        @id @default(cuid())
  exercicio Int
  fonteId   String
  fonte     FonteRecurso  @relation(fields: [fonteId], references: [id])
  origem    OrigemRecurso
  valor     Decimal       @db.Decimal(18, 2)
  descricao String

  /// 1, 2, 3… por (exercício, fonte, origem). A VIGENTE é a maior. As linhas antigas
  /// permanecem: elas são o que autorizou os decretos daquele momento.
  versao Int @default(1)

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([exercicio, fonteId, origem, versao])
  @@index([fonteId])
  /// O índice da leitura que mais importa: a VIGENTE de uma fonte, dentro da transação do
  /// decreto. Sem ele, `ORDER BY versao DESC LIMIT 1` varre todas as versões da fonte.
  @@index([exercicio, fonteId, origem, versao])
}

// ============================================================================
// V21 — REALOCAÇÃO DE DOTAÇÃO: remanejamento, transposição e transferência
// (Constituição, art. 167, VI).
//
// ⚠️ NÃO É CRÉDITO ADICIONAL, E POR ISSO NÃO É UM QUARTO `TipoCredito`. O crédito adicional
// autoriza despesa NÃO computada ou insuficientemente dotada (Lei 4.320, art. 40) e consome o
// limite que a LOA dá ao Executivo; o `TipoCredito` governa esse limite, e dez sítios o enumeram.
// A realocação move dotação que JÁ EXISTE, de uma programação para outra, por LEI ESPECÍFICA —
// fora daquele limite. Acrescentar ali faria o remanejamento herdar a lógica do teto em todos
// aqueles sítios.
//
// ⚠️ UM ATO, INDIVISÍVEL. O ato nasce COM as pernas, na mesma transação: não existe ato vazio
// esperando itens (o par lei/decreto do crédito adicional tem esse estado intermediário porque a
// lei autoriza um teto que vários decretos consomem; aqui a lei específica autoriza exatamente o
// que o ato move). Σ acréscimo == Σ redução no total e em CADA FONTE.
//
// APPEND-ONLY. Desfazer é a `AnulacaoDeRealocacao` + uma perna NOVA invertida por perna viva, com
// o lançamento no razão ESTORNANDO o original (mesmas contas, lados trocados).
// ============================================================================

/// A espécie que a LEI declara. O sistema não a deduz: a doutrina distingue as três pela natureza
/// da mudança (órgão, programa, categoria econômica), e é a lei que diz qual delas autorizou.
enum EspecieDeRealocacao {
  /// Entre órgãos ou unidades — em geral por reorganização administrativa.
  REMANEJAMENTO
  /// Entre programas de trabalho, dentro do mesmo órgão.
  TRANSPOSICAO
  /// Entre categorias econômicas de despesa, dentro do mesmo programa de trabalho.
  TRANSFERENCIA
}

enum TipoPernaDeRealocacao {
  /// A ficha que RECEBE dotação.
  ACRESCIMO
  /// A ficha que CEDE dotação. Não pode ceder o que já está empenhado ou reservado.
  REDUCAO
}

model AtoDeRealocacao {
  id       String              @id @default(cuid())
  especie  EspecieDeRealocacao
  /// Número do ato do Executivo que executa a realocação (em geral, decreto).
  numero   String
  /// Exercício do ato — o ano CIVIL da `data`, no fuso do ente. Todas as fichas são deste ano.
  ano      Int
  /// A data do FATO: é a competência dos movimentos e dos lançamentos.
  data     DateTime

  /// A autorização legislativa PRÉVIA que o art. 167, VI exige. Obrigatória: sem ela o ato não
  /// nasce.
  leiNumero          String
  leiDataPublicacao  DateTime

  /// Por que a dotação muda de lugar — o que a prestação de contas lê.
  justificativa String

  itens     ItemDeRealocacao[]
  anulacao  AnulacaoDeRealocacao?

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([ano, numero])
  @@index([ano])
}

/// Uma perna da realocação. Cada perna gera UM `MovimentoDotacao` (e a perna dele no razão).
model ItemDeRealocacao {
  id    String          @id @default(cuid())
  atoId String
  ato   AtoDeRealocacao @relation(fields: [atoId], references: [id])

  fichaId String
  ficha   FichaOrcamentaria @relation(fields: [fichaId], references: [id])

  tipo  TipoPernaDeRealocacao
  valor Decimal               @db.Decimal(18, 2)

  /// Fonte desta perna. TEM de ser a fonte da ficha (conferido no adapter).
  fonteId String
  fonte   FonteRecurso @relation(fields: [fonteId], references: [id])

  /// O movimento de saldo que esta perna gerou (M05). 1-1.
  movimentoDotacaoId String           @unique
  movimentoDotacao   MovimentoDotacao @relation(fields: [movimentoDotacaoId], references: [id])

  /// A perna original, quando esta é o estorno dela. Único: uma perna se estorna uma vez.
  estornoDeId String?           @unique
  estornoDe   ItemDeRealocacao? @relation("EstornoDaRealocacao", fields: [estornoDeId], references: [id])
  estorno     ItemDeRealocacao? @relation("EstornoDaRealocacao")

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([atoId])
  @@index([fichaId])
}

/// O FATO "esta realocação foi desfeita". Existir = anulada. Uma por ato.
model AnulacaoDeRealocacao {
  id        String          @id @default(cuid())
  atoId     String          @unique
  ato       AtoDeRealocacao @relation(fields: [atoId], references: [id])
  data      DateTime
  motivo    String
  criadoEm  DateTime        @default(now())
  criadoPor String
}
