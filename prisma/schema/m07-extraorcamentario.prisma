// ============================================================================
// M07 — extraorçamentário: consignações, retenções e cauções.
//
// Dinheiro de TERCEIROS transitando pelo caixa: entra sem ser receita, sai sem
// ser despesa. NÃO toca dotação (MovimentoDotacao) nem a fila do art. 141 (M06).
//
// SIMÉTRICO DESDE O DIA 1: os quatro tipos de movimento (ingresso, dispêndio e
// os dois estornos) existem desde o início. No M08 os estornos chegaram depois e
// custaram dois bugs (345af7d, 4768cff) — a assimetria é uma bomba-relógio.
//
// APPEND-ONLY em tudo. Sem updatedAt, sem deletedAt.
// ============================================================================

/// TABELA, não enum: o rol NÃO é fechado — o ente pode criar tipos próprios
/// (consignação de plano de saúde, de sindicato, de associação...). Um enum
/// exigiria migração a cada tipo novo.
model TipoConsignacao {
  id        String  @id @default(cuid())
  /// V26 — retenção própria do Tesouro (m07-retencao-propria.prisma).
  retencoesProprias ClassificacaoDaRetencaoPropria[] @relation("RetencaoPropriaDoTipo")
  codigo    String  @unique
  descricao String
  ativo     Boolean @default(true)

  /// A conta do PCASP onde o PASSIVO desta consignação nasce — a perna que fica
  /// devendo ao consignatário quando se retém na fonte.
  ///
  /// ⚠️ POR QUE ELA PRECISA EXISTIR NO CADASTRO, E NÃO NO CÓDIGO.
  /// Até aqui, `contaConsignacaoAPagar` era um PARÂMETRO que cada chamador passava —
  /// e todos os chamadores eram teste ou seed. Nenhuma TELA podia oferecer retenção,
  /// porque a tela não tem de onde tirar a conta: qual passivo recebe o INSS retido é
  /// escolha do ente sobre o plano de contas DELE, não uma regra que se deduza.
  ///
  /// As duas alternativas eram piores. Um mapa `{"INSS": "2.1.8..."}` no código seria
  /// inventar o plano de contas de todo município a partir de um exemplo. Pedir a conta
  /// ao operador a cada pagamento poria uma decisão contábil permanente numa tela de
  /// execução, para ser reacertada — e errada — a cada retenção.
  ///
  /// NULLABLE, aditiva, SEM backfill e SEM default — a mesma doutrina de
  /// `ContaBancaria.contaContabilId`. Um default carimbaria toda consignação com um
  /// passivo inventado, e o razão passaria a acumular dívida com o consignatário errado
  /// sem ninguém perceber. Quem retém é FAIL-CLOSED: o tipo sem conta NÃO é oferecido na
  /// tela, e o motivo é declarado ali mesmo.
  contaPassivoId String?
  contaPassivo   ContaPcasp? @relation("PassivoDaConsignacao", fields: [contaPassivoId], references: [id])

  movimentos MovimentoExtraorcamentario[]
  /// V28 — as rubricas de desconto da folha retidas como este tipo.
  rubricasDaFolha ConsignacaoDaRubrica[]
  decisoes   DecisaoDoTipoDeConsignacao[] @relation("DecisoesDoTipoDeConsignacao")

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// A DECISÃO DO ENTE sobre um tipo de consignação — qual passivo o recebe, e se ele vale.
///
/// ═══ ⚠️ POR QUE UM FATO, E NÃO DUAS COLUNAS QUE SE EDITAM ═══
/// Escolher em que conta do PCASP o INSS retido vira dívida é CLASSIFICAÇÃO CONTÁBIL do ente —
/// não é configuração de tela. Ela muda (o plano do ente muda, o TCE orienta diferente), e a
/// pergunta "desde quando o INSS ia para esta conta?" tem de ter resposta: um razão de cinco anos
/// atrás foi escriturado contra a decisão daquela época, não contra a de hoje.
///
/// ⚠️ E O PAPEL DE RUNTIME NÃO TEM `UPDATE` EM `TipoConsignacao`. Editar a coluna exigiria
/// afrouxar o grant — e a regra da casa é usar a primitiva certa, não abrir o banco para caber
/// um desenho. A vigente é a de maior `criadoEm`.
///
/// ⚠️ `contaPassivoId` NULO SIGNIFICA DESATIVADO, e o CHECK impõe: um tipo ativo sem conta seria
/// um tipo oferecido na tela que a retenção recusa no meio do pagamento — o pior momento.
model DecisaoDoTipoDeConsignacao {
  id String @id @default(cuid())

  tipoId String
  tipo   TipoConsignacao @relation("DecisoesDoTipoDeConsignacao", fields: [tipoId], references: [id])

  ativo Boolean

  contaPassivoId String?
  contaPassivo   ContaPcasp? @relation("PassivoDecididoDaConsignacao", fields: [contaPassivoId], references: [id])

  /// Por que ESTA conta, ou por que desativar. Obrigatório: a classificação é do ente, e uma
  /// escolha contábil sem fundamento é a mesma coisa que uma conta inventada — só que com a
  /// aparência de decisão.
  fundamento String

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([tipoId, criadoEm])
}

enum TipoMovimentoExtra {
  /// Dinheiro de terceiro ENTRA no caixa (retenção na fonte, caução, depósito).
  INGRESSO
  /// Dinheiro de terceiro SAI (repasse ao consignatário, devolução da caução).
  DISPENDIO
  /// Desfaz um INGRESSO.
  ESTORNO_INGRESSO
  /// Desfaz um DISPENDIO.
  ESTORNO_DISPENDIO
  /// V26 — o saldo antigo de IR/ISS do próprio Tesouro, que estava como consignação, é baixado contra a
  /// receita (sem saída de banco). O passivo DIMINUI. Ver `ApropriacaoDaConsignacaoPropria`.
  APROPRIACAO_COMO_RECEITA
}

// ----------------------------------------------------------------------------
// MovimentoExtraorcamentario — o razão do dinheiro de terceiros. APPEND-ONLY.
//
// Saldo por (tipoConsignacao, credorConsignatario) = Σ(valor × sinal do tipo).
// O `valor` é SEMPRE positivo; quem dá o sinal é o tipo (SINAL_MOVIMENTO_EXTRA,
// em dominio.ts). NENHUMA soma bruta — lição do M08.
// ----------------------------------------------------------------------------

model MovimentoExtraorcamentario {
  id String @id @default(cuid())
  /// V26 — a regularização do legado (m07-retencao-propria.prisma).
  apropriacaoDoIngresso ApropriacaoDaConsignacaoPropria? @relation("IngressoApropriado")
  apropriacaoFeita      ApropriacaoDaConsignacaoPropria? @relation("MovimentoDeApropriacao")

  tipoConsignacaoId String
  tipoConsignacao   TipoConsignacao @relation(fields: [tipoConsignacaoId], references: [id])
  /// A quem o dinheiro pertence (INSS, o servidor da pensão, o caucionante...).
  credorConsignatario String

  contaBancariaId String
  contaBancaria   ContaBancaria @relation(fields: [contaBancariaId], references: [id])

  /// A FONTE DO RECURSO que este movimento carrega.
  ///
  /// ⚠️ ELA NÃO É A FONTE DA CONTA, e é por isso que existe como coluna. Desde o ADR de
  /// 2026-09-10 uma conta bancária admite um ROL de fontes (`FonteDaContaBancaria`, TR
  /// 5.10.2.6) — a conta única com fonte única era a cardinalidade errada. Enquanto o
  /// movimento não declarava a sua, `extraorcamentarioPorFonte` atribuía TODOS os
  /// movimentos à fonte PADRÃO da conta, e numa conta multifonte isso é exatamente o
  /// número que não se pode inventar: o que prova que recurso vinculado não custeou
  /// outra coisa.
  ///
  /// ⚠️ NULLABLE DE PROPÓSITO. Os movimentos gravados ANTES desta coluna não têm como
  /// saber a fonte, e preenchê-los com a da conta seria escrever a invenção no banco em
  /// vez de deixá-la na consulta. Eles continuam somando no balde declarado
  /// `(sem fonte declarada)` da tela de tesouraria; os novos, não — o caso de uso EXIGE a
  /// fonte e a confere contra o rol da conta.
  fonteId String?
  fonte   FonteRecurso? @relation(fields: [fonteId], references: [id])

  tipo  TipoMovimentoExtra
  /// SEMPRE positivo. O sinal vem do tipo.
  valor Decimal            @db.Decimal(18, 2)
  data  DateTime

  /// Preenchido quando a origem é RETENÇÃO NA FONTE: o ingresso nasceu dentro
  /// de um pagamento. Nulo nos ingressos avulsos (caução, depósito).
  pagamentoId String?
  pagamento   Pagamento? @relation(fields: [pagamentoId], references: [id])

  /// APPEND-ONLY: o estorno referencia o movimento que desfaz.
  estornoDeId String?
  estornoDe   MovimentoExtraorcamentario?  @relation("EstornoExtra", fields: [estornoDeId], references: [id])
  estornos    MovimentoExtraorcamentario[] @relation("EstornoExtra")

  lancamentoId String
  lancamento   LancamentoContabil @relation(fields: [lancamentoId], references: [id])

  /// back-relation M09 — o item de lote que a agrupou. Campo VIRTUAL.
  itemDeLote ItemDoLote?

  /// back-relations C34 — as alocações deste movimento. Campos VIRTUAIS.
  /// `alocacoesFeitas` quando ele é o RECOLHIMENTO; `alocacoesRecebidas` quando é o INGRESSO.
  alocacoesFeitas    AlocacaoDoRecolhimento[] @relation("RecolhimentoAlocado")
  alocacoesRecebidas AlocacaoDoRecolhimento[] @relation("IngressoAlocado")

  historico String
  motivo    String?

  /// V23 — o CPF/CNPJ de quem entregou o dinheiro, no ingresso AVULSO (caução, depósito): o SAGRES
  /// o exige (ReceitaExtra §4.19, cpfCnpjFornecedor). Na retenção ele vem do credor do empenho e fica
  /// nulo aqui. Nulo nos ingressos gravados antes — o gerador recusa nomeando, não inventa documento.
  documentoDoContribuinte String?

  /// V24 — o CPF/CNPJ de quem RECEBE o recolhimento (DISPENDIO): o SAGRES o exige (DespesaExtra §4.20,
  /// cpfCnpjFornecedor, "CPF/CNPJ do Beneficiário"). Nulo nos recolhimentos gravados antes.
  documentoDoFavorecido String?

  /// V24 — back-relation VIRTUAL: a memória do cálculo, quando esta retenção foi calculada.
  calculoDaRetencao CalculoDaRetencao?

  /// V34 — back-relation VIRTUAL: a atribuição de entidade do movimento sem titular derivável (regularização).
  atribuicaoDeEntidade AtribuicaoDeEntidadeDoMovimentoExtra?

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([tipoConsignacaoId, credorConsignatario])
  @@index([pagamentoId])
  @@index([estornoDeId])
  @@index([data])
  @@index([fonteId])
}

// ----------------------------------------------------------------------------
// AlocacaoDoRecolhimento — QUAL retenção cada recolhimento quita (C34).
//
// ═══ ⚠️ POR QUE O SALDO AGREGADO NÃO BASTA ═══
// O saldo extraorçamentário é somado por `(tipoConsignacao, credorConsignatario)`, e
// isso responde "quanto ainda se deve ao INSS" — mas não responde as duas perguntas
// que o termo de referência faz:
//
//   · COMPOSIÇÃO POR ORIGEM: a guia de dezembro recolhe retenções de outubro, de
//     novembro e de um resto de setembro. Sem vínculo, o recolhimento é um valor
//     solto contra um saldo global, e "de onde veio" não tem resposta;
//   · REABRIR SÓ A PARCELA CABÍVEL: estornar um recolhimento tem de devolver ao
//     campo do que falta recolher exatamente as retenções que ELE quitou — não uma
//     fatia proporcional de um agregado.
//
// ⚠️ E A ORIGEM ATRAVESSA O EXERCÍCIO, de propósito: não há restrição de exercício
// aqui. Uma retenção de dezembro se recolhe em janeiro, e é justamente esse vínculo
// que o tribunal lê quando pergunta o que sobrou do ano anterior.
//
// ═══ O QUE O BANCO GARANTE E O QUE O CASO DE USO GARANTE ═══
// O banco garante: valor positivo (`ck_alocacao_recolhimento_positiva`), um par
// (recolhimento, ingresso) uma vez só, e as duas pontas existindo.
//
// As SOMAS ficam no caso de uso, dentro da transação e com lock, porque CHECK não
// soma linhas: Σ(alocações do recolhimento) == valor do recolhimento, e
// Σ(alocações sobre um ingresso) ≤ o que aquele ingresso ainda tem a recolher. É a
// mesma divisão de `InscricaoRestosAPagar` — o limite sai do SUM real.
//
// ⚠️ APPEND-ONLY, E O ESTORNO NÃO APAGA LINHA. Quando um recolhimento é estornado, as
// suas alocações PERMANECEM: quem as ignora é a leitura, que desconsidera alocação cujo
// recolhimento tenha estorno. Apagá-las destruiria a resposta a "o que esta guia
// quitou, antes de ser desfeita?".
// ----------------------------------------------------------------------------

model AlocacaoDoRecolhimento {
  id String @id @default(cuid())

  /// O DISPENDIO (recolhimento/repasse) que está sendo composto.
  recolhimentoId String
  recolhimento   MovimentoExtraorcamentario @relation("RecolhimentoAlocado", fields: [recolhimentoId], references: [id], onDelete: Restrict)

  /// O INGRESSO (retenção) que esta parcela quita — do exercício corrente ou de anterior.
  ingressoId String
  ingresso   MovimentoExtraorcamentario @relation("IngressoAlocado", fields: [ingressoId], references: [id], onDelete: Restrict)

  /// SEMPRE positivo. Parcial por natureza: uma retenção pode ser quitada em mais de um
  /// recolhimento, e um recolhimento pode compor mais de uma retenção.
  valor Decimal @db.Decimal(18, 2)

  criadoEm  DateTime @default(now())
  criadoPor String

  /// Uma linha por par: duas parcelas do mesmo recolhimento sobre a mesma retenção são
  /// uma parcela só, e somá-las em duas linhas esconderia a duplicidade.
  @@unique([recolhimentoId, ingressoId])
  @@index([ingressoId])
}

// ----------------------------------------------------------------------------
// V34 — DE QUEM É O MOVIMENTO EXTRAORÇAMENTÁRIO QUE NADA DIZ (regularização)
//
// A unidade gestora de um movimento extraorçamentário sai de vínculo comprovado: a retenção
// pela unidade orçamentária do empenho que reteve; o estorno, pelo movimento que desfaz; o
// ingresso avulso e o recolhimento, pelo titular declarado da conta em que o dinheiro passou.
// Quando a conta não tem titular declarado, o movimento fica SEM unidade gestora — e o SAGRES
// de um ente com várias UGs o nomeia como omitido, em vez de carimbá-lo em quem pediu.
//
// Esta tabela é a entrada autorizada para regularizar UM movimento: alguém atribui a entidade,
// por ato próprio, com motivo, autor e o ato do ente que fundamenta. Espelho de
// `AtribuicaoDeEntidadeDaArrecadacao` (M04). Insert-only; UMA por movimento (@unique) — o
// histórico é a própria linha, e corrigir uma atribuição não é UPDATE.
// ----------------------------------------------------------------------------

model AtribuicaoDeEntidadeDoMovimentoExtra {
  id String @id @default(cuid())

  movimentoId String                     @unique
  movimento   MovimentoExtraorcamentario @relation(fields: [movimentoId], references: [id])

  entidadeId String
  entidade   EntidadeContabil @relation(fields: [entidadeId], references: [id])

  motivo String

  atoTipo        TipoDeAtoDeclarado
  atoNumero      String
  atoAno         Int
  atoDispositivo String
  atoCitacao     String

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([entidadeId])
}
