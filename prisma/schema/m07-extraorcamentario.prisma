// ============================================================================
// M07 — extraorçamentário: consignações, retenções e cauções.
//
// Dinheiro de TERCEIROS transitando pelo caixa: entra sem ser receita, sai sem
// ser despesa. NÃO toca dotação (MovimentoDotacao) nem a fila do art. 141 (M06).
//
// SIMÉTRICO DESDE O DIA 1: os quatro tipos de movimento (ingresso, dispêndio e
// os dois estornos) existem desde o início. No M08 os estornos chegaram depois e
// custaram dois bugs (345af7d, 4768cff) — a assimetria é uma bomba-relógio.
//
// APPEND-ONLY em tudo. Sem updatedAt, sem deletedAt.
// ============================================================================

/// TABELA, não enum: o rol NÃO é fechado — o ente pode criar tipos próprios
/// (consignação de plano de saúde, de sindicato, de associação...). Um enum
/// exigiria migração a cada tipo novo.
model TipoConsignacao {
  id        String  @id @default(cuid())
  codigo    String  @unique
  descricao String
  ativo     Boolean @default(true)

  /// A conta do PCASP onde o PASSIVO desta consignação nasce — a perna que fica
  /// devendo ao consignatário quando se retém na fonte.
  ///
  /// ⚠️ POR QUE ELA PRECISA EXISTIR NO CADASTRO, E NÃO NO CÓDIGO.
  /// Até aqui, `contaConsignacaoAPagar` era um PARÂMETRO que cada chamador passava —
  /// e todos os chamadores eram teste ou seed. Nenhuma TELA podia oferecer retenção,
  /// porque a tela não tem de onde tirar a conta: qual passivo recebe o INSS retido é
  /// escolha do ente sobre o plano de contas DELE, não uma regra que se deduza.
  ///
  /// As duas alternativas eram piores. Um mapa `{"INSS": "2.1.8..."}` no código seria
  /// inventar o plano de contas de todo município a partir de um exemplo. Pedir a conta
  /// ao operador a cada pagamento poria uma decisão contábil permanente numa tela de
  /// execução, para ser reacertada — e errada — a cada retenção.
  ///
  /// NULLABLE, aditiva, SEM backfill e SEM default — a mesma doutrina de
  /// `ContaBancaria.contaContabilId`. Um default carimbaria toda consignação com um
  /// passivo inventado, e o razão passaria a acumular dívida com o consignatário errado
  /// sem ninguém perceber. Quem retém é FAIL-CLOSED: o tipo sem conta NÃO é oferecido na
  /// tela, e o motivo é declarado ali mesmo.
  contaPassivoId String?
  contaPassivo   ContaPcasp? @relation("PassivoDaConsignacao", fields: [contaPassivoId], references: [id])

  movimentos MovimentoExtraorcamentario[]

  criadoEm  DateTime @default(now())
  criadoPor String
}

enum TipoMovimentoExtra {
  /// Dinheiro de terceiro ENTRA no caixa (retenção na fonte, caução, depósito).
  INGRESSO
  /// Dinheiro de terceiro SAI (repasse ao consignatário, devolução da caução).
  DISPENDIO
  /// Desfaz um INGRESSO.
  ESTORNO_INGRESSO
  /// Desfaz um DISPENDIO.
  ESTORNO_DISPENDIO
}

// ----------------------------------------------------------------------------
// MovimentoExtraorcamentario — o razão do dinheiro de terceiros. APPEND-ONLY.
//
// Saldo por (tipoConsignacao, credorConsignatario) = Σ(valor × sinal do tipo).
// O `valor` é SEMPRE positivo; quem dá o sinal é o tipo (SINAL_MOVIMENTO_EXTRA,
// em dominio.ts). NENHUMA soma bruta — lição do M08.
// ----------------------------------------------------------------------------

model MovimentoExtraorcamentario {
  id String @id @default(cuid())

  tipoConsignacaoId String
  tipoConsignacao   TipoConsignacao @relation(fields: [tipoConsignacaoId], references: [id])
  /// A quem o dinheiro pertence (INSS, o servidor da pensão, o caucionante...).
  credorConsignatario String

  contaBancariaId String
  contaBancaria   ContaBancaria @relation(fields: [contaBancariaId], references: [id])

  /// A FONTE DO RECURSO que este movimento carrega.
  ///
  /// ⚠️ ELA NÃO É A FONTE DA CONTA, e é por isso que existe como coluna. Desde o ADR de
  /// 2026-09-10 uma conta bancária admite um ROL de fontes (`FonteDaContaBancaria`, TR
  /// 5.10.2.6) — a conta única com fonte única era a cardinalidade errada. Enquanto o
  /// movimento não declarava a sua, `extraorcamentarioPorFonte` atribuía TODOS os
  /// movimentos à fonte PADRÃO da conta, e numa conta multifonte isso é exatamente o
  /// número que não se pode inventar: o que prova que recurso vinculado não custeou
  /// outra coisa.
  ///
  /// ⚠️ NULLABLE DE PROPÓSITO. Os movimentos gravados ANTES desta coluna não têm como
  /// saber a fonte, e preenchê-los com a da conta seria escrever a invenção no banco em
  /// vez de deixá-la na consulta. Eles continuam somando no balde declarado
  /// `(sem fonte declarada)` da tela de tesouraria; os novos, não — o caso de uso EXIGE a
  /// fonte e a confere contra o rol da conta.
  fonteId String?
  fonte   FonteRecurso? @relation(fields: [fonteId], references: [id])

  tipo  TipoMovimentoExtra
  /// SEMPRE positivo. O sinal vem do tipo.
  valor Decimal            @db.Decimal(18, 2)
  data  DateTime

  /// Preenchido quando a origem é RETENÇÃO NA FONTE: o ingresso nasceu dentro
  /// de um pagamento. Nulo nos ingressos avulsos (caução, depósito).
  pagamentoId String?
  pagamento   Pagamento? @relation(fields: [pagamentoId], references: [id])

  /// APPEND-ONLY: o estorno referencia o movimento que desfaz.
  estornoDeId String?
  estornoDe   MovimentoExtraorcamentario?  @relation("EstornoExtra", fields: [estornoDeId], references: [id])
  estornos    MovimentoExtraorcamentario[] @relation("EstornoExtra")

  lancamentoId String
  lancamento   LancamentoContabil @relation(fields: [lancamentoId], references: [id])

  /// back-relation M09 — o item de lote que a agrupou. Campo VIRTUAL.
  itemDeLote ItemDoLote?

  historico String
  motivo    String?

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([tipoConsignacaoId, credorConsignatario])
  @@index([pagamentoId])
  @@index([estornoDeId])
  @@index([data])
  @@index([fonteId])
}
