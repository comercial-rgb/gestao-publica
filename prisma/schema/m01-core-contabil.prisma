// ============================================================================
// M01 — core-contabil: plano de contas PCASP + ledger de partidas dobradas.
// REGRA DE OURO: dinheiro NUNCA é Float. Sempre Decimal @db.Decimal(18,2).
// INVARIANTE 2: o ledger é APPEND-ONLY — LancamentoContabil e PartidaContabil
// não têm updatedAt nem deletedAt. Correção = novo lançamento de estorno.
// ============================================================================

enum NaturezaSaldo {
  DEVEDORA
  CREDORA
}

/// Atributo MCASP: F = financeiro, P = permanente.
enum IndicadorSuperavit {
  F
  P
}

/// Perna única: cada partida toca UMA conta, como débito OU crédito.
enum TipoPartida {
  DEBITO
  CREDITO
}

enum Subsistema {
  ORCAMENTARIO
  PATRIMONIAL
  CONTROLE
}

// ----------------------------------------------------------------------------
// Plano de contas PCASP (hierárquico).
// FAIL-CLOSED: só conta com `analitica = true` pode receber partida. A regra é
// aplicada no M01 (que tem banco), nunca no motor puro de packages/ledger.
// ----------------------------------------------------------------------------

model ContaPcasp {
  id                 String             @id @default(cuid())
  codigo             String             @unique
  nome               String
  naturezaSaldo      NaturezaSaldo
  nivel              Int
  contaPaiId         String?
  contaPai           ContaPcasp?        @relation("Hierarquia", fields: [contaPaiId], references: [id])
  filhas             ContaPcasp[]       @relation("Hierarquia")
  analitica          Boolean
  indicadorSuperavit IndicadorSuperavit?
  partidas           PartidaContabil[]
  /// back-relation M09 — campo VIRTUAL, não gera coluna.
  contasBancarias    ContaBancaria[]
  /// back-relation M07 — o passivo de cada tipo de consignação. Campo VIRTUAL.
  passivosDeConsignacao TipoConsignacao[] @relation("PassivoDaConsignacao")
  passivosDecididosDeConsignacao DecisaoDoTipoDeConsignacao[] @relation("PassivoDecididoDaConsignacao")
  /// back-relations M10 — campos VIRTUAIS, não geram coluna.
  classesDeBens      ClasseDeBens[]       @relation("AtivoDaClasse")
  roteirosDebito     RoteiroPatrimonial[] @relation("DebitoPatrimonial")
  roteirosCredito    RoteiroPatrimonial[] @relation("CreditoPatrimonial")
  roteirosResultadoDebito  RoteiroResultadoAlienacao[] @relation("DebitoResultado")
  roteirosResultadoCredito RoteiroResultadoAlienacao[] @relation("CreditoResultado")
  /// back-relations M05 (roteiro do subsistema ORÇAMENTÁRIO) — campos VIRTUAIS.
  roteirosOrcDebito  RoteiroOrcamentario[] @relation("DebitoOrcamentario")
  roteirosOrcCredito RoteiroOrcamentario[] @relation("CreditoOrcamentario")
  roteirosPorFonteDebito  RoteiroDaDotacaoPorFonte[] @relation("DebitoPorFonte")
  roteirosPorFonteCredito RoteiroDaDotacaoPorFonte[] @relation("CreditoPorFonte")
  /// back-relation M08 (apuração do resultado) — campo VIRTUAL.
  roteirosEncerramento     RoteiroEncerramento[]       @relation("ResultadosAcumulados")
  roteirosRpDebito         RoteiroRestosAPagar[]       @relation("DebitoRestosAPagar")
  roteirosRpCredito        RoteiroRestosAPagar[]       @relation("CreditoRestosAPagar")
  roteirosRpControleDebito  RoteiroRestosAPagar[]      @relation("ControleDebitoRestosAPagar")
  roteirosRpControleCredito RoteiroRestosAPagar[]      @relation("ControleCreditoRestosAPagar")
  /// back-relation M08 (destino da conta de controle na virada) — campo VIRTUAL.
  destinoNaVirada          ContaNaVirada[]             @relation("DestinoNaVirada")
  /// back-relations M10 (dívida) — campos VIRTUAIS, não geram coluna.
  passivosDeDivida         DividaConsolidada[]         @relation("PassivoDaDivida")
  // ── ENT03b: os cadastros novos apontam a conta por PARÂMETRO, como todos os outros. ──
  controlesDeConvenio      Convenio[]                  @relation("ControleDoConvenio")
  debitosDoRoteiroConvenio  RoteiroConvenio[]          @relation("DebitoDoRoteiroConvenio")
  creditosDoRoteiroConvenio RoteiroConvenio[]          @relation("CreditoDoRoteiroConvenio")
  passivosDePrecatorio     Precatorio[]                @relation("PassivoDoPrecatorio")
  debitosDoRoteiroPrecatorio  RoteiroPrecatorio[]      @relation("DebitoDoRoteiroPrecatorio")
  creditosDoRoteiroPrecatorio RoteiroPrecatorio[]      @relation("CreditoDoRoteiroPrecatorio")
  /// back-relation M33 (V13) — a conta em que o adiantamento salarial vira DIREITO. Campo
  /// VIRTUAL: a FK vive em `ParametroDoAdiantamentoSalarial`.
  parametrosDoAdiantamentoSalarial ParametroDoAdiantamentoSalarial[] @relation("ContaDoAdiantamentoSalarial")
  controlesDeConsorcio     ConsorcioPublico[]          @relation("ControleDoConsorcio")
  debitosDoRoteiroConsorcio  RoteiroConsorcio[]        @relation("DebitoDoRoteiroConsorcio")
  creditosDoRoteiroConsorcio RoteiroConsorcio[]        @relation("CreditoDoRoteiroConsorcio")
  roteirosDividaDebito     RoteiroDivida[]             @relation("DebitoDivida")
  roteirosDividaCredito    RoteiroDivida[]             @relation("CreditoDivida")
  /// back-relations M10 (dívida ATIVA) — campos VIRTUAIS.
  ativosDeDividaAtiva      DividaAtiva[]               @relation("AtivoDaDividaAtiva")
  roteirosDivAtivaDebito   RoteiroDividaAtiva[]        @relation("DebitoDividaAtiva")
  roteirosDivAtivaCredito  RoteiroDividaAtiva[]        @relation("CreditoDividaAtiva")
  /// back-relations M10 (almoxarifado e provisões) — campos VIRTUAIS.
  estoquesDeClasse         ClasseDeMaterial[]          @relation("EstoqueDaClasse")
  roteirosAlmoxDebito      RoteiroAlmoxarifado[]       @relation("DebitoAlmoxarifado")
  roteirosAlmoxCredito     RoteiroAlmoxarifado[]       @relation("CreditoAlmoxarifado")

  /// M33 (V6.1) — back-relations VIRTUAIS: as duas contas patrimoniais que o grupo de empenho da
  /// folha declara para a sua liquidação (VPD de pessoal e pessoal a pagar).
  variacoesDeGrupoDaFolha  GrupoDeEmpenhoDaFolha[]     @relation("VariacaoDeGrupoDaFolha")
  obrigacoesDeGrupoDaFolha GrupoDeEmpenhoDaFolha[]     @relation("ObrigacaoDeGrupoDaFolha")
  passivosDeProvisao       ProvisaoMatematica[]        @relation("PassivoDaProvisao")
  roteirosProvisaoDebito   RoteiroProvisao[]           @relation("DebitoProvisao")
  roteirosProvisaoCredito  RoteiroProvisao[]           @relation("CreditoProvisao")
  // back-relations M04 (TR 5.87) — o reconhecimento pelo fato gerador. Campos VIRTUAIS.
  roteirosReconhecCredito  RoteiroReconhecimento[]     @relation("CreditoAReceberReconhecimento")
  roteirosReconhecVpa      RoteiroReconhecimento[]     @relation("VpaReconhecimento")
  roteirosReconhecVpd      RoteiroReconhecimento[]     @relation("VpdReconhecimento")

  @@index([contaPaiId])
  @@index([analitica])
  /// back-relations ENT05 (ITEM 3 — o repontamento) — VIRTUAIS.
  migracoesComoOrigem  MigracaoDeConta[] @relation("MigracaoOrigem")
  migracoesComoDestino MigracaoDeConta[] @relation("MigracaoDestino")
  /// back-relations V3 (4.5) — as versões de roteiro que apontam para esta conta. VIRTUAIS.
  versoesComoDebito  VersaoDeRoteiro[] @relation("DebitoDaVersao")
  versoesComoCredito VersaoDeRoteiro[] @relation("CreditoDaVersao")
}

// ----------------------------------------------------------------------------
// Lançamento contábil — APPEND-ONLY. Nunca UPDATE, nunca DELETE.
// `numeroControle` agrupa o fato contábil (TR pág. 2, item 2.5) e NÃO é único:
// um mesmo fato pode gerar lançamentos em subsistemas distintos.
// "Está estornado?" NÃO é um campo — é derivado de `estornos.length > 0`.
// ----------------------------------------------------------------------------

/// A NATUREZA do lançamento. Nasceu com a apuração do resultado (M08).
///
/// Um lançamento de ENCERRAMENTO não é um FATO NOVO: ele apenas TRANSFERE o
/// resultado das contas de variação (classes 3/4) para o Patrimônio Líquido. Ele
/// entra no Balanço (o saldo é o saldo), mas NÃO pode entrar na DVP — senão a
/// demonstração contaria a mesma receita duas vezes: uma quando ela aconteceu, e
/// outra quando ela foi transferida.
enum NaturezaLancamento {
  NORMAL
  ENCERRAMENTO
}

/// ⚠️ NÃO EXISTE `competencia` AQUI — E A AUSÊNCIA É UMA DECISÃO, COM HISTÓRIA.
///
/// A coluna existiu, e era uma SEGUNDA COMPETÊNCIA DORMENTE: todo estorno herdava a do
/// original (`competenciaEstorno ?? original.competencia`), ela DIVERGIA da `dataTransacao` no
/// banco de verdade — e NINGUÉM a lia. Nenhum relatório, nenhum corte, nenhum filtro: MSC, DVP,
/// balanços e o travamento cortam todos por `dataTransacao`.
///
/// Uma coluna que só se escreve, e que diverge, é uma MINA ARMADA para o primeiro leitor
/// ingênuo: o dia em que alguém escrevesse `where: { competencia: ... }` acreditando nela, o
/// estorno de janeiro apareceria em dezembro — e o relatório fecharia, plausível e errado.
///
/// A competência contábil de VERDADE (a do fato gerador, NBC TSP) renasce no 5.87/5.88: na
/// entidade DONA do fato, com LEITOR NOMEADO. Ver `MODULO.md` (§ a competência) e a migração
/// `*_remove_competencia_lancamento`.
model LancamentoContabil {
  id             String               @id @default(cuid())
  numeroControle String
  dataTransacao  DateTime
  historico      String

  /// NULO lê-se NORMAL. Nullable de propósito: a coluna entra ADITIVA, sem
  /// backfill e sem os 3 passos. Todo lançamento que já existe é normal — e o
  /// código trata o nulo como NORMAL (fail-safe na leitura).
  natureza NaturezaLancamento?
  origemTipo     String
  origemId       String?
  estornoDeId    String?
  estornoDe      LancamentoContabil?  @relation("Estorno", fields: [estornoDeId], references: [id])
  estornos       LancamentoContabil[] @relation("Estorno")
  partidas       PartidaContabil[]
  criadoEm       DateTime             @default(now())
  criadoPor      String

  // --- back-relations M04 / M05 ----------------------------------------------
  // Campos VIRTUAIS: não geram coluna. As FKs vivem nas tabelas filhas.
  // O Prisma exige o lado inverso da relação; nada no M01 muda no banco.
  receita          ReceitaArrecadada?
  empenho          Empenho?
  liquidacao       Liquidacao?
  pagamento        Pagamento?
  movimentosRestos MovimentoRestosAPagar[]
  movimentosExtra  MovimentoExtraorcamentario[]
  movimentosPatrimoniais MovimentoPatrimonial[]
  movimentosDivida       MovimentoDivida[]
  movimentosDividaAtiva  MovimentoDividaAtiva[]  @relation("LancamentoDividaAtiva")
  movimentosAlmoxarifado MovimentoAlmoxarifado[] @relation("LancamentoAlmoxarifado")
  movimentosProvisao     MovimentoProvisao[]     @relation("LancamentoProvisao")
  // ── ENT03b ──
  movimentosConvenio     MovimentoConvenio[]
  movimentosPrecatorio   MovimentoPrecatorio[]
  movimentosConsorcio    MovimentoConsorcio[]
  transferenciaEntreContas TransferenciaEntreContas?
  /// M09 — a contrapartida do movimento bancário. Campo VIRTUAL, 1-1.
  movimentoBancario        MovimentoBancario?
  // M04 (TR 5.87) — o reconhecimento e o cancelamento (VPD) da receita.
  reconhecimento         ReceitaReconhecida?
  cancelamentoReconhec   CancelamentoDeReconhecimento?
  // ---------------------------------------------------------------------------

  @@index([numeroControle])
  @@index([dataTransacao])
  @@index([origemTipo, origemId])
  // NÃO usar @unique em estornoDeId — quebraria estornos[]. Unicidade do
  // estorno no banco: prisma/sql/uq_estorno_unico.sql (aplicar pós-migrate).
  // O SQL NÃO pode morar em prisma/migrations/ — toda subpasta de lá é lida
  // como migration e o Prisma exige migration.sql dentro (erro P3015).
  @@index([estornoDeId])
  /// back-relation ENT05 (ITEM 3) — VIRTUAL.
  migracoesDeConta MigracaoDeConta[] @relation("LancamentoDeMigracao")
}

// ----------------------------------------------------------------------------
// Partida (perna) — uma conta, um tipo, um valor. Também append-only.
// Dimensões (fonte de recurso, categoria econômica, ficha, centro de custo)
// entram como colunas ADITIVAS em M02/M05 — não mexer nas existentes.
// ----------------------------------------------------------------------------

model PartidaContabil {
  id           String             @id @default(cuid())
  lancamentoId String
  lancamento   LancamentoContabil @relation(fields: [lancamentoId], references: [id])
  contaId      String
  conta        ContaPcasp         @relation(fields: [contaId], references: [id])
  tipo         TipoPartida
  subsistema   Subsistema
  valor        Decimal            @db.Decimal(18, 2)

  // --- ADITIVO M02 (planejamento) -------------------------------------------
  // Dimensão orçamentária da partida. NULLABLE de propósito: partida
  // patrimonial/controle não tem ficha, e o M01 continua válido sem ela.
  // Isto é tudo que o M02 acrescenta ao M01 — nenhuma coluna existente muda.
  fichaId      String?
  ficha        FichaOrcamentaria? @relation(fields: [fichaId], references: [id])
  // --------------------------------------------------------------------------

  @@index([lancamentoId])
  @@index([contaId])
  @@index([contaId, subsistema])
  @@index([fichaId])
}

// ----------------------------------------------------------------------------
// MigracaoDeConta — ENT05, ITEM 3: o REPONTAMENTO de conta como FATO.
//
// ═══ ⚠️ SALDO QUE MUDA DE CONTA SEM MOVIMENTO QUE O EXPLIQUE É RAZÃO REESCRITO ═══
// O censo do ENT04 achou quatro contas de produção apontando para códigos que, no PCASP
// oficial, significam outra coisa: a conta bancária estava na variante INTRA OFSS, o
// almoxarifado em MERCADORIAS PARA REVENDA, a dívida fundada em PESSOAL A PAGAR e os
// créditos tributários em CLIENTES.
//
// A correção NÃO é um UPDATE no código da conta. Mudar o código deixaria os lançamentos
// já feitos apontando para um conceito diferente do que tinham quando foram feitos — e o
// balancete do exercício anterior mudaria sozinho, sem nada que explicasse por quê.
//
// A correção é um LANÇAMENTO DE MIGRAÇÃO: o saldo sai da conta de origem e entra na de
// destino, com data, motivo e referência. Quem ler o razão vê a migração acontecer.
//
// APPEND-ONLY. Migrar de volta é outra migração, não a remoção desta.
// ----------------------------------------------------------------------------

model MigracaoDeConta {
  id String @id @default(cuid())

  contaOrigemId String
  contaOrigem   ContaPcasp @relation("MigracaoOrigem", fields: [contaOrigemId], references: [id])

  contaDestinoId String
  contaDestino   ContaPcasp @relation("MigracaoDestino", fields: [contaDestinoId], references: [id])

  /// ⚠️ DATA CIVIL do fato. O saldo migrado é o saldo NESTA data — e é ela que separa o
  /// que ficou no exercício anterior do que entrou no novo.
  data DateTime

  /// O saldo que MIGROU, congelado como evidência. Ele é derivável do razão, e é gravado
  /// aqui mesmo assim: é o número que a migração usou, e conferi-lo contra a derivação de
  /// hoje é exatamente como se descobre que alguém lançou algo retroativo depois.
  saldoMigrado Decimal @db.Decimal(18, 2)

  motivo String

  /// O lançamento que EXECUTOU a migração. Nulo só quando o saldo era zero — e aí não há
  /// o que lançar: um lançamento de valor zero polui o razão sem dizer nada.
  lancamentoId String?
  lancamento   LancamentoContabil? @relation("LancamentoDeMigracao", fields: [lancamentoId], references: [id])

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([contaOrigemId])
  @@index([contaDestinoId])
  @@index([data])
}

// ═══════════════════════════════════════════════════════════════════════════════════════
// A NATUREZA DA FONTE, PARA O CONTROLE DA DISPONIBILIDADE (V11 V9.3)
// ═══════════════════════════════════════════════════════════════════════════════════════

/// AS CINCO NATUREZAS EM QUE O PCASP PARTICIONA `7.2.1.1 CONTROLE DA DISPONIBILIDADE DE
/// RECURSOS`. O rol NÃO foi escolhido aqui: ele é a partição do plano oficial, lida do
/// `Pcasp_2025.xlsx` do TCE-PB (sha256 `52ae7c73…`, conferido por `prisma/seed/oficial/
/// procedencia.ts`). Um valor a mais neste enum seria uma conta a mais no plano.
///
///   ORDINARIOS             -> 7.2.1.1.1.00.00 RECURSOS ORDINÁRIOS
///   VINCULADOS             -> 7.2.1.1.2.00.00 RECURSOS VINCULADOS
///   EXTRAORCAMENTARIOS     -> 7.2.1.1.3.00.00 RECURSOS EXTRAORÇAMENTÁRIOS
///   COMPENSACAO_FINANCEIRA -> 7.2.1.1.4.00.00 RECURSOS PARA COMPENSAÇÃO FINANCEIRA
///   OUTROS                 -> 7.2.1.1.9.00.00 OUTROS CONTROLES DA DISPONIBILIDADE DE RECURSOS
enum NaturezaDaFonteDdr {
  ORDINARIOS
  VINCULADOS
  EXTRAORCAMENTARIOS
  COMPENSACAO_FINANCEIRA
  OUTROS
}

/// A DECLARAÇÃO DO ENTE sobre a natureza de UMA fonte — o que destrava a arrecadação.
///
/// ⚠️ POR QUE É ATO DO ENTE, E NÃO DERIVAÇÃO. O plano diz em que conta cada NATUREZA entra;
/// ele não diz de que natureza é a fonte 500 do município. O corpus oficial deste
/// repositório também não: `relacionamento_fonterecursos_co_2026.xlsx` relaciona fonte com
/// CÓDIGO DE ACOMPANHAMENTO, não com natureza, e `FonteRecurso` só guarda código, descrição
/// e os de-paras TCE/STN. Adivinhar a natureza pela descrição ("não vinculados" -> ordinários)
/// é casar com a papelada, não com a norma: classificaria FUNDEB como ordinário no dia em que
/// alguém redigisse a descrição de outro jeito, e o erro sairia no RGF Anexo 5.
///
/// ⚠️ FAIL-CLOSED, E O SEED NÃO A SEMEIA. Fonte sem natureza declarada faz a arrecadação
/// RECUSAR nomeando a fonte e o caminho da tela. Instalação nova que ainda não classificou
/// suas fontes não arrecada — e é o comportamento certo: o contrário seria escolher uma
/// conta por conveniência para o percurso passar.
///
/// ⚠️ APPEND-ONLY E VERSIONADA, pela mesma razão do `PoliticaDaDotacaoAdicional` e pela mesma
/// que faz a arrecadação CARIMBAR a entidade titular: o lançamento de ontem foi escriturado
/// sob a classificação de ontem, e reclassificar a fonte hoje NÃO reescreve a conta de
/// classe 7 que ele já gravou. A vigente é a de maior versão.
model DeParaFonteNaturezaDdr {
  id String @id @default(cuid())

  /// O `codigo` de 3 dígitos da fonte (o mesmo do `FonteRecurso.codigo`). Sem relação
  /// declarada, como nos de-paras irmãos (`DeParaFonteClasseEducacao`, `…Asps`, `…Alienacao`):
  /// eles classificam a fonte, não a possuem.
  fonteCodigo String @db.VarChar(3)

  natureza NaturezaDaFonteDdr

  /// Por que ESTA natureza. Obrigatório — é o que a prestação de contas lê, e é o que
  /// separa uma classificação fundamentada de um palpite.
  fundamento String

  versao    Int
  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([fonteCodigo, versao])
  @@index([fonteCodigo, versao])
  @@index([natureza])
}
