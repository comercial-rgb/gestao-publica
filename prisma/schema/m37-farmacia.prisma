// ============================================================================
// V27 — M37 FARMÁCIA PÚBLICA: o que o SAGRES pede (leiaute 2026 v1.1, §4.56 Farmacia e §4.57 EstoqueFarmacia).
//
// A farmácia sob responsabilidade da unidade gestora, com o responsável técnico, e o estoque de medicamentos do
// mês. Não é a assistência farmacêutica do termo de referência (dispensação, lote, validade, BNAFAR): é a base
// que a prestação de contas exige.
//
// ⚠️ O ESTOQUE DO MÊS É UM INFORME. A posição vem do sistema da farmácia (arquivo) ou é digitada; um informe novo
// para o mesmo mês SUBSTITUI o anterior na remessa, e o anterior fica na história. Nada se apaga.
// ============================================================================

model FarmaciaPublica {
  /// V39-R2 (R2-030/031) — o depósito, as dispensações e os ajustes da farmácia (m37-dispensacao.prisma). VIRTUAL.
  deposito     DepositoDaFarmacia?        @relation("DepositoDaFarmacia")
  dispensacoes DispensacaoDeMedicamento[] @relation("DispensacoesDaFarmacia")
  trocasDeDeposito TrocaDoDepositoDaFarmacia[] @relation("TrocasDoDepositoDaFarmacia")
  ajustes      AjusteDaFarmacia[]         @relation("AjustesDaFarmacia")
  id String @id @default(cuid())

  ugId String
  ug   UnidadeGestora @relation("FarmaciasDaUg", fields: [ugId], references: [id])

  /// Código da farmácia, até 7 dígitos.
  codigo String @db.VarChar(7)

  versoes  VersaoDaFarmacia[]
  informes InformeDeEstoqueDaFarmacia[]
  /// V39-R3 (R3-022) — de que mês em diante a posição vem dos movimentos.
  modosDoInforme ModoDoInformeAdotado[]

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([ugId, codigo])
}

model VersaoDaFarmacia {
  id String @id @default(cuid())

  farmaciaId String
  farmacia   FarmaciaPublica @relation(fields: [farmaciaId], references: [id])
  versao     Int

  descricao       String  @db.VarChar(60)
  endereco        String  @db.VarChar(120)
  nomeResponsavel String  @db.VarChar(60)
  cpfResponsavel  String  @db.VarChar(11)
  crfResponsavel  String  @db.VarChar(10)
  /// Falso encerra a farmácia a partir de `vigenteDesde`.
  ativa           Boolean

  vigenteDesde DateTime
  fundamento   String

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([farmaciaId, versao])
}

enum OrigemDoInformeDeEstoque {
  DIGITADO
  ARQUIVO
  /// V39-R3 (R3-022) — a posição do mês derivada dos movimentos do depósito da farmácia, não digitada nem importada.
  CALCULADO
}

model InformeDeEstoqueDaFarmacia {
  id String @id @default(cuid())

  farmaciaId String
  farmacia   FarmaciaPublica @relation(fields: [farmaciaId], references: [id])

  ano Int
  mes Int

  origem      OrigemDoInformeDeEstoque
  /// SHA-256 do arquivo importado (nulo no digitado).
  arquivoHash String? @db.VarChar(64)
  fundamento  String

  itens ItemDoInformeDeEstoque[]

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([farmaciaId, ano, mes, criadoEm])
}

model ItemDoInformeDeEstoque {
  id String @id @default(cuid())

  informeId String
  informe   InformeDeEstoqueDaFarmacia @relation(fields: [informeId], references: [id])

  /// Código do produto, de preferência o GTIN; até 14 dígitos.
  codigoProduto String  @db.VarChar(14)
  descricao     String  @db.VarChar(60)
  unidadeMedida String  @db.VarChar(10)
  quantidade    Decimal @db.Decimal(15, 2)

  @@unique([informeId, codigoProduto])
}

/// V39-R3 (R3-022) — DE ONDE VEM A POSIÇÃO MENSAL DA FARMÁCIA.
enum ModoDoInformeDaFarmacia {
  /// Digitada ou importada de arquivo (o sistema da farmácia, o inventário).
  IMPORTADO
  /// Derivada dos movimentos do depósito da farmácia neste sistema.
  CALCULADO
}

/// V39-R3 (R3-022) — O MODO ADOTADO, POR FARMÁCIA, A PARTIR DE UM MÊS. Append-only: mudar é adotar de novo a partir de
/// outro mês. Sem adoção, vale o IMPORTADO (o que já era). A remessa lê UMA fonte por mês, a do modo daquele mês: a
/// posição importada e a calculada nunca se somam, e o informe importado de um mês anterior à adoção continua valendo.
model ModoDoInformeAdotado {
  id String @id @default(cuid())

  farmaciaId String
  farmacia   FarmaciaPublica @relation(fields: [farmaciaId], references: [id], onDelete: Restrict)

  modo     ModoDoInformeDaFarmacia
  desdeAno Int
  desdeMes Int

  fundamento String

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([farmaciaId, desdeAno, desdeMes])
}

/// V39-R3 (R3-022) — O CÓDIGO DO PRODUTO NO INFORME (de preferência o GTIN) E A DESCRIÇÃO, por material, declarados pelo
/// ente. O sistema não infere GTIN do código interno nem do CATMAT. Append-only: vale o mais recente.
model CodigoDoMaterialNoInforme {
  id String @id @default(cuid())

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  codigoProduto String @db.VarChar(14)
  descricao     String @db.VarChar(60)
  fundamento    String

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([materialId, criadoEm])
}
