// ============================================================================
// M07 × M04 — V26: O IR E O ISS RETIDOS PELO PRÓPRIO TESOURO SÃO RECEITA, NÃO CONSIGNAÇÃO.
//
// MCASP 11ª ed., Parte I 3.6.2 (`docs/oficial/stn-sof/mcasp-11-irrf-trechos.txt`): o IR retido na fonte
// sobre o que o ente paga pertence a ele (CF, art. 158, I) e "deverá ser contabilizado como receita
// tributária". O ISS retido pelo município tomador é imposto do próprio município. Desenho adotado pela
// ordem V26 (cadeia A): no pagamento, a parte retida é reconhecida e arrecadada como receita por retenção,
// e o banco sai só pelo líquido. Escolha de desenho fundamentada no manual, não homologação do TCE-PB.
//
// APPEND-ONLY em tudo. Sem updatedAt, sem deletedAt.
// ============================================================================

/// A DECISÃO DO ENTE: este fato de retenção é receita própria do Tesouro, com esta natureza, esta
/// destinação e estas contas. Vigente na data do pagamento = a de maior `vigenteDesde` até ela (empate:
/// a gravada por último). Nenhuma conta, natureza ou fonte vem do código: sem decisão vigente, o
/// pagamento que retém o tributo é RECUSADO nomeando o cadastro.
model ClassificacaoDaRetencaoPropria {
  id String @id @default(cuid())

  /// O FATO, não o documento do credor: IRRF_FOLHA (IR do servidor, rendimento do trabalho),
  /// IRRF_FORNECEDOR_PJ (IR de pessoa jurídica na aquisição de bens e serviços, IN RFB 1.234/2012),
  /// ISS (ISS do prestador, devido ao próprio município). CHECK em `prisma/sql/`.
  fato String @db.VarChar(30)

  /// O tipo de consignação em que este tributo era (e no legado ainda está) retido. É por ele que o
  /// servidor reconhece, no recolhimento, um saldo que é do próprio Tesouro.
  tipoConsignacaoId String
  tipoConsignacao   TipoConsignacao @relation("RetencaoPropriaDoTipo", fields: [tipoConsignacaoId], references: [id])

  /// A natureza da receita (principal) do ementário do ente.
  naturezaReceitaId String
  naturezaReceita   NaturezaReceita @relation("NaturezaDaRetencaoPropria", fields: [naturezaReceitaId], references: [id])

  /// A DESTINAÇÃO da receita do tributo — nunca herdada da fonte da despesa paga.
  fonteId String
  fonte   FonteRecurso @relation("FonteDaRetencaoPropria", fields: [fonteId], references: [id])

  /// Conta analítica do crédito tributário a receber (família 1.1.2.1).
  contaCreditoId String
  contaCredito   ContaPcasp @relation("CreditoDaRetencaoPropria", fields: [contaCreditoId], references: [id])

  /// Conta analítica da VPA do imposto (família 4.1.1.2 para o IR, 4.1.1.3 para o ISS).
  contaVpaId String
  contaVpa   ContaPcasp @relation("VpaDaRetencaoPropria", fields: [contaVpaId], references: [id])

  /// A entidade contábil do Tesouro titular da receita. Nula = ente sem entidades declaradas. O
  /// pagamento só trata a retenção como receita quando a conta que paga é desse mesmo titular.
  entidadeTitularId String?
  entidadeTitular   EntidadeContabil? @relation("TesouroDaRetencaoPropria", fields: [entidadeTitularId], references: [id])

  vigenteDesde DateTime @db.Date
  /// De onde vem a decisão (ato, orientação do contador, ementário). Pelo menos 10 caracteres.
  fundamento   String

  criadoEm  DateTime @default(now())
  criadoPor String

  retencoes    RetencaoPropriaDoPagamento[]
  apropriacoes ApropriacaoDaConsignacaoPropria[] @relation("ApropriacaoPelaClassificacao")

  @@index([fato, vigenteDesde])
}

/// UMA RETENÇÃO PRÓPRIA NUM PAGAMENTO: o elo pagamento → retenção → receita. Nasce na MESMA transação
/// do pagamento e da guia de receita; o estorno é linha nova (`estornoDeId`) na mesma transação da
/// anulação do pagamento e da anulação da guia.
model RetencaoPropriaDoPagamento {
  id String @id @default(cuid())

  /// O pagamento ORIGINAL (também na linha do estorno: é dele que a retenção veio).
  pagamentoId String
  pagamento   Pagamento @relation("RetencoesPropriasDoPagamento", fields: [pagamentoId], references: [id])

  classificacaoId String
  classificacao   ClassificacaoDaRetencaoPropria @relation(fields: [classificacaoId], references: [id])

  fato  String  @db.VarChar(30)
  valor Decimal @db.Decimal(18, 2)

  /// A MEMÓRIA DO CÁLCULO quando a retenção foi calculada no pagamento de fornecedor (IR de PJ, ISS): base,
  /// alíquota, fundamento e entradas — o que `CalculoDaRetencao` guarda para a consignação, cuja trava exige um
  /// movimento extraorçamentário. Nula no IR da folha (a memória é o contracheque).
  base       Decimal? @db.Decimal(15, 2)
  aliquota   Decimal? @db.Decimal(9, 6)
  fundamento String?
  entrada    Json?

  /// A guia de receita por retenção (ARRECADACAO na retenção; ANULACAO no estorno).
  receitaArrecadadaId String            @unique
  receitaArrecadada   ReceitaArrecadada @relation("ReceitaDaRetencaoPropria", fields: [receitaArrecadadaId], references: [id])

  /// Folha: o grupo de empenho da folha cujo IR foi retido neste pagamento.
  grupoDaFolhaId String?
  grupoDaFolha   GrupoDeEmpenhoDaFolha? @relation("IrDaFolhaRetidoNoPagamento", fields: [grupoDaFolhaId], references: [id])

  contrachequesDaFolha IrDoContrachequeRetido[] @relation("ContrachequesDaRetencao")

  estornoDeId String?                      @unique
  estornoDe   RetencaoPropriaDoPagamento?  @relation("EstornoDaRetencaoPropria", fields: [estornoDeId], references: [id])
  estornos    RetencaoPropriaDoPagamento[] @relation("EstornoDaRetencaoPropria")

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([pagamentoId])
  @@index([grupoDaFolhaId])
}

/// V26 — A REGULARIZAÇÃO DO LEGADO: uma retenção antiga de IR/ISS do próprio Tesouro, que nasceu como consignação,
/// é baixada contra a receita. Identificada (uma por retenção de origem: a unicidade é a idempotência) e sem apagar
/// nada: a retenção original continua lá, e o movimento de apropriação e a guia apontam para ela.
///
/// Dois caminhos, conforme a receita já tenha ou não sido reconhecida:
/// - sem reconhecimento: a guia faz D consignação × C VPA (mais a receita realizada e o controle);
/// - com reconhecimento identificado: D consignação × C crédito tributário, e o vínculo baixa o reconhecimento
///   (a VPA já nasceu nele e não se repete).
model ApropriacaoDaConsignacaoPropria {
  id String @id @default(cuid())

  /// O INGRESSO de retenção (de pagamento) que estava na consignação.
  ingressoId String                     @unique
  ingresso   MovimentoExtraorcamentario @relation("IngressoApropriado", fields: [ingressoId], references: [id])

  /// O movimento APROPRIACAO_COMO_RECEITA que baixa o saldo do consignatário.
  movimentoId String                     @unique
  movimento   MovimentoExtraorcamentario @relation("MovimentoDeApropriacao", fields: [movimentoId], references: [id])

  classificacaoId String
  classificacao   ClassificacaoDaRetencaoPropria @relation("ApropriacaoPelaClassificacao", fields: [classificacaoId], references: [id])

  receitaArrecadadaId String            @unique
  receitaArrecadada   ReceitaArrecadada @relation("ReceitaDaApropriacao", fields: [receitaArrecadadaId], references: [id])

  /// O reconhecimento que a guia baixou, quando a receita já tinha sido reconhecida.
  reconhecimentoId String?

  valor  Decimal @db.Decimal(18, 2)
  motivo String

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// V26 — O IR DE UM CONTRACHEQUE, RETIDO NUM PAGAMENTO DA FOLHA. Calcular ou fechar a folha não comprova pagamento: o
/// IR do servidor vira receita no pagamento que cobre aquele contracheque, e este elo diz qual. Vivo = a retenção
/// própria dele não foi estornada; anulado o pagamento, o IR do contracheque volta a ser retido no próximo.
model IrDoContrachequeRetido {
  id String @id @default(cuid())

  contrachequeId String
  contracheque   Contracheque @relation("IrDoContrachequeRetido", fields: [contrachequeId], references: [id])

  retencaoPropriaId String
  retencaoPropria   RetencaoPropriaDoPagamento @relation("ContrachequesDaRetencao", fields: [retencaoPropriaId], references: [id])

  valor Decimal @db.Decimal(18, 2)

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([contrachequeId, retencaoPropriaId])
  @@index([retencaoPropriaId])
}
