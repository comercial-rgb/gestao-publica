// ============================================================================
// V39-R2 (R2-030, R2-031) — A OPERAÇÃO DA FARMÁCIA PÚBLICA: o depósito dela, a dispensação ao usuário e a perda ou
// sobra apurada. O estoque É o do almoxarifado (M10): a farmácia aponta um depósito, e cada dispensação, perda ou
// sobra é um movimento físico desse depósito (com o lançamento do consumo ou do ajuste). Nada de saldo paralelo.
//
// DADO DE SAÚDE: a dispensação guarda só o identificador que a unidade usa para o usuário (cartão ou prontuário),
// a receita e o prescritor — nenhum nome, endereço ou diagnóstico. A lista com o identificador só aparece para quem
// tem a ação de dispensar. Append-only: o runtime só insere.
// ============================================================================

/// O PRIMEIRO depósito do almoxarifado que é o estoque da farmácia. A troca (V39-R3) não altera esta linha: é um fato
/// novo em `TrocaDoDepositoDaFarmacia`, com vigência. O depósito de um fato passado é o do movimento físico dele.
model DepositoDaFarmacia {
  id String @id @default(cuid())

  farmaciaId String @unique
  farmacia   FarmaciaPublica @relation("DepositoDaFarmacia", fields: [farmaciaId], references: [id], onDelete: Restrict)
  depositoId String @unique
  deposito   Deposito @relation("FarmaciaDoDeposito", fields: [depositoId], references: [id], onDelete: Restrict)

  fundamento String

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// UMA DISPENSAÇÃO: a entrega de um ou mais medicamentos a um usuário, numerada por farmácia.
model DispensacaoDeMedicamento {
  id String @id @default(cuid())

  farmaciaId String
  farmacia   FarmaciaPublica @relation("DispensacoesDaFarmacia", fields: [farmaciaId], references: [id], onDelete: Restrict)
  numero     Int

  data DateTime
  /// O identificador do usuário na unidade (cartão ou prontuário), como a unidade o usa. Sem nome.
  identificacaoDoUsuario String @db.VarChar(40)
  /// A receita (número e data, ou o documento que a unidade usa).
  receita    String @db.VarChar(120)
  /// Quem prescreveu, com o registro no conselho.
  prescritor String @db.VarChar(120)

  itens ItemDaDispensacao[]

  criadoEm  DateTime @default(now())
  /// Quem dispensou.
  criadoPor String

  @@unique([farmaciaId, numero])
  @@index([farmaciaId, data])
}

model ItemDaDispensacao {
  id String @id @default(cuid())

  dispensacaoId String
  dispensacao   DispensacaoDeMedicamento @relation(fields: [dispensacaoId], references: [id], onDelete: Restrict)

  materialId String
  material   Material @relation("ItensDispensados", fields: [materialId], references: [id], onDelete: Restrict)
  loteId     String
  lote       LoteDeMaterial @relation("ItensDispensadosDoLote", fields: [loteId], references: [id], onDelete: Restrict)
  quantidade Decimal @db.Decimal(18, 4)

  /// A saída do depósito que esta entrega gerou.
  movimentoFisicoId String @unique
  movimentoFisico   MovimentoFisicoDeEstoque @relation("SaidaDaDispensacao", fields: [movimentoFisicoId], references: [id], onDelete: Restrict)

  /// V39-R3 (R3-009) — a correção deste item (cancelamento do registro ou devolução), se houver. Uma só.
  correcao CorrecaoDoItemDaDispensacao?

  @@index([dispensacaoId])
  @@index([materialId])
  @@index([loteId])
}

enum SentidoDoAjusteDaFarmacia {
  PERDA
  SOBRA
}

/// A PERDA (vencimento, avaria, extravio) ou a SOBRA apurada na farmácia, com o motivo e, na perda, o destino dado ao
/// produto. Pode citar o inventário em que foi apurada.
model AjusteDaFarmacia {
  id String @id @default(cuid())

  farmaciaId String
  farmacia   FarmaciaPublica @relation("AjustesDaFarmacia", fields: [farmaciaId], references: [id], onDelete: Restrict)

  sentido    SentidoDoAjusteDaFarmacia
  materialId String
  material   Material @relation("AjustesDaFarmacia", fields: [materialId], references: [id], onDelete: Restrict)
  loteId     String?
  lote       LoteDeMaterial? @relation("AjustesDaFarmaciaNoLote", fields: [loteId], references: [id], onDelete: Restrict)
  quantidade Decimal @db.Decimal(18, 4)
  data       DateTime

  motivo  String
  /// Na perda, para onde foi o produto (descarte por empresa, devolução ao fornecedor, boletim de ocorrência...).
  destino String?

  inventarioId String?
  inventario   InventarioDeEstoque? @relation("AjustesDaFarmaciaNoInventario", fields: [inventarioId], references: [id], onDelete: Restrict)

  movimentoFisicoId String @unique
  movimentoFisico   MovimentoFisicoDeEstoque @relation("MovimentoDoAjusteDaFarmacia", fields: [movimentoFisicoId], references: [id], onDelete: Restrict)

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([farmaciaId, data])
}

// ============================================================================
// V39-R3 (R3-009) — A CORREÇÃO AUDITÁVEL DA DISPENSAÇÃO. O original fica como está (append-only); a correção é um fato
// novo por item, e o banco impede a segunda (itemId único).
//   CANCELAMENTO_DO_REGISTRO — a dispensação foi registrada por engano (a entrega não aconteceu): todos os itens voltam
//     ao estoque (estorno físico e do consumo, ao custo da saída). Feito por outra pessoa, não por quem dispensou.
//   DEVOLUCAO — o usuário devolveu o medicamento. Quem recebe confere: APTO_AO_REUSO volta ao estoque disponível (lote
//     dentro da validade); INAPTO não volta (o consumo fica) e diz o destino dado ao produto.
// ============================================================================

enum TipoDaCorrecaoDaDispensacao {
  CANCELAMENTO_DO_REGISTRO
  DEVOLUCAO
}

enum CondicaoDaDevolucao {
  APTO_AO_REUSO
  INAPTO
}

model CorrecaoDoItemDaDispensacao {
  id String @id @default(cuid())

  itemId String            @unique
  item   ItemDaDispensacao @relation(fields: [itemId], references: [id], onDelete: Restrict)

  tipo     TipoDaCorrecaoDaDispensacao
  /// Só na devolução: a conferência do produto devolvido.
  condicao CondicaoDaDevolucao?
  data     DateTime
  motivo   String
  /// Na devolução, quem conferiu o produto (nome e registro).
  conferidoPor String?
  /// Na devolução inapta, para onde foi o produto.
  destino      String?

  /// O estorno físico (cancelamento e devolução apta). Nulo na devolução inapta: nada volta ao estoque.
  movimentoFisicoId String?                   @unique
  movimentoFisico   MovimentoFisicoDeEstoque? @relation("EstornoDoItemDaDispensacao", fields: [movimentoFisicoId], references: [id], onDelete: Restrict)

  /// Agrupa as correções de um mesmo ato (o cancelamento corrige todos os itens de uma vez).
  operacaoId String

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([operacaoId])
}

// ============================================================================
// V39-R3 (R3-010) — A TROCA DO DEPÓSITO DA FARMÁCIA, com vigência. A farmácia passa a usar o depósito novo a partir do
// dia dito; o estoque NÃO se transfere pela troca (o que ficou no depósito anterior continua lá, e sai por
// transferência do almoxarifado, que é ato próprio). Os fatos passados continuam apontando o depósito usado neles (o do
// movimento físico). Recusada com inventário aberto no depósito anterior ou com fato da farmácia depois da vigência.
// ============================================================================

model TrocaDoDepositoDaFarmacia {
  id String @id @default(cuid())

  farmaciaId String
  farmacia   FarmaciaPublica @relation("TrocasDoDepositoDaFarmacia", fields: [farmaciaId], references: [id], onDelete: Restrict)

  depositoAnteriorId String
  depositoAnterior   Deposito @relation("DepositoAnteriorDaTroca", fields: [depositoAnteriorId], references: [id], onDelete: Restrict)
  depositoNovoId     String
  depositoNovo       Deposito @relation("DepositoNovoDaTroca", fields: [depositoNovoId], references: [id], onDelete: Restrict)

  /// O primeiro dia em que a farmácia opera com o depósito novo.
  vigenteDesde DateTime
  fundamento   String

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([farmaciaId, vigenteDesde])
  @@index([depositoNovoId])
}
