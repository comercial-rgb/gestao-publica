// ============================================================================
// M04 — receita: execução da receita orçamentária (arrecadação).
//
// PRIMEIRO consumidor real do ledger (M01) + classificação (M02). Toda
// arrecadação vira um LancamentoContabil balanceado, append-only.
//
// REGRA DE OURO: dinheiro é Decimal @db.Decimal(18,2). Nunca Float.
// APPEND-ONLY: ReceitaArrecadada nunca sofre UPDATE/DELETE — sem updatedAt,
// sem deletedAt. Anulação = registro NOVO que referencia o original.
// ============================================================================

enum TipoLancamentoReceita {
  ARRECADACAO
  ANULACAO
  RETIFICACAO
}

/// DE-PARA tipo conceitual <-> código literal do SAGRES, mesmo padrão de
/// `TipoReceitaSagres` (M02): a `ReceitaArrecadada` guarda o ENUM, não uma FK.
/// A tradução é um join feito só na exportação, para que uma renumeração do TCE
/// seja um UPDATE de 3 linhas aqui, e não migração de dados em toda a base.
model TipoLancamentoReceitaSagres {
  id           String                @id @default(cuid())
  tipoInterno  TipoLancamentoReceita @unique
  /// Valor LITERAL do SAGRES (tabela ReceitaOrcamentaria).
  /// PENDENTE DE DADO — ver MODULO.md. A estrutura está fechada.
  codigoSagres String                @unique
  descricao    String
}

// ----------------------------------------------------------------------------
// Receita arrecadada — APPEND-ONLY.
// "Foi anulada?" é DERIVADO da relação `estornos` (não existe campo mutável),
// exatamente como no LancamentoContabil do M01.
// ----------------------------------------------------------------------------

model ReceitaArrecadada {
  id        String @id @default(cuid())
  exercicio Int

  naturezaReceitaId String
  naturezaReceita   NaturezaReceita       @relation(fields: [naturezaReceitaId], references: [id])
  fonteId           String
  fonte             FonteRecurso          @relation(fields: [fonteId], references: [id])
  coId              String?
  co                CodigoAcompanhamento? @relation(fields: [coId], references: [id])
  exercicioFonte    Int                   @default(1)

  tipo            TipoLancamentoReceita
  valor           Decimal               @db.Decimal(18, 2)
  dataArrecadacao DateTime
  /// Nº da receita/guia (SAGRES ReceitaOrcamentaria).
  numeroReceita   String

  /// V6 P1.2 — A CONTA BANCÁRIA que recebeu o dinheiro. Obrigatória para a guia registrada pela
  /// tela (a perna de disponibilidade do roteiro é a conta contábil DESTA conta — coerência na
  /// transação). Nula no legado e nas arrecadações compostas que ainda não a declaram; o legado
  /// se resolve por `AtribuicaoDeContaDaArrecadacao`, nunca por UPDATE aqui.
  contaBancariaId String?
  contaBancaria   ContaBancaria? @relation(fields: [contaBancariaId], references: [id])
  atribuicaoDeConta AtribuicaoDeContaDaArrecadacao?

  /// A ENTIDADE CONTÁBIL TITULAR desta receita — quem tem o direito ao dinheiro que entrou.
  ///
  /// ⚠️ É COLUNA, E A DECLARAÇÃO DO TITULAR DA CONTA NÃO É — e isso não é contradição, é a
  /// diferença entre um FATO e uma DECISÃO VIGENTE. A declaração muda com o tempo (a conta
  /// troca de dono, e trocar de dono é um fato NOVO, não a correção do velho); esta coluna
  /// guarda o que era verdade NO INSTANTE em que o dinheiro entrou. Se a conta mudar de titular
  /// em março, as guias de fevereiro continuam da entidade de fevereiro — resolver por join
  /// reescreveria a história toda vez que alguém declarasse um titular novo.
  ///
  /// ⚠️ É por isso, também, que a ANULAÇÃO **herda** esta coluna da guia original em vez de
  /// re-derivá-la pela conta: o estorno desfaz o fato de fevereiro, não o de março.
  ///
  /// NULLABLE, sem backfill e sem default: o legado e todo caminho que ainda não declara
  /// entidade permanecem explicitamente NÃO ATRIBUÍDOS, e a consulta os mostra em linha
  /// própria. Preencher por rateio, por órgão da despesa ou por suposição inventaria
  /// justamente o número que se quer poder conferir. A retificação é
  /// `AtribuicaoDeEntidadeDaArrecadacao`, nunca UPDATE aqui.
  entidadeTitularId String?
  entidadeTitular   EntidadeContabil? @relation(fields: [entidadeTitularId], references: [id])
  atribuicaoDeEntidade AtribuicaoDeEntidadeDaArrecadacao?

  /// A contabilização desta arrecadação. 1-1: um lançamento por receita.
  lancamentoId String             @unique
  lancamento   LancamentoContabil @relation(fields: [lancamentoId], references: [id])

  /// APPEND-ONLY: a anulação referencia o original. Imutável, setado na criação.
  estornoDeId String?
  estornoDe   ReceitaArrecadada?  @relation("EstornoReceita", fields: [estornoDeId], references: [id])
  estornos    ReceitaArrecadada[] @relation("EstornoReceita")

  /// back-relation M10 (TR 4.64) — campo VIRTUAL, não gera coluna. É por aqui que
  /// a operação de crédito liga o caixa que entrou à dívida que nasceu.
  movimentosDivida MovimentoDivida[]
  /// back-relation M10 (TR 4.63) — o recebimento de dívida ativa é receita.
  recebimentosDividaAtiva MovimentoDividaAtiva[] @relation("RecebimentoDividaAtiva")
  /// ENT03b — a parcela de convênio que esta arrecadação trouxe. Campo VIRTUAL.
  movimentosConvenio      MovimentoConvenio[]

  /// back-relation M10 (TR 4.65) — campo VIRTUAL, não gera coluna.
  movimentosPatrimoniais MovimentoPatrimonial[]

  /// back-relation M04 (TR 5.87) — os reconhecimentos que ESTA guia quitou (N:N com valor).
  vinculosReconhecimento VinculoArrecadacaoReconhecimento[]

  criadoEm  DateTime @default(now())
  criadoPor String
  // SEM updatedAt, SEM deletedAt.

  /// Uma guia não pode ser arrecadada duas vezes. A anulação usa o mesmo
  /// número com outro `tipo`, por isso o tipo entra na chave.
  @@unique([exercicio, numeroReceita, tipo], name: "uq_receita_guia")
  @@index([exercicio, naturezaReceitaId])
  @@index([fonteId])
  @@index([estornoDeId])
  @@index([dataArrecadacao])
  @@index([contaBancariaId])
  /// O índice do LEITOR do recorte por entidade (a consulta agrupa por entidade dentro do
  /// exercício). Índice sem leitor não entra; este nasce com o dele.
  @@index([exercicio, entidadeTitularId])
}
