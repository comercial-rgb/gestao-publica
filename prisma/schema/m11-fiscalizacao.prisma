// ============================================================================
// M11 — O CONTRATO ACOMPANHADO: gestor, fiscal, itens, agenda, ocorrências e medição por itens
// (V7 M2.1 — Lei 14.133/2021, arts. 117 e 140)
//
// ⚠️ NÃO É OUTRO CADASTRO DE CONTRATO. Tudo aqui pendura no `Contrato` do M11; o valor vigente, a
// vigência derivada, o empenhado e o saldo continuam sendo as derivações de `contratos.ts`. O fiscal
// antigo em texto (`Contrato.fiscalNome/fiscalCpf/fiscalDesignacao`) segue como carga histórica
// declarada; a designação que AUTORIZA ato é esta, com pessoa, usuário, ato e vigência.
//
// ⚠️ APPEND-ONLY. Revogar designação, resolver ocorrência e medir são fatos novos; nada aqui recebe
// UPDATE do papel de runtime.
// ============================================================================

enum PapelNoContrato {
  /// Art. 117 — quem gere o contrato: programa a fiscalização e dá o encaminhamento das ocorrências.
  GESTOR
  /// Art. 117 — quem acompanha a execução: registra ocorrência, evidência e mede.
  FISCAL
  /// Art. 140, I, b e II, b — o servidor (ou membro da comissão) designado para o recebimento DEFINITIVO.
  /// Não é o gestor genérico nem a designação da folha: é papel próprio, com ato e vigência.
  RECEBEDOR_DEFINITIVO
}

/// A DESIGNAÇÃO NO CONTRATO — pessoa E usuário conferidos pelo vínculo do M16, ato e vigência.
/// A vigência é DERIVADA (início ≤ dia ≤ fim, sem revogação com efeito até o dia), como a da folha.
model DesignacaoNoContrato {
  id String @id @default(cuid())

  contratoId String
  contrato   Contrato @relation("DesignacoesDoContrato", fields: [contratoId], references: [id])

  papel PapelNoContrato

  pessoaId String
  pessoa   Pessoa @relation("DesignadoNoContrato", fields: [pessoaId], references: [id])

  usuarioId String
  usuario   Usuario @relation("DesignacaoNoContrato", fields: [usuarioId], references: [id])

  /// "Portaria 45/2026" — texto do ente; sem ele o nome é alegação.
  atoDesignacao String

  vigenciaInicio DateTime
  vigenciaFim    DateTime?

  criadoEm  DateTime @default(now())
  criadoPor String

  revogacao         RevogacaoDeDesignacaoNoContrato?
  ordensEmitidas    OrdemDeFiscalizacao[]      @relation("OrdemEmitidaPeloGestor")
  ordensRecebidas   OrdemDeFiscalizacao[]      @relation("OrdemParaOFiscal")
  ocorrencias       OcorrenciaDeFiscalizacao[]
  resolucoes        ResolucaoDeOcorrencia[]
  medicoesPorItens  MedicaoPorItens[]
  // V7 M2 U1 — a ordem de serviço: quem gere, quem fiscaliza, quem emitiu, cancelou ou suspendeu. VIRTUAIS.
  ordensDeServicoGeridas       OrdemDeServicoDoContrato[]   @relation("GestorDaOrdemDeServico")
  ordensDeServicoFiscalizadas  OrdemDeServicoDoContrato[]   @relation("FiscalDaOrdemDeServico")
  emissoesDeOrdemDeServico     EmissaoDaOrdemDeServico[]
  cancelamentosDeSaldoDaOrdem  CancelamentoDeSaldoDaOrdem[]
  movimentosDeExecucaoDaOrdem  MovimentoDeExecucaoDaOrdem[]
  // V7 M2 U2 — medições da ordem, recebimentos e decisões praticados sob esta designação. VIRTUAIS.
  medicoesDaOrdem              MedicaoDaOrdemDeServico[]
  recebimentosProvisorios      RecebimentoProvisorio[]
  recebimentosDefinitivos      RecebimentoDefinitivo[]
  decisoesDeControversia       DecisaoDeControversia[]
  // V7 M2 U7 — estornos de medição da ordem praticados sob esta designação. VIRTUAL.
  estornosDeMedicaoDaOrdem     EstornoDeMedicaoDaOrdem[]    @relation("EstornosDeMedicaoDaOrdem")
  // V9 N4 — estornos de recebimento definitivo praticados sob esta designação. VIRTUAL.
  estornosDeRecebimento        EstornoDeRecebimentoDefinitivo[] @relation("EstornosDeRecebimentoDefinitivo")
  // V7 M2 U8 — reagendamentos, cancelamentos e realizações praticados sob esta designação. VIRTUAIS.
  reagendamentosDeFiscalizacao ReagendamentoDeFiscalizacao[] @relation("ReagendamentosDeFiscalizacao")
  cancelamentosDeFiscalizacao  CancelamentoDeFiscalizacao[]  @relation("CancelamentosDeFiscalizacao")
  realizacoesDeFiscalizacao    RealizacaoDeFiscalizacao[]    @relation("RealizacoesDeFiscalizacao")

  @@index([contratoId, papel])
  @@index([usuarioId])
  @@index([pessoaId])
}

model RevogacaoDeDesignacaoNoContrato {
  id String @id @default(cuid())

  designacaoId String               @unique
  designacao   DesignacaoNoContrato @relation(fields: [designacaoId], references: [id])

  dataEfeito DateTime
  motivo     String

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// UM ITEM (LINHA) DO CONTRATO — quantidade e preço unitário ORIGINAIS. Nunca se reescrevem: a quantidade e o preço
/// vigentes num dia saem das alterações dos aditivos por itens vivos (V7 M2 U5, `AlteracaoDeItemPorAditivo`). Item
/// INCLUÍDO por aditivo grava aqui a quantidade do termo (o CHECK exige > 0), e a leitura das versões o trata como
/// inexistente antes da vigência (e depois de um estorno) pela alteração marcada `inclusao`.
model ItemDoContrato {
  id String @id @default(cuid())

  contratoId String
  contrato   Contrato @relation("ItensDoContrato", fields: [contratoId], references: [id])

  numero        Int
  descricao     String
  unidade       String
  quantidade    Decimal @db.Decimal(18, 4)
  valorUnitario Decimal @db.Decimal(18, 4)

  criadoEm  DateTime @default(now())
  criadoPor String

  medidos ItemMedido[]
  /// V7 M2 U1 — as linhas das ordens de serviço que autorizam este item. VIRTUAL.
  itensDeOrdemDeServico ItemDaOrdemDeServico[]
  /// V7 M2 U5 — as versões do item por aditivo. VIRTUAL.
  alteracoesPorAditivo AlteracaoDeItemPorAditivo[]
  /// V7 M2 U6 — os serviços de planilha de obra vinculados a este item. VIRTUAL.
  vinculosComAPlanilha VinculoDeItemDaPlanilhaAoContrato[] @relation("VinculosComAPlanilha")
  /// V39-R2 (R2-019/020) — o item do resultado (ou da ata) de que este item veio. VIRTUAL.
  origemNoResultado ItemContratadoDoResultado? @relation("OrigemNoResultado")

  @@unique([contratoId, numero])
}

/// O ADITIVO POR ITENS (V7 M2 U5) — o termo que altera quantidade e/ou preço unitário de itens do contrato, ou inclui
/// item, a partir de uma VIGÊNCIA. Não é um segundo cadastro de aditivo: a variação de VALOR dele é um
/// `MovimentoContratual` (acréscimo ou supressão) gravado na MESMA transação pelo mesmo corpo do `registrarAditivo`,
/// e é esse movimento que o valor atualizado, os relatórios e as remessas continuam lendo.
///
/// ⚠️ A VARIAÇÃO É CONFERIDA, NÃO DIGITADA LIVRE: por item, (nova quantidade − medido antes da vigência) × novo unitário
/// − (quantidade anterior − medido antes da vigência) × unitário anterior, em centavos por item. O valor do termo
/// informado precisa ser igual; divergência é recusada com a composição.
/// ⚠️ NADA ANTERIOR SE REESCREVE: ordem já emitida guarda o unitário da emissão; medição de período anterior à vigência
/// guarda o unitário dela; um período que atravessa a vigência de um novo preço é recusado (divide-se a medição).
model AditivoPorItensDoContrato {
  id String @id @default(cuid())

  contratoId String
  contrato   Contrato @relation("AditivosPorItens", fields: [contratoId], references: [id])

  numeroAditivo String
  /// A data da assinatura do termo e o PRIMEIRO DIA em que as novas quantidades/preços valem (dias civis do ente).
  dataAssinatura  DateTime
  vigenciaInicio  DateTime
  /// O dispositivo invocado pelo ente (texto do termo) — o sistema não escolhe fundamento.
  fundamento String
  motivo     String

  /// A variação conferida (positiva: acréscimo; negativa: supressão; zero: só redistribui).
  variacao Decimal @db.Decimal(18, 2)
  movimentoContratualId String?              @unique
  movimentoContratual   MovimentoContratual? @relation("MovimentoDoAditivoPorItens", fields: [movimentoContratualId], references: [id], onDelete: Restrict)

  /// O retrato do termo como registrado (itens antes/depois, composição da variação) e o sha256 dele.
  manifesto Json
  sha256    String @db.VarChar(64)

  criadoEm  DateTime @default(now())
  criadoPor String

  alteracoes AlteracaoDeItemPorAditivo[]
  estorno    EstornoDeAditivoPorItens?

  @@unique([contratoId, numeroAditivo])
  @@index([contratoId])
}

/// A VERSÃO DE UM ITEM: quantidade e unitário ANTERIORES (os vigentes na véspera) e os NOVOS, a partir da vigência do aditivo.
model AlteracaoDeItemPorAditivo {
  id String @id @default(cuid())

  aditivoId String
  aditivo   AditivoPorItensDoContrato @relation(fields: [aditivoId], references: [id])

  itemDoContratoId String
  itemDoContrato   ItemDoContrato @relation(fields: [itemDoContratoId], references: [id])

  quantidadeAnterior    Decimal @db.Decimal(18, 4)
  valorUnitarioAnterior Decimal @db.Decimal(18, 4)
  quantidade            Decimal @db.Decimal(18, 4)
  valorUnitario         Decimal @db.Decimal(18, 4)
  /// Quantidade medida em períodos anteriores à vigência — fica ao preço anterior na composição.
  medidoAntes Decimal @db.Decimal(18, 4)
  variacao    Decimal @db.Decimal(18, 2)
  /// O item nasceu por este aditivo: antes da vigência (e se o aditivo for estornado) ele vale zero.
  inclusao    Boolean @default(false)

  criadoEm DateTime @default(now())

  @@unique([aditivoId, itemDoContratoId])
  @@index([itemDoContratoId])
}

/// O ESTORNO do aditivo por itens — só enquanto nada o usou (ordem, emissão ou medição posterior sobre os itens dele).
/// As versões deixam de valer e o movimento de valor é estornado no mesmo commit.
model EstornoDeAditivoPorItens {
  id String @id @default(cuid())

  aditivoId String                    @unique
  aditivo   AditivoPorItensDoContrato @relation(fields: [aditivoId], references: [id])

  movimentoEstornoId String?              @unique
  movimentoEstorno   MovimentoContratual? @relation("MovimentoDoEstornoDeAditivoPorItens", fields: [movimentoEstornoId], references: [id], onDelete: Restrict)

  data   DateTime
  motivo String

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// A ORDEM (AGENDA) DE FISCALIZAÇÃO — o gestor programa, para um fiscal designado, o quê e quando.
model OrdemDeFiscalizacao {
  id String @id @default(cuid())

  contratoId String
  contrato   Contrato @relation("OrdensDeFiscalizacao", fields: [contratoId], references: [id])

  numero       Int
  dataPrevista DateTime
  objetivo     String
  // V7 M2 U8 — horário, duração e local do compromisso (opcionais: os compromissos anteriores não tinham).
  /// "HH:MM" no relógio do ente.
  horaInicio     String? @db.VarChar(5)
  duracaoMinutos Int?
  local          String?

  gestorDesignacaoId String
  gestorDesignacao   DesignacaoNoContrato @relation("OrdemEmitidaPeloGestor", fields: [gestorDesignacaoId], references: [id])
  fiscalDesignacaoId String
  fiscalDesignacao   DesignacaoNoContrato @relation("OrdemParaOFiscal", fields: [fiscalDesignacaoId], references: [id])

  criadoEm  DateTime @default(now())
  criadoPor String

  ocorrencias OcorrenciaDeFiscalizacao[]
  // V7 M2 U8 — os fatos que mudam a vida do compromisso. VIRTUAIS.
  reagendamentos ReagendamentoDeFiscalizacao[] @relation("ReagendamentosDaOrdem")
  cancelamento   CancelamentoDeFiscalizacao?   @relation("CancelamentoDaOrdem")
  realizacao     RealizacaoDeFiscalizacao?     @relation("RealizacaoDaOrdem")

  @@unique([contratoId, numero])
}

enum TipoDeOcorrencia {
  CONFORMIDADE
  NAO_CONFORMIDADE
  ATRASO
  IMPEDIMENTO
  OUTRO
}

enum EncaminhamentoDaOcorrencia {
  /// Registro, sem providência de outra pessoa.
  NENHUM
  /// Vai ao gestor, que dá a resolução.
  GESTOR
}

/// A OCORRÊNCIA — o que o fiscal viu, na data do fato, com evidências (anexos do M22).
model OcorrenciaDeFiscalizacao {
  id String @id @default(cuid())

  contratoId String
  contrato   Contrato @relation("OcorrenciasDoContrato", fields: [contratoId], references: [id])

  numero Int

  ordemId String?
  ordem   OrdemDeFiscalizacao? @relation(fields: [ordemId], references: [id])

  /// A designação de FISCAL vigente com que foi registrada.
  designacaoId String
  designacao   DesignacaoNoContrato @relation(fields: [designacaoId], references: [id])

  data           DateTime
  tipo           TipoDeOcorrencia
  descricao      String
  encaminhamento EncaminhamentoDaOcorrencia
  // V7 M2 U8 — o tipo configurado pelo ente, na VERSÃO usada, e a gravidade quando a versão a exige.
  versaoDoTipoId String?
  versaoDoTipo   VersaoDoTipoDeOcorrencia? @relation("VersaoDoTipoNaOcorrencia", fields: [versaoDoTipoId], references: [id], onDelete: Restrict)
  gravidade      GravidadeDaOcorrencia?

  criadoEm  DateTime @default(now())
  criadoPor String

  evidencias Anexo[]                @relation("EvidenciaDaOcorrencia")
  resolucao  ResolucaoDeOcorrencia?
  respostas  RespostaDoFormularioDeOcorrencia[] @relation("RespostasDaOcorrencia")

  @@unique([contratoId, numero])
  @@index([ordemId])
}

/// A RESOLUÇÃO — o encaminhamento do gestor, uma por ocorrência.
model ResolucaoDeOcorrencia {
  id String @id @default(cuid())

  ocorrenciaId String                   @unique
  ocorrencia   OcorrenciaDeFiscalizacao @relation(fields: [ocorrenciaId], references: [id])

  designacaoId String
  designacao   DesignacaoNoContrato @relation(fields: [designacaoId], references: [id])

  texto String

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// A MEDIÇÃO POR ITENS — a medição de obra (M11) com as QUANTIDADES por item que a compõem, feita
/// pelo fiscal designado. O `valorMedido` da medição é a soma dos itens (quantidade × unitário).
model MedicaoPorItens {
  id String @id @default(cuid())

  medicaoId String        @unique
  medicao   MedicaoDeObra @relation("ItensDaMedicao", fields: [medicaoId], references: [id])

  designacaoId String
  designacao   DesignacaoNoContrato @relation(fields: [designacaoId], references: [id])

  criadoEm  DateTime @default(now())
  criadoPor String

  itens ItemMedido[]
}

model ItemMedido {
  id String @id @default(cuid())

  medicaoPorItensId String
  medicaoPorItens   MedicaoPorItens @relation(fields: [medicaoPorItensId], references: [id])

  itemId String
  item   ItemDoContrato @relation(fields: [itemId], references: [id])

  quantidade Decimal @db.Decimal(18, 4)
  valor      Decimal @db.Decimal(18, 2)

  @@unique([medicaoPorItensId, itemId])
  @@index([itemId])
}

/// A APROVAÇÃO DA MEDIÇÃO — fato próprio, uma por medição (V7 M2.1). Achado do contrato de runtime: o
/// `aprovarMedicao` gravava por UPDATE em `MedicaoDeObra`, fora do censo de UPDATE do `gestao_app`.
model AprovacaoDeMedicao {
  id String @id @default(cuid())

  medicaoId String        @unique
  medicao   MedicaoDeObra @relation("AprovacaoDaMedicao", fields: [medicaoId], references: [id])

  /// O dia civil da aprovação.
  data DateTime

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// V7 M2 U0.1 — O ADMINISTRADOR DA FISCALIZAÇÃO (5.21.17: "administradores do sistema de Fiscalização de
/// Contratos, estes administradores poderão acessar qualquer contrato"). É DEFINIÇÃO com pessoa, usuário, ato e
/// vigência — não uma ação do perfil: quem tem o poder de DEFINIR (a ação) não ganha o alcance por isso, e o
/// administrador da plataforma só alcança a visão de fiscalização se for definido (fato com autor).
model AdministradorDaFiscalizacao {
  id String @id @default(cuid())

  usuarioId String
  usuario   Usuario @relation("AdministradorDaFiscalizacao", fields: [usuarioId], references: [id])

  pessoaId String
  pessoa   Pessoa  @relation("AdministradorDaFiscalizacao", fields: [pessoaId], references: [id])

  atoDesignacao String

  vigenciaInicio DateTime
  vigenciaFim    DateTime?

  criadoEm  DateTime @default(now())
  criadoPor String

  revogacao RevogacaoDeAdministradorDaFiscalizacao?

  @@index([usuarioId])
  @@index([pessoaId])
}

model RevogacaoDeAdministradorDaFiscalizacao {
  id String @id @default(cuid())

  administradorId String                      @unique
  administrador   AdministradorDaFiscalizacao @relation(fields: [administradorId], references: [id])

  dataEfeito DateTime
  motivo     String

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// V7 M2 U0.2 — O REGIME DE PERÍODO DA MEDIÇÃO. Achado: a medição por itens recusava QUALQUER sobreposição de período
/// na obra (herdada da medição por valor), e o percurso passou a procurar "o dia livre". O TR pede período e
/// quantidades por item, não uma medição por dia. Aqui:
///   · PERIODO_LIVRE (o default, sem configuração) — a identidade da parcela é o SALDO por item (e, na ordem de
///     serviço, o autorizado dela): duas medições distintas no mesmo período passam; repetir a mesma parcela esgota o
///     saldo e é recusado por ele;
///   · PERIODO_INDIVISIVEL — o contrato (ou o regulamento) mede por período fechado: sobreposição recusada, NOMEANDO o
///     fundamento configurado, só naquele contrato.
/// A medição de obra só por valor continua conferindo o período sempre: sem itens, o período é a única identidade dela.
enum RegimeDePeriodoDaMedicao {
  PERIODO_LIVRE
  PERIODO_INDIVISIVEL
}

model RegimeDeMedicaoDoContrato {
  id String @id @default(cuid())

  contratoId String
  contrato   Contrato @relation("RegimesDeMedicao", fields: [contratoId], references: [id])

  regime RegimeDePeriodoDaMedicao

  /// De onde vem o regime: cláusula do contrato, regulamento, termo de referência da contratação.
  fundamento String

  /// Vale para as medições cujo período começa a partir deste dia; a versão anterior continua valendo antes dele.
  vigenciaInicio DateTime

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([contratoId, vigenciaInicio])
}

// ============================================================================
// V7 M2 U1 — A ORDEM DE SERVIÇO DO CONTRATO
//
// ⚠️ NÃO É A ORDEM DE COMPRA. `OrdemDeCompra` (m11-compras) autoriza fornecimento de MATERIAL, sem contrato, com
// saldo por item de material; `OrdemDeFiscalizacao` é a agenda do fiscal. Esta é a autorização de EXECUÇÃO ao
// contratado sobre os ITENS DO CONTRATO — o único objeto que compromete o saldo do item do contrato. Nenhuma das três
// compromete o saldo da outra, e nenhuma é empenho nem ordem de pagamento.
//
// ⚠️ SITUAÇÃO E SALDO SÃO DERIVADOS: rascunho (sem emissão), descartada, emitida, suspensa (último movimento),
// autorizado = quantidade − cancelado, a executar = autorizado − medido.
// ============================================================================

model OrdemDeServicoDoContrato {
  id String @id @default(cuid())

  contratoId String
  contrato   Contrato @relation("OrdensDeServico", fields: [contratoId], references: [id])

  /// Sequencial por contrato, atribuído sob o trinco do contrato na criação do rascunho.
  numero Int
  ano    Int

  finalidade         String
  local              String?
  unidadeSolicitante String?

  /// Período planejado (dias civis do ente).
  inicioPrevisto DateTime
  fimPrevisto    DateTime

  /// O que o recebimento vai exigir (documentos, verificações) — texto do ente, impresso no espelho e nos termos.
  condicoesDeRecebimento String

  gestorDesignacaoId String
  gestorDesignacao   DesignacaoNoContrato @relation("GestorDaOrdemDeServico", fields: [gestorDesignacaoId], references: [id])
  fiscalDesignacaoId String
  fiscalDesignacao   DesignacaoNoContrato @relation("FiscalDaOrdemDeServico", fields: [fiscalDesignacaoId], references: [id])

  /// O empenho do contrato que vai suportar a liquidação — opcional; conferido (mesmo contrato, não anulado).
  /// Emitir a ordem NÃO empenha nem reserva: o empenho é ato do M05.
  empenhoId String?
  empenho   Empenho? @relation("EmpenhoDaOrdemDeServico", fields: [empenhoId], references: [id], onDelete: Restrict)

  criadoEm  DateTime @default(now())
  criadoPor String

  itens         ItemDaOrdemDeServico[]
  emissao       EmissaoDaOrdemDeServico?
  descarte      DescarteDaOrdemDeServico?
  cancelamentos CancelamentoDeSaldoDaOrdem[]
  movimentos    MovimentoDeExecucaoDaOrdem[]
  medicoes      MedicaoDaOrdemDeServico[]

  @@unique([contratoId, numero])
  @@index([empenhoId])
}

model ItemDaOrdemDeServico {
  id String @id @default(cuid())

  ordemId String
  ordem   OrdemDeServicoDoContrato @relation(fields: [ordemId], references: [id])

  itemDoContratoId String
  itemDoContrato   ItemDoContrato @relation(fields: [itemDoContratoId], references: [id])

  quantidade Decimal @db.Decimal(18, 4)
  /// COPIADO do item do contrato na criação — nunca informado pela tela. Alteração posterior do contrato não
  /// reescreve a ordem (o aditivo por item, quando existir, versiona o preço).
  valorUnitario Decimal @db.Decimal(18, 4)

  criadoEm  DateTime @default(now())
  criadoPor String

  cancelamentos CancelamentoDeSaldoDaOrdem[]

  /// ⚠️ O NOME É `medidosNaOrdem`, E NÃO `medidos`, DE PROPÓSITO (V9 N4).
  ///
  /// `ItemDoContrato.medidos` é OUTRA relação — `ItemMedido[]`, a medição feita direto no
  /// contrato, sem ordem de serviço. As duas se escreviam `.medidos` e se somavam igual, e só
  /// uma delas tem conferência, controvérsia e glosa.
  ///
  /// O efeito prático disso apareceu ao implementar a liberação de saldo pela glosa: um guard
  /// que procurasse `.medidos.reduce(` não conseguia distinguir os quatro leitores que PRECISAM
  /// descontar a glosa dos quatro que não têm glosa nenhuma para descontar. Com nomes distintos,
  /// a regra vira exata — e é ela que `test/medido-liquido-sem-atalho.test.ts` afirma.
  ///
  /// ⚠️ RENOMEAR UM CAMPO DE RELAÇÃO NÃO É MIGRATION: a chave estrangeira mora do outro lado
  /// (`ItemMedidoNaOrdem.itemDaOrdemId`), e este campo não tem coluna. O banco não muda.
  medidosNaOrdem ItemMedidoNaOrdem[]

  @@unique([ordemId, itemDoContratoId])
  @@index([itemDoContratoId])
}

/// A EMISSÃO — o fato que compromete o saldo dos itens do contrato. Guarda o MANIFESTO canônico (o espelho) e o
/// sha256: a segunda via se imprime dele, não do cadastro vivo.
model EmissaoDaOrdemDeServico {
  id String @id @default(cuid())

  ordemId String                   @unique
  ordem   OrdemDeServicoDoContrato @relation(fields: [ordemId], references: [id])

  data             DateTime
  inicioAutorizado DateTime

  designacaoId String
  designacao   DesignacaoNoContrato @relation(fields: [designacaoId], references: [id])

  manifesto Json
  sha256    String @db.VarChar(64)

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// O DESCARTE de um rascunho que não será emitido — o rascunho continua existindo para o histórico.
model DescarteDaOrdemDeServico {
  id String @id @default(cuid())

  ordemId String                   @unique
  ordem   OrdemDeServicoDoContrato @relation(fields: [ordemId], references: [id])

  motivo String

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// CANCELAR SALDO — só do que ainda não foi executado; o medido continua comprometido.
model CancelamentoDeSaldoDaOrdem {
  id String @id @default(cuid())

  ordemId String
  ordem   OrdemDeServicoDoContrato @relation(fields: [ordemId], references: [id])

  itemDaOrdemId String
  itemDaOrdem   ItemDaOrdemDeServico @relation(fields: [itemDaOrdemId], references: [id])

  quantidade Decimal  @db.Decimal(18, 4)
  data       DateTime
  motivo     String

  designacaoId String
  designacao   DesignacaoNoContrato @relation(fields: [designacaoId], references: [id])

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([ordemId])
  @@index([itemDaOrdemId])
}

enum TipoDoMovimentoDeExecucao {
  SUSPENSAO
  RETOMADA
}

/// SUSPENDER e RETOMAR a execução, com marco e motivo. A situação é o último movimento.
model MovimentoDeExecucaoDaOrdem {
  id String @id @default(cuid())

  ordemId String
  ordem   OrdemDeServicoDoContrato @relation(fields: [ordemId], references: [id])

  tipo   TipoDoMovimentoDeExecucao
  data   DateTime
  motivo String

  designacaoId String
  designacao   DesignacaoNoContrato @relation(fields: [designacaoId], references: [id])

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([ordemId, data])
}

// ============================================================================
// V7 M2 U2 — A MEDIÇÃO DA ORDEM E OS RECEBIMENTOS POR PARCELA (Lei 14.133, art. 140)
//
// Fatos SEPARADOS, cada um com autor, designação usada e data:
//   medição (o que o fiscal informa ter sido executado, por item e período) →
//   recebimento PROVISÓRIO (art. 140, I, a — o fiscal, com a conferência por item: conforme e em controvérsia) →
//   decisão da controvérsia (aceita: a quantidade fica elegível; rejeitada: glosa confirmada, o registro fica) →
//   recebimento DEFINITIVO (art. 140, I, b — o recebedor designado, do que é elegível; pode haver o complemento).
// Receber uma parcela não encerra a ordem nem o contrato. Nenhum destes fatos liquida nem paga.
// ============================================================================

model MedicaoDaOrdemDeServico {
  id String @id @default(cuid())

  ordemId String
  ordem   OrdemDeServicoDoContrato @relation(fields: [ordemId], references: [id])

  /// Sequencial por ordem, atribuído sob o trinco do contrato.
  numero Int

  periodoInicio DateTime
  periodoFim    DateTime

  /// A designação de FISCAL vigente com que foi registrada (pode ser o sucessor do fiscal indicado na ordem).
  designacaoId String
  designacao   DesignacaoNoContrato @relation(fields: [designacaoId], references: [id])

  observacao String?

  criadoEm  DateTime @default(now())
  criadoPor String

  itens                   ItemMedidoNaOrdem[]
  recebimentoProvisorio   RecebimentoProvisorio?
  recebimentosDefinitivos RecebimentoDefinitivo[]
  // V7 M2 U7 — a origem pela planilha, o estorno e as evidências. VIRTUAIS.
  naPlanilha              MedicaoDaOrdemNaPlanilha? @relation("MedicaoDaOrdemPelaPlanilha")
  estorno                 EstornoDeMedicaoDaOrdem?  @relation("EstornoDaMedicaoDaOrdem")
  evidencias              Anexo[]                   @relation("EvidenciaDaMedicaoDaOrdem")

  @@unique([ordemId, numero])
}

model ItemMedidoNaOrdem {
  id String @id @default(cuid())

  medicaoId String
  medicao   MedicaoDaOrdemDeServico @relation(fields: [medicaoId], references: [id])

  itemDaOrdemId String
  itemDaOrdem   ItemDaOrdemDeServico @relation(fields: [itemDaOrdemId], references: [id])

  quantidade    Decimal @db.Decimal(18, 4)
  /// O unitário DA ORDEM (copiado dela), não o do contrato vivo.
  valorUnitario Decimal @db.Decimal(18, 4)
  valor         Decimal @db.Decimal(18, 2)

  conferencia        ConferenciaDoItemMedido?
  recebidos          ItemRecebidoDefinitivamente[]
  /// V7 M2 U7 — o serviço da planilha de que veio a quantidade (quando medido pela planilha). VIRTUAL.
  origemNaPlanilha   ItemMedidoDaOrdemNaPlanilha? @relation("OrigemNaPlanilha")

  @@unique([medicaoId, itemDaOrdemId])
  @@index([itemDaOrdemId])
}

/// O RECEBIMENTO PROVISÓRIO — um por medição, pelo fiscal, "mediante termo detalhado" (manifesto + sha256).
model RecebimentoProvisorio {
  id String @id @default(cuid())

  medicaoId String                  @unique
  medicao   MedicaoDaOrdemDeServico @relation(fields: [medicaoId], references: [id])

  data DateTime

  designacaoId String
  designacao   DesignacaoNoContrato @relation(fields: [designacaoId], references: [id])

  /// O que foi verificado (exigências de caráter técnico).
  verificacoes String

  manifesto Json
  sha256    String @db.VarChar(64)

  criadoEm  DateTime @default(now())
  criadoPor String

  conferencias ConferenciaDoItemMedido[]
}

/// A CONFERÊNCIA DE UM ITEM MEDIDO — conforme + em controvérsia = medido (conferido no caso de uso). A controvérsia
/// exige motivo; ela não é glosa, retenção nem multa: é quantidade cuja aceitação ainda não foi decidida.
model ConferenciaDoItemMedido {
  id String @id @default(cuid())

  recebimentoProvisorioId String
  recebimentoProvisorio   RecebimentoProvisorio @relation(fields: [recebimentoProvisorioId], references: [id])

  itemMedidoId String            @unique
  medido       ItemMedidoNaOrdem @relation(fields: [itemMedidoId], references: [id])

  quantidadeConforme       Decimal @db.Decimal(18, 4)
  quantidadeEmControversia Decimal @db.Decimal(18, 4)
  motivo                   String?

  decisao DecisaoDeControversia?

  @@index([recebimentoProvisorioId])
}

enum ResultadoDaControversia {
  /// A quantidade em controvérsia foi aceita: fica elegível ao recebimento definitivo (o complemento).
  ACEITA
  /// Rejeitada: glosa confirmada. A quantidade não se recebe; o registro da divergência permanece.
  REJEITADA
}

model DecisaoDeControversia {
  id String @id @default(cuid())

  conferenciaId String                  @unique
  conferencia   ConferenciaDoItemMedido @relation(fields: [conferenciaId], references: [id])

  resultado  ResultadoDaControversia
  fundamento String
  data       DateTime

  designacaoId String
  designacao   DesignacaoNoContrato @relation(fields: [designacaoId], references: [id])

  manifesto Json
  sha256    String @db.VarChar(64)

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// O RECEBIMENTO DEFINITIVO — do que é elegível na medição (conforme + controvérsia aceita − já recebido). Pode haver
/// mais de um por medição: o regular primeiro, o complemento depois da decisão.
model RecebimentoDefinitivo {
  id String @id @default(cuid())

  medicaoId String
  medicao   MedicaoDaOrdemDeServico @relation(fields: [medicaoId], references: [id])

  numero Int

  data DateTime

  designacaoId String
  designacao   DesignacaoNoContrato @relation(fields: [designacaoId], references: [id])

  /// "Termo detalhado que comprove o atendimento das exigências contratuais".
  conclusao String

  manifesto Json
  sha256    String @db.VarChar(64)

  criadoEm  DateTime @default(now())
  criadoPor String

  itens ItemRecebidoDefinitivamente[]
  /// V7 M2 U3 — as alocações das liquidações que consumiram este recebimento. VIRTUAL.
  alocacoes AlocacaoDaLiquidacaoNaParcela[]
  /// V9 N4 — o estorno deste recebimento, quando houver. VIRTUAL.
  estorno   EstornoDeRecebimentoDefinitivo? @relation("EstornoDoRecebimentoDefinitivo")

  @@unique([medicaoId, numero])
}

model ItemRecebidoDefinitivamente {
  id String @id @default(cuid())

  recebimentoId String
  recebimento   RecebimentoDefinitivo @relation(fields: [recebimentoId], references: [id])

  itemMedidoId String
  medido       ItemMedidoNaOrdem @relation(fields: [itemMedidoId], references: [id])

  quantidade Decimal @db.Decimal(18, 4)
  valor      Decimal @db.Decimal(18, 2)

  @@unique([recebimentoId, itemMedidoId])
  @@index([itemMedidoId])
}

/// V7 M2 U3 — A ALOCAÇÃO DA LIQUIDAÇÃO NA PARCELA RECEBIDA. Uma liquidação do M05 pode consumir mais de um recebimento
/// definitivo (o regular e o complemento na mesma nota), e um recebimento pode ser consumido por mais de uma liquidação.
/// Gravada na transação da liquidação, sob o trinco do contrato; o consumido é DERIVADO (estorno da liquidação libera).
model AlocacaoDaLiquidacaoNaParcela {
  id String @id @default(cuid())

  liquidacaoId String
  liquidacao   Liquidacao @relation("AlocacoesDaLiquidacao", fields: [liquidacaoId], references: [id])

  recebimentoDefinitivoId String
  recebimentoDefinitivo   RecebimentoDefinitivo @relation(fields: [recebimentoDefinitivoId], references: [id])

  valor Decimal @db.Decimal(18, 2)

  criadoEm  DateTime @default(now())
  criadoPor String

  /// O nome é o que o PostgreSQL gravou (63 bytes, truncado) na migration 20260917090700 — declarado para a deriva
  /// não o recriar.
  @@unique([liquidacaoId, recebimentoDefinitivoId], map: "AlocacaoDaLiquidacaoNaParcela_liquidacaoId_recebimentoDefinitiv")
  @@index([recebimentoDefinitivoId])
}
