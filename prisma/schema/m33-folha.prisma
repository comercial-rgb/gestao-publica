// ============================================================================
// M33 — FOLHA DE PAGAMENTO (RH bloco 2, V6 P2.3): tabelas do ente, rubricas, lançamentos,
// cálculo com memória por servidor e por rubrica, fechamento com sha256.
//
// ⚠️ NENHUM CÓDIGO NO CÓDIGO. Alíquota, faixa, teto, dedução por dependente, desconto
// simplificado, redutor e valor do salário-família vêm DESTAS tabelas, cadastradas pelo ente
// com a fundamentação legal, vigentes por competência. Sem tabela vigente, a folha RECUSA
// nomeando a competência — nunca calcula com um valor embutido.
//
// ⚠️ O CÁLCULO É UM FATO NUMERADO, nunca UPDATE: recalcular gera `CalculoDaFolha` numero+1; o
// cancelamento é `CancelamentoDoCalculo` (fato); o fechamento congela UM cálculo e leva o sha256
// do conjunto. O contracheque guarda a MEMÓRIA canônica (JSON determinístico) e o seu sha256.
//
// Algoritmos conciliados do motor doador `folha-engine` (saas-municipal) — só a lógica pura,
// reescrita em Decimal e sobre tabelas do ente (ver docs/adr/ADR-folha-tabelas-do-ente.md).
// ============================================================================

/// O regime previdenciário do VÍNCULO — decide qual tabela de contribuição se aplica.
enum RegimePrevidenciario {
  /// Regime Geral (INSS): tabela progressiva com teto, cadastrada pelo ente a partir da portaria vigente.
  RGPS
  /// Regime Próprio do ente: alíquota da lei municipal (uma ou mais faixas), teto opcional.
  RPPS
  /// Sem contribuição (estagiário, conselheiro tutelar, conforme a lei do ente).
  ISENTO
}

/// A tabela de contribuição previdenciária, por regime e vigência. RGPS: faixas progressivas com teto.
/// RPPS: uma faixa (linear) ou várias (progressiva), teto opcional.
model TabelaDeContribuicao {
  id String @id @default(cuid())

  regime RegimePrevidenciario

  /// Vigência por COMPETÊNCIA (AAAA-MM), inclusiva. Fim nulo = vigente até nova tabela.
  competenciaInicio String @db.VarChar(7)
  competenciaFim    String? @db.VarChar(7)

  /// O salário de contribuição máximo. Nulo = sem teto (RPPS que contribui sobre a remuneração integral).
  teto Decimal? @db.Decimal(18, 2)

  /// Alíquota patronal (RPPS: normal + suplementar somadas; RGPS: a cota do empregador). Informativa
  /// para a planilha contábil (5.12.72/73); não desconta do servidor.
  aliquotaPatronal Decimal? @db.Decimal(7, 4)

  /// Portaria, lei ou decreto que fixou os valores. Obrigatória: sem fonte não há tabela.
  fundamentacaoLegal String

  criadoEm  DateTime @default(now())
  criadoPor String

  faixas FaixaDeContribuicao[]

  @@index([regime, competenciaInicio])
}

model FaixaDeContribuicao {
  id String @id @default(cuid())

  tabelaId String
  tabela   TabelaDeContribuicao @relation(fields: [tabelaId], references: [id])

  ordem Int

  /// Limite superior INCLUSIVO da faixa. Nulo só na última (sem limite).
  ate Decimal? @db.Decimal(18, 2)

  /// Decimal: 0.0750 = 7,5%.
  aliquota Decimal @db.Decimal(7, 4)

  @@unique([tabelaId, ordem])
}

/// A tabela do imposto de renda retido na fonte, por vigência. Os parâmetros opcionais dizem
/// quais CENÁRIOS o cálculo pode usar: desconto simplificado (quando informado) e redutor
/// (quando os três campos vêm). O cálculo escolhe o MENOR imposto entre os cenários aplicáveis.
model TabelaIrrf {
  id String @id @default(cuid())

  competenciaInicio String  @db.VarChar(7)
  competenciaFim    String? @db.VarChar(7)

  deducaoPorDependente Decimal @db.Decimal(18, 2)

  /// Desconto simplificado mensal (substitui as deduções). Nulo = cenário indisponível nesta vigência.
  descontoSimplificado Decimal? @db.Decimal(18, 2)

  /// Parcela isenta adicional para quem tem 65 anos ou mais (aposentadoria/pensão). Nulo = não há.
  isencaoMaior65 Decimal? @db.Decimal(18, 2)

  /// Redutor: max(0, base − fator × renda), zerado acima da renda máxima. Os três juntos ou nenhum (CHECK).
  redutorBase        Decimal? @db.Decimal(18, 2)
  redutorFator       Decimal? @db.Decimal(12, 8)
  redutorRendaMaxima Decimal? @db.Decimal(18, 2)

  /// Primeira faixa da tabela de redução (Lei 9.250/1995 art. 3º-A, Lei 15.270/2025): até esta renda,
  /// redução de até o máximo, de modo que o imposto seja zero. Os dois juntos ou nenhum, e só com o
  /// redutor linear presente (CHECK TabelaIrrf_redutor_faixa_isenta_chk). Nulos = só a fórmula linear.
  redutorRendaDaFaixaIsenta  Decimal? @db.Decimal(18, 2)
  redutorMaximoNaFaixaIsenta Decimal? @db.Decimal(18, 2)

  fundamentacaoLegal String

  criadoEm  DateTime @default(now())
  criadoPor String

  faixas FaixaIrrf[]

  @@index([competenciaInicio])
}

model FaixaIrrf {
  id String @id @default(cuid())

  tabelaId String
  tabela   TabelaIrrf @relation(fields: [tabelaId], references: [id])

  ordem Int

  /// Limite superior INCLUSIVO da base. Nulo só na última.
  ate Decimal? @db.Decimal(18, 2)

  aliquota Decimal @db.Decimal(7, 4)

  /// A parcela a deduzir da fórmula simplificada — usada só para CONFERIR o cálculo faixa a faixa.
  parcelaADeduzir Decimal @default(0) @db.Decimal(18, 2)

  @@unique([tabelaId, ordem])
}

/// O salário-família: pago por dependente elegível a quem ganha até a renda máxima.
model TabelaSalarioFamilia {
  id String @id @default(cuid())

  competenciaInicio String  @db.VarChar(7)
  competenciaFim    String? @db.VarChar(7)

  rendaMaxima         Decimal @db.Decimal(18, 2)
  valorPorDependente  Decimal @db.Decimal(18, 2)
  /// Idade limite (exclusiva): dependente com idade < limite recebe. Inválido recebe sem limite.
  idadeLimite Int

  fundamentacaoLegal String

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([competenciaInicio])
}

enum TipoDeRubrica {
  PROVENTO
  DESCONTO
}

/// De onde a rubrica tira o valor. As sistêmicas (vencimento, gratificações, contribuição, IRRF e
/// salário-família) existem UMA vez cada — o serviço impõe.
enum NaturezaDaRubrica {
  /// O vencimento-base vigente do vínculo no último dia da competência (M32).
  VENCIMENTO_BASE
  /// A soma das gratificações vigentes do vínculo (M32).
  GRATIFICACOES_DO_VINCULO
  /// O valor vem de um lançamento fixo ou variável (`LancamentoDaFolha`).
  VALOR_INFORMADO
  /// `percentual` × vencimento-base.
  PERCENTUAL_DO_VENCIMENTO
  /// A contribuição previdenciária do servidor pela tabela do regime.
  CONTRIBUICAO_PREVIDENCIARIA
  /// O IRRF pela tabela vigente.
  IMPOSTO_DE_RENDA
  /// O salário-família pela tabela vigente e pelos dependentes com a finalidade.
  SALARIO_FAMILIA
  /// V11 V1.1 — o valor vem da FÓRMULA da versão vigente, interpretada em universo fechado
  /// (`packages/formula`). As variáveis são as do contracheque e as OUTRAS rubricas, por código.
  FORMULA
  /// ⚠️ V11 V9.1 — O ABATIMENTO DA 1ª PARCELA DO 13º, e ele é natureza PRÓPRIA por uma razão que
  /// nenhuma outra tem: o valor dele vem de OUTRA FOLHA — o provento do adiantamento já fechado
  /// do mesmo exercício. A fórmula do ente não alcança isso: `packages/formula` é universo
  /// fechado sobre o contracheque CORRENTE, e abrir esse universo para "o valor daquela outra
  /// folha" transformaria o interpretador num leitor de banco.
  ///
  /// O motor MENSAL a ignora (cai no `default` do switch): ela só produz linha na folha de 13º.
  ABATIMENTO_DO_ADIANTAMENTO_DO_13

  /// ⚠️ V13 — O ABATIMENTO DO ADIANTAMENTO SALARIAL (o "vale"), e ele é natureza PRÓPRIA pela
  /// MESMA razão de `ABATIMENTO_DO_ADIANTAMENTO_DO_13` e por uma segunda que só ele tem.
  ///
  /// A primeira: o valor vem de OUTRA FOLHA — o provento do vale já fechado da MESMA competência.
  /// `packages/formula` é universo fechado sobre o contracheque CORRENTE, e abri-lo para "o valor
  /// daquela outra folha" transformaria o interpretador num leitor de banco.
  ///
  /// A segunda, e é ela que impede o reuso da natureza do 13º: as duas abatem em FOLHAS
  /// DIFERENTES. A do 13º só produz linha na folha `DECIMO_TERCEIRO`; esta só produz linha na
  /// folha `MENSAL`. Uma natureza só para as duas faria o motor mensal buscar o adiantamento do
  /// 13º para abater do salário do mês — metade da gratificação natalina descontada do
  /// vencimento, com os totais fechando.
  ///
  /// O motor do 13º a ignora, e o motor do próprio ADIANTAMENTO_SALARIAL também: ela só existe
  /// na MENSAL.
  ABATIMENTO_DO_ADIANTAMENTO_SALARIAL
}

model Rubrica {
  id String @id @default(cuid())

  codigo    String @unique
  descricao String

  tipo     TipoDeRubrica
  natureza NaturezaDaRubrica

  /// Só PERCENTUAL_DO_VENCIMENTO. Decimal: 0.2000 = 20%.
  percentual Decimal? @db.Decimal(7, 4)

  /// Incidências — o ente as parametriza por rubrica (5.12.62/63).
  incideContribuicao Boolean
  incideIrrf         Boolean

  /// Proporcional aos dias do mês fiscal (30) em que o vínculo esteve ativo e não afastado.
  proporcionalAosDias Boolean

  /// Ordem no contracheque.
  ordem Int

  fundamentacaoLegal String

  criadoEm  DateTime @default(now())
  criadoPor String

  lancamentos LancamentoDaFolha[]
  linhas      LinhaDoContracheque[]
  grupoDeEmpenho RubricaDoGrupoDeEmpenho?
  /// V6.2 — as versões de encargo em que esta rubrica compõe a base.
  incidenciasDeEncargo IncidenciaDoEncargo[]
  /// V11 V1.1 — as versões vigentes por competência. A VERSÃO é a autoridade do cálculo; as
  /// colunas acima registram como a rubrica nasceu e não são mais lidas pelo motor.
  versoes VersaoDaRubrica[]
  /// V11 V9.1 — os papéis que esta rubrica exerce no 13º (ver `m33-decimo-terceiro.prisma`).
  parametrosComoDecimoTerceiro ParametroDoDecimoTerceiro[]     @relation("RubricaDoDecimoTerceiro")
  parametrosComoAdiantamento   ParametroDoDecimoTerceiro[]     @relation("RubricaDoAdiantamentoDo13")
  parametrosComoAbatimento     ParametroDoDecimoTerceiro[]     @relation("RubricaDoAbatimentoDo13")
  basesDoDecimoTerceiro        RubricaDaBaseDoDecimoTerceiro[] @relation("RubricaDaBaseDo13")
  /// V13 — os papéis que esta rubrica exerce no ADIANTAMENTO SALARIAL
  /// (ver `m33-adiantamento-salarial.prisma`).
  parametrosComoAdiantamentoSalarial ParametroDoAdiantamentoSalarial[] @relation("RubricaDoAdiantamentoSalarial")
  parametrosComoAbatimentoSalarial   ParametroDoAdiantamentoSalarial[] @relation("RubricaDoAbatimentoSalarial")

  @@index([natureza])
  @@index([ordem])
}

enum TipoDeLancamentoDaFolha {
  /// Vale por competências consecutivas (vigência); ex.: insalubridade, mensalidade sindical.
  FIXO
  /// Vale numa competência só; ex.: horas extras, adicional noturno.
  VARIAVEL
}

/// Um valor informado para uma rubrica VALOR_INFORMADO de um vínculo. Append-only: encerrar um
/// fixo é registrar `competenciaFim` ao criar, ou um novo lançamento; nada se apaga.
model LancamentoDaFolha {
  id String @id @default(cuid())

  vinculoId String
  vinculo   Vinculo @relation(fields: [vinculoId], references: [id])

  rubricaId String
  rubrica   Rubrica @relation(fields: [rubricaId], references: [id])

  tipo TipoDeLancamentoDaFolha

  /// FIXO: início obrigatório, fim opcional. VARIÁVEL: início = fim = a competência (CHECK).
  competenciaInicio String  @db.VarChar(7)
  competenciaFim    String? @db.VarChar(7)

  valor Decimal @db.Decimal(18, 2)

  observacao String?
  atoLegal   String?

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([vinculoId, competenciaInicio])
  @@index([rubricaId])
}

enum TipoDeFolha {
  MENSAL
  /// V11 V9.1 — a 1ª parcela do 13º. O valor sai dos AVOS do exercício, não dos dias do mês.
  ADIANTAMENTO_DECIMO_TERCEIRO
  /// V11 V9.1 — o 13º integral, do qual a 1ª parcela já paga é ABATIDA.
  DECIMO_TERCEIRO
  /// ⚠️ V11 V9.4 — A FOLHA MENSAL COMPLEMENTAR (TR 5.12.50): "pagar o que faltou" numa
  /// competência cuja mensal JÁ FECHOU. Ela NÃO é a retificação: não reabre, não corrige e não
  /// substitui nada — recalcula a competência com o cadastro de hoje e paga a DIFERENÇA, rubrica
  /// a rubrica. Diferença negativa é RECUSA (reposição ao erário é ato que não existe aqui).
  ///
  /// ⚠️ ELA É POR COMPETÊNCIA, e é por isso que `exercicio` fica NULO nela. Quem diz isso não é
  /// este comentário: é `NATUREZA_DO_TIPO_DE_FOLHA` (`modules/m33-folha/dominio.ts`), um
  /// `Record<TipoDeFolha, ...>` exaustivo que NÃO COMPILA enquanto um tipo novo não for
  /// classificado, e o CHECK `ck_folha_exercicio_por_tipo` escrito a partir dele.
  MENSAL_COMPLEMENTAR

  /// ⚠️ V13 (TR 5.12.50) — O ADIANTAMENTO SALARIAL, o "vale": o ente paga no meio do mês uma
  /// parte da remuneração da competência, e a folha MENSAL da MESMA competência abate o que ele
  /// adiantou.
  ///
  /// ⚠️ ELE É POR COMPETÊNCIA (um vale por mês), então `exercicio` fica NULO — lado que `MENSAL`
  /// já ocupa no CHECK `ck_folha_exercicio_por_tipo`. Quem classifica é
  /// `NATUREZA_DO_TIPO_DE_FOLHA` (`modules/m33-folha/dominio.ts`), e o CHECK sai de lá; o
  /// `m33-recorrencia-do-tipo-de-folha.test.ts` afirma por EFEITO que os dois concordam.
  ///
  /// ⚠️ E `compoeARemuneracaoMensal` É `false` NELE. Se fosse `true`, o "já apurado" da folha
  /// COMPLEMENTAR somaria o provento do vale — e o recálculo do mensal nunca reproduz aquela
  /// rubrica, porque ela só existe aqui. O delta ficaria negativo e a complementar recusaria TODA
  /// competência que teve vale, dizendo ao servidor que ele deve ao erário justamente o
  /// adiantamento que a mensal já abateu. O 13º já caiu nessa uma vez.
  ADIANTAMENTO_SALARIAL
}

/// A folha de uma competência e tipo. A situação é DERIVADA: sem cálculo / calculada / fechada.
model FolhaDePagamento {
  id String @id @default(cuid())

  competencia String      @db.VarChar(7)
  tipo        TipoDeFolha

  /// ⚠️ V11 V9.1 — O EXERCÍCIO É COLUNA, E NÃO DERIVAÇÃO DE `competencia`, por UMA razão: é ele
  /// que o banco usa para impedir duas folhas de 13º no mesmo ano. Um índice sobre
  /// `substring(competencia,1,4)` seria expressão, que o schema do Prisma não declara — e índice
  /// que o schema não declara a deriva remove em silêncio.
  ///
  /// NULO na MENSAL (várias por ano, uma por competência) e NÃO NULO nos dois tipos de 13º, onde
  /// o CHECK ainda exige que ele COINCIDA com o ano da competência. Em Postgres vários NULL
  /// convivem num índice único, então `@@unique([exercicio, tipo])` não estorva a mensal.
  exercicio Int?

  /// ⚠️ V11 V9.1 — QUAL adiantamento esta folha de 13º abate. Resolvido pelo SERVIÇO na abertura
  /// (é único por exercício), nunca digitado — apontar à mão permitiria abater a folha errada.
  /// Nulo quando o ente não pagou 1ª parcela no exercício; o cálculo RECUSA se um adiantamento
  /// aparecer depois da abertura, em vez de abater zero em silêncio.
  folhaDoAdiantamentoId String?
  folhaDoAdiantamento   FolhaDePagamento?  @relation("AdiantamentoAbatido", fields: [folhaDoAdiantamentoId], references: [id])
  folhasQueAbatem       FolhaDePagamento[] @relation("AdiantamentoAbatido")

  criadoEm  DateTime @default(now())
  criadoPor String

  calculos    CalculoDaFolha[]
  fechamento  FechamentoDaFolha?
  guiasDeRecolhimento GuiaDeRecolhimento[] @relation("GuiasDaFolha")
  apropriacao ApropriacaoDaFolha?

  /// V6.1 — a trilha de certificação (atesto e devolução). Estado atual = último fato.
  certificacoes CertificacaoDaFolha[]
  /// V6.2 — as apurações dos encargos do empregador (fatos próprios, numerados por cálculo).
  apuracoesDeEncargos ApuracaoDeEncargos[]

  /// ⚠️ V11 V9.4 — UMA folha de cada tipo por competência, e para a MENSAL COMPLEMENTAR isso é
  /// decisão de produto PENDENTE, não desenho fechado: um ente que descubra uma segunda coisa
  /// depois de a complementar já ter FECHADO não tem por onde pagá-la. Enquanto a complementar
  /// está ABERTA, recalcular já absorve qualquer achado novo — o delta é sempre "o correto menos
  /// TUDO o que já foi apurado na competência", então o segundo achado entra no cálculo seguinte
  /// sem folha nova. Fica nomeado como `SEGUNDA-COMPLEMENTAR-NA-MESMA-COMPETENCIA` no MODULO do
  /// M33, com a evidência levantada; numerar a complementar exigiria trocar este índice e dar um
  /// segmento novo ao número do empenho, que é chave de negócio.
  @@unique([competencia, tipo])
  /// V11 V9.1 — UM adiantamento e UM 13º por exercício. A folha de DIFERENÇA de 13º (5.12.50)
  /// não existe neste sistema e está declarada ausente; se vier, é tipo novo, não uma segunda
  /// folha do mesmo tipo.
  @@unique([exercicio, tipo])
}

/// V11 V9.5 (TR 5.12.50) — COMO o operador declarou quem entra no cálculo.
///
/// ⚠️ `TODOS_OS_ELEGIVEIS` NÃO É "lista vazia", E A DISTINÇÃO É A GUARDA CONTRA O DEFEITO DA
/// PAGINAÇÃO. O modo é DECLARADO, nunca inferido do tamanho da lista: inferir faria uma seleção
/// de 25 num ente de 25 servidores ser indistinguível de "todos" — e faria uma tela paginada que
/// manda os 25 visíveis passar por "selecionou tudo".
enum ModoDeSelecaoDoCalculo {
  /// Todos os vínculos que existem na competência. É o comportamento anterior à seleção, e
  /// continua sendo o padrão de toda folha já gravada (o `@default` da coluna).
  TODOS_OS_ELEGIVEIS
  /// O operador nomeou cada vínculo. A lista vive em `AbrangenciaDoCalculo`.
  EXPLICITA
}

/// V11 V9.5 — POR QUE um vínculo considerado não produziu contracheque.
///
/// ⚠️ CADA VALOR AQUI ERA UM `continue` MUDO OU UMA AUSÊNCIA SILENCIOSA. Os dois primeiros são
/// literalmente as duas linhas que o motor mensal descartava sem deixar rastro, no laço de
/// `contrachequesMensaisDaCompetencia` (`modules/m33-folha/servico.ts`).
enum MotivoDaExclusaoDoCalculo {
  /// Admitido depois do fim da competência. Era um `continue` mudo até a V11 V9.5.
  ADMITIDO_APOS_A_COMPETENCIA
  /// Desligado antes do início da competência. O outro `continue` mudo.
  DESLIGADO_ANTES_DA_COMPETENCIA
  /// Só na COMPLEMENTAR: o correto e o já apurado coincidem, então não há diferença a pagar.
  SEM_DIFERENCA_A_PAGAR
}

/// ⚠️ DOIS MOTIVOS FORAM TENTADOS E DESCARTADOS PELO QUE O BANCO DISSE, e ficam registrados aqui
/// para ninguém os reintroduzir:
///
///   · `NAO_SELECIONADO` — gravar uma linha por vínculo NÃO pedido faria um cálculo de 2 pessoas
///     num ente de 900 gravar 898 linhas de ruído, escondendo as exclusões que importam. E ele é
///     DERIVÁVEL de `modoDeSelecao = EXPLICITA` mais a lista dos considerados. Fato derivável não
///     vira linha.
///   · `VINCULO_INEXISTENTE` — IMPOSSÍVEL de gravar: a FK desta tabela aponta para `Vinculo`, e um
///     vínculo que não existe não tem para onde apontar. A tentativa estourou a FK e derrubou a
///     transação. A revalidação passou a RECUSAR o cálculo inteiro, que é mais forte.

/// ═══ V11 V9.5 — O FATO DE ABRANGÊNCIA: quem o cálculo processou, e por que os outros não ═══
///
/// ⚠️ ELE NASCEU NO MESMO COMMIT QUE A SELEÇÃO, E ISSO NÃO É ZELO — é a condição de a seleção ser
/// segura. `calcularFolha` prometia "todos os vínculos vivos" e mantinha a promessa POR
/// CONSTRUÇÃO (o `findMany` sem `where`). A seleção remove essa construção, e **uma promessa
/// mantida por construção some junto com a construção**. Sem este registro, uma folha parcial
/// fecha com o total batendo, o empenho batendo e a liquidação batendo — nenhuma etapa adiante
/// acusa, que é a forma exata de defeito que este módulo já pagou três vezes.
///
/// ⚠️ E ELE GUARDA OS EXCLUÍDOS, NÃO SÓ OS INCLUÍDOS. "Quem entrou" já era reconstruível pela
/// lista de `Contracheque`; o que não existia em lugar nenhum era **por que ficou de fora quem
/// ficou** — e é essa metade que foi exigida recuperável.
model AbrangenciaDoCalculo {
  id String @id @default(cuid())

  calculoId String
  calculo   CalculoDaFolha @relation(fields: [calculoId], references: [id])

  vinculoId String
  vinculo   Vinculo @relation(fields: [vinculoId], references: [id])

  /// Verdadeiro exatamente quando existe `Contracheque` deste vínculo neste cálculo.
  calculado Boolean

  /// Nulo exatamente quando `calculado` é verdadeiro. O CHECK impõe as duas metades.
  motivo MotivoDaExclusaoDoCalculo?

  /// ⚠️ UMA LINHA POR VÍNCULO POR CÁLCULO — é ela que impede o mesmo vínculo de ser contado nos
  /// dois lados (calculado E excluído), que faria a contagem mentir sem nada acusar.
  @@unique([calculoId, vinculoId])
  @@index([vinculoId])
  @@index([calculoId, calculado])
}

/// Um cálculo da folha — numerado por folha; recalcular é o próximo número, nunca UPDATE.
model CalculoDaFolha {
  id String @id @default(cuid())

  folhaId String
  folha   FolhaDePagamento @relation(fields: [folhaId], references: [id])

  numero Int

  motivo String?

  /// Totais do conjunto (somas dos contracheques), guardados para a lista; a fonte é o contracheque.
  totalProventos Decimal @db.Decimal(18, 2)
  totalDescontos Decimal @db.Decimal(18, 2)
  totalLiquido   Decimal @db.Decimal(18, 2)
  contracheques  Int

  /// sha256 da lista ordenada dos sha256 dos contracheques — a impressão digital do cálculo.
  sha256 String @db.VarChar(64)

  /// Versão do algoritmo que calculou (muda quando a lógica muda; o cálculo antigo continua reproduzível).
  versaoDoMotor String

  /// V6.1 — as certificações DESTE cálculo. Certificar prende-se ao objeto conferido.
  certificacoes CertificacaoDaFolha[]

  criadoEm  DateTime @default(now())
  criadoPor String

  /// V11 V9.5 — COMO a seleção foi declarada. `@default` porque a migration é ADITIVA: todo
  /// cálculo já gravado processou todos os elegíveis, e é isso que a coluna passa a dizer dele.
  modoDeSelecao ModoDeSelecaoDoCalculo @default(TODOS_OS_ELEGIVEIS)

  /// V11 V9.5 — o FATO de abrangência: uma linha por vínculo considerado.
  abrangencia AbrangenciaDoCalculo[]

  contrachequesDoCalculo Contracheque[]
  cancelamento           CancelamentoDoCalculo?
  fechamento             FechamentoDaFolha?
  apuracoesDeEncargos    ApuracaoDeEncargos[]

  @@unique([folhaId, numero])
}

model CancelamentoDoCalculo {
  id String @id @default(cuid())

  calculoId String         @unique
  calculo   CalculoDaFolha @relation(fields: [calculoId], references: [id])

  motivo String

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// O fechamento congela UM cálculo da folha. Depois dele, calcular de novo é recusado.
model FechamentoDaFolha {
  id String @id @default(cuid())

  folhaId String           @unique
  folha   FolhaDePagamento @relation(fields: [folhaId], references: [id])

  calculoId String         @unique
  calculo   CalculoDaFolha @relation(fields: [calculoId], references: [id])

  /// Copiado do cálculo no ato — o que foi fechado.
  sha256 String @db.VarChar(64)

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// O contracheque de um vínculo num cálculo: linhas, totais e a MEMÓRIA canônica com o sha256.
model Contracheque {
  id String @id @default(cuid())

  calculoId String
  calculo   CalculoDaFolha @relation(fields: [calculoId], references: [id])

  vinculoId String
  vinculo   Vinculo @relation(fields: [vinculoId], references: [id])

  regime RegimePrevidenciario

  /// Fator de dias aplicado às rubricas proporcionais (dias computados / 30).
  ///
  /// ⚠️ NA FOLHA DE 13º ELE É ZERO, e o zero ali não quer dizer "ninguém trabalhou": quer dizer
  /// NÃO SE APLICA. Quem diz isso não é a prosa deste comentário — é o CHECK
  /// `contracheque_avos_ou_dias`, que exige exatamente uma das duas medidas por contracheque:
  /// ou `avosComputados` nulo e `diasComputados` em [0,30] (mensal), ou `avosComputados` não
  /// nulo e `diasComputados = 0` (13º). Sem o CHECK, um leitor distraído somaria dias de folhas
  /// de 13º e acharia que o ente tem gente com zero dia trabalhado no ano.
  diasComputados Int

  /// ⚠️ V11 V9.1 — OS AVOS DO EXERCÍCIO, quando este contracheque é de 13º. A medida do 13º não
  /// é o dia do mês, é o MÊS do ano: `avosComputados / avosNoExercicio` (os dois do parâmetro do
  /// ente). Nulo na folha mensal. Ver o CHECK citado acima.
  avosComputados Int?

  totalProventos    Decimal @db.Decimal(18, 2)
  totalDescontos    Decimal @db.Decimal(18, 2)
  liquido           Decimal @db.Decimal(18, 2)
  baseContribuicao  Decimal @db.Decimal(18, 2)
  contribuicao      Decimal @db.Decimal(18, 2)
  baseIrrf          Decimal @db.Decimal(18, 2)
  irrf              Decimal @db.Decimal(18, 2)

  /// A memória de cálculo canônica (JSON determinístico): tabelas usadas com fundamentação,
  /// faixas percorridas, cenários do IRRF, dependentes considerados, dias, cada linha com fórmula.
  memoria Json

  sha256 String @db.VarChar(64)

  linhas LinhaDoContracheque[]

  @@unique([calculoId, vinculoId])
  @@index([vinculoId])
}

model LinhaDoContracheque {
  id String @id @default(cuid())

  contrachequeId String
  contracheque   Contracheque @relation(fields: [contrachequeId], references: [id])

  rubricaId String
  rubrica   Rubrica @relation(fields: [rubricaId], references: [id])

  ordem Int
  tipo  TipoDeRubrica

  valorBase Decimal @db.Decimal(18, 2)
  /// Fator aplicado (1.000000 = integral).
  fator     Decimal @db.Decimal(10, 6)
  valor     Decimal @db.Decimal(18, 2)

  incideContribuicao Boolean
  incideIrrf         Boolean

  /// A fórmula em texto: "vencimento-base 3000.00 × 19/30 dias".
  memoria String

  @@unique([contrachequeId, rubricaId])
}

// ============================================================================
// V6 P2.3b — A APROPRIAÇÃO CONTÁBIL DA FOLHA (TR 5.12.71/72)
//
// A folha FECHADA vira despesa: os proventos de cada contracheque, agrupados por GRUPO DE
// EMPENHO (quais rubricas, em qual ficha), geram empenhos pelo M05 — com o roteiro contábil de
// sempre, o saldo da ficha conferido na transação e a fila do art. 141 alimentada.
//
// ⚠️ SÓ O BRUTO É EMPENHADO. Contribuição e imposto retidos do servidor NÃO são despesa
// orçamentária: são retenções que viajam no PAGAMENTO (M05/M09 já as compõem). A parte PATRONAL
// é despesa própria e ainda não é calculada (pendência PATRONAL-NA-MEMORIA).
//
// ⚠️ A NUMERAÇÃO É DETERMINÍSTICA, e é ela que dá IDEMPOTÊNCIA: o empenho da folha nasce com
// `<série do grupo>/<competência>/<matrícula ou código do grupo>`, e o `@@unique([fichaId,
// numero])` do M05 faz a segunda tentativa bater na constraint em vez de duplicar a despesa.
// ============================================================================

/// O grupo de empenho da folha: quais rubricas, em qual ficha, com qual credor.
model GrupoDeEmpenhoDaFolha {
  id String @id @default(cuid())

  codigo    String @unique
  descricao String

  fichaId String
  ficha   FichaOrcamentaria @relation(fields: [fichaId], references: [id])

  /// Art. 141 da Lei 14.133/2021 — a fila em que o pagamento entra. Sem default: ver o M05.
  categoriaOrdemCronologica CategoriaOrdemCronologica

  tipoEmpenho TipoEmpenho

  /// O prefixo da numeração dos empenhos deste grupo ("FP", "FOLHA"). Entra no número junto com a
  /// competência e a matrícula — é o que torna a apropriação repetível sem duplicar.
  serie String @db.VarChar(10)

  /// ⚠️ AS DUAS PRÁTICAS DOS ENTES, e o ente escolhe: `true` = UM empenho por servidor, com o CPF
  /// dele como credor (auditável servidor a servidor, e a fila do art. 141 fica por pessoa);
  /// `false` = UM empenho do grupo inteiro, com o credor declarado abaixo. Escolher por dentro
  /// seria inventar norma que o TR não fixa.
  porServidor Boolean

  /// Obrigatório quando `porServidor = false` (o CHECK impõe): quem figura como credor do empenho
  /// único do grupo.
  credorId String?
  credor   Pessoa? @relation("CredorDeGrupoDaFolha", fields: [credorId], references: [id])

  // ── V6.1 — AS DUAS CONTAS PATRIMONIAIS DA LIQUIDAÇÃO, declaradas pelo ENTE ──
  //
  // ⚠️ E ELAS NÃO PODIAM VIR DO ROL DO M01. `contrapartidaDaLiquidacao` mapeia ELEMENTO → conta
  // e cobre 30, 39 e 71 (pendência MAPA-ELEMENTO-CONTA); o elemento 11 — vencimentos e vantagens
  // fixas — não está lá, e o `CONTA_VPD` do rol é `3.3.2.1.1.01.00`, VPD de SERVIÇOS DE
  // TERCEIROS. Liquidar a folha por ele lançaria a remuneração dos servidores como serviço
  // contratado, e o lançamento FECHARIA — ninguém veria.
  //
  // ⚠️ E UM MAPA GLOBAL POR ELEMENTO TAMBÉM NÃO SERVIRIA: 13º, férias e vencimento compartilham
  // o elemento e creditam contas de "pessoal a pagar" DIFERENTES. Quem sabe é o grupo — que já é,
  // exatamente, "quais rubricas, em qual ficha".
  //
  // ⚠️ NULLABLE NA COLUNA, OBRIGATÓRIAS NO CADASTRO E NO ATO. O NOT NULL invalidaria os grupos já
  // gravados sem inventar conta para eles; o fail-closed vive na LIQUIDAÇÃO, que recusa nomeando
  // o grupo e as duas contas que faltam.

  /// A VPD que a liquidação DEBITA: a remuneração é riqueza que diminuiu (3.1.x no PCASP).
  contaVariacaoId String?
  contaVariacao   ContaPcasp? @relation("VariacaoDeGrupoDaFolha", fields: [contaVariacaoId], references: [id])

  /// A obrigação que a liquidação CREDITA: pessoal a pagar (2.1.1.1.x no PCASP).
  contaObrigacaoId String?
  contaObrigacao   ContaPcasp? @relation("ObrigacaoDeGrupoDaFolha", fields: [contaObrigacaoId], references: [id])

  criadoEm  DateTime @default(now())
  criadoPor String

  rubricas RubricaDoGrupoDeEmpenho[]
  empenhos EmpenhoDaFolha[]
  /// V6.2 — um grupo de ENCARGOS tem componentes, e não rubricas (o serviço impõe um ou outro).
  componentes         ComponenteDoGrupoDeEmpenho[] @relation("ComponentesDoGrupo")
  empenhosDosEncargos EmpenhoDosEncargos[]         @relation("EmpenhosDosEncargos")
  ajustesDosEncargos  AjusteDosEncargos[]          @relation("AjustesDosEncargos")
  guiasDeRecolhimento GuiaDeRecolhimento[]         @relation("GuiasDoGrupo")

  @@index([fichaId])
}

/// A rubrica dentro de um grupo. UMA rubrica em UM grupo só — senão a mesma verba seria empenhada
/// duas vezes, em duas fichas, e o total da folha deixaria de bater com o total empenhado.
model RubricaDoGrupoDeEmpenho {
  id String @id @default(cuid())

  grupoId String
  grupo   GrupoDeEmpenhoDaFolha @relation(fields: [grupoId], references: [id])

  rubricaId String  @unique
  rubrica   Rubrica @relation(fields: [rubricaId], references: [id])

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([grupoId])
}

/// O ato de apropriar a folha fechada. UMA por folha; reexecutar CONTINUA a mesma (é retomável).
model ApropriacaoDaFolha {
  id String @id @default(cuid())

  folhaId String           @unique
  folha   FolhaDePagamento @relation(fields: [folhaId], references: [id])

  /// A data dos empenhos — informada pelo operador, dentro do exercício aberto da ficha.
  dataDoEmpenho DateTime

  criadoEm  DateTime @default(now())
  criadoPor String

  empenhos EmpenhoDaFolha[]
}

/// O empenho que nasceu da folha — o elo entre a competência e a despesa.
model EmpenhoDaFolha {
  id String @id @default(cuid())

  apropriacaoId String
  apropriacao   ApropriacaoDaFolha @relation(fields: [apropriacaoId], references: [id])

  grupoId String
  grupo   GrupoDeEmpenhoDaFolha @relation(fields: [grupoId], references: [id])

  /// Presente quando o grupo empenha POR SERVIDOR; nulo no empenho único do grupo.
  vinculoId String?
  vinculo   Vinculo? @relation(fields: [vinculoId], references: [id])

  empenhoId String  @unique
  empenho   Empenho @relation(fields: [empenhoId], references: [id])

  valor Decimal @db.Decimal(18, 2)

  criadoEm  DateTime @default(now())
  criadoPor String

  /// V6.1 — a liquidação deste empenho, quando houver. UMA — o `@@unique` do outro lado.
  liquidacaoDaFolha LiquidacaoDaFolha?

  @@index([apropriacaoId])
  @@index([grupoId])
  @@index([vinculoId])
}
