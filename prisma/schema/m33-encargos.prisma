// ============================================================================
// M33 — OS ENCARGOS DO EMPREGADOR SOBRE A FOLHA (V6.2 U1 — PATRONAL-NA-MEMORIA; TR 5.12.72/73)
//
// O encargo patronal é obrigação do ENTE. Ele não desconta do servidor, não entra no
// contracheque e não reduz o líquido; e a contribuição RETIDA do servidor, que já está no
// bruto, não vira despesa nova. Aqui mora o que o ente deve sobre a folha FECHADA.
//
// ⚠️ NENHUMA ALÍQUOTA NO CÓDIGO. O componente (previdência patronal, suplementar do RPPS, risco
// ambiental do trabalho, outras entidades, FGTS…) é cadastrado pelo ente, por regime, com
// VERSÕES vigentes por competência: alíquota, teto opcional, as rubricas que compõem a base e a
// fundamentação. A versão só vale depois de APROVADA por outra pessoa, e a marcada SINTÉTICA é
// perfil de teste, dito na memória.
//
// ⚠️ A FOLHA FECHADA NÃO MUDA. A APURAÇÃO DOS ENCARGOS é fato PRÓPRIO, numerado, preso ao cálculo
// fechado — nunca um campo novo no contracheque nem uma linha acrescentada à memória já
// certificada. A primeira apuração de uma folha cujo atesto salarial é ANTERIOR a ela é
// identificada como COMPLEMENTAR; uma nova apuração do mesmo cálculo (parâmetro corrigido) é
// VERSÃO nova, com comparativo, e o que já foi empenhado não se empenha de novo.
// ============================================================================

enum TipoDeEncargoDaFolha {
  PREVIDENCIA_PATRONAL
  PREVIDENCIA_SUPLEMENTAR
  RISCO_AMBIENTAL_DO_TRABALHO
  OUTRAS_ENTIDADES
  FGTS
  OUTRO
}

/// O componente de encargo do ente, por regime previdenciário.
model ComponenteDeEncargo {
  id String @id @default(cuid())

  codigo    String @unique
  descricao String

  tipo   TipoDeEncargoDaFolha
  /// O regime do CONTRACHEQUE a que se aplica. Contracheque de outro regime = NÃO APLICÁVEL.
  regime RegimePrevidenciario

  criadoEm  DateTime @default(now())
  criadoPor String

  versoes        VersaoDoEncargo[]
  grupoDeEmpenho ComponenteDoGrupoDeEmpenho?
}

/// Uma versão dos parâmetros de um componente, vigente por competência (AAAA-MM, inclusiva).
model VersaoDoEncargo {
  id String @id @default(cuid())

  componenteId String
  componente   ComponenteDeEncargo @relation(fields: [componenteId], references: [id])

  competenciaInicio String  @db.VarChar(7)
  competenciaFim    String? @db.VarChar(7)

  /// 0.2000 = 20%. CHECK em [0, 1].
  aliquota Decimal @db.Decimal(7, 4)
  /// Base máxima, quando o fundamento a fixa. Nulo = sem teto.
  teto     Decimal? @db.Decimal(18, 2)

  fundamentacaoLegal String

  /// ⚠️ PERFIL DE TESTE. Uma versão sintética calcula igual, e a memória e a tela dizem que ela não
  /// tem validade normativa. Existe para ambiente de demonstração — não para esconder o que é.
  sintetica Boolean

  /// V24 — a alíquota é a do RAT (1, 2 ou 3%, Lei 10.666/2003, art. 10) e o cálculo a multiplica pelo FAP
  /// aprovado do CNPJ do ente no ano da competência (Decreto 3.048/1999, art. 202-A). FALSO nas versões
  /// anteriores: nelas a alíquota já foi informada ajustada, e continuam calculando igual.
  aplicaFap Boolean @default(false)

  criadoEm  DateTime @default(now())
  criadoPor String

  incidencias IncidenciaDoEncargo[]
  aprovacao   AprovacaoDoEncargo?

  @@index([componenteId, competenciaInicio])
}

/// As rubricas de provento que compõem a base da versão.
model IncidenciaDoEncargo {
  id String @id @default(cuid())

  versaoId String
  versao   VersaoDoEncargo @relation(fields: [versaoId], references: [id])

  rubricaId String
  rubrica   Rubrica @relation(fields: [rubricaId], references: [id])

  @@unique([versaoId, rubricaId])
  @@index([rubricaId])
}

/// A aprovação de uma versão — fato próprio, de outra pessoa que não a que cadastrou.
model AprovacaoDoEncargo {
  id String @id @default(cuid())

  versaoId String          @unique
  versao   VersaoDoEncargo @relation(fields: [versaoId], references: [id])

  motivo String?

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// A APURAÇÃO DOS ENCARGOS de um cálculo fechado — numerada por cálculo, nunca UPDATE.
model ApuracaoDeEncargos {
  id String @id @default(cuid())

  folhaId String
  folha   FolhaDePagamento @relation(fields: [folhaId], references: [id])

  calculoId String
  calculo   CalculoDaFolha @relation(fields: [calculoId], references: [id])

  numero Int

  /// ⚠️ COMPLEMENTAR: a folha já tinha atesto salarial quando os encargos foram apurados. Fica
  /// gravado no ato — a tela e o documento dizem que o atesto salarial NÃO alcança estes encargos.
  complementar Boolean

  motivo String?

  /// A memória canônica (vínculo × componente, situação, base, alíquota, fundamento) e o sha256.
  memoria Json
  sha256  String @db.VarChar(64)

  total      Decimal @db.Decimal(18, 2)
  completa   Boolean
  esperados  Int

  criadoEm  DateTime @default(now())
  criadoPor String

  certificacoes CertificacaoDosEncargos[]
  empenhos      EmpenhoDosEncargos[]
  ajustes       AjusteDosEncargos[]      @relation("AjustesDaApuracao")

  @@unique([calculoId, numero])
  @@index([folhaId])
}

/// O atesto dos ENCARGOS — objeto próprio. O atesto da folha salarial não é o atesto destes.
model CertificacaoDosEncargos {
  id String @id @default(cuid())

  apuracaoId String
  apuracao   ApuracaoDeEncargos @relation(fields: [apuracaoId], references: [id])

  designacaoId String
  designacao   DesignacaoNaFolha @relation("CertificacaoDosEncargos", fields: [designacaoId], references: [id])

  tipo   TipoDeCertificacao
  motivo String?

  /// O sha256 da apuração conferida — copiado no ato.
  sha256 String  @db.VarChar(64)
  total  Decimal @db.Decimal(18, 2)

  criadoEm  DateTime @default(now())
  criadoPor String

  liquidacoes LiquidacaoDosEncargos[]

  @@index([apuracaoId, criadoEm])
}

/// O componente dentro de um grupo de empenho. UM componente em UM grupo só.
model ComponenteDoGrupoDeEmpenho {
  id String @id @default(cuid())

  grupoId String
  grupo   GrupoDeEmpenhoDaFolha @relation("ComponentesDoGrupo", fields: [grupoId], references: [id])

  componenteId String              @unique
  componente   ComponenteDeEncargo @relation(fields: [componenteId], references: [id])

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([grupoId])
}

/// O empenho dos encargos de UMA apuração num grupo — só a DIFERENÇA ainda não empenhada.
model EmpenhoDosEncargos {
  id String @id @default(cuid())

  apuracaoId String
  apuracao   ApuracaoDeEncargos @relation(fields: [apuracaoId], references: [id])

  grupoId String
  grupo   GrupoDeEmpenhoDaFolha @relation("EmpenhosDosEncargos", fields: [grupoId], references: [id])

  empenhoId String  @unique
  empenho   Empenho @relation("EmpenhoDosEncargos", fields: [empenhoId], references: [id])

  valor Decimal @db.Decimal(18, 2)

  criadoEm  DateTime @default(now())
  criadoPor String

  liquidacao LiquidacaoDosEncargos?

  @@unique([apuracaoId, grupoId])
}

/// O elo entre o empenho dos encargos e a liquidação do M05.
model LiquidacaoDosEncargos {
  id String @id @default(cuid())

  empenhoDosEncargosId String             @unique
  empenhoDosEncargos   EmpenhoDosEncargos @relation(fields: [empenhoDosEncargosId], references: [id])

  certificacaoId String
  certificacao   CertificacaoDosEncargos @relation(fields: [certificacaoId], references: [id])

  liquidacaoId String     @unique
  liquidacao   Liquidacao @relation("LiquidacaoDosEncargos", fields: [liquidacaoId], references: [id])

  valor Decimal @db.Decimal(18, 2)

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([certificacaoId])
}

/// V7 M1 U3 — O TIPO DE ATO DO AJUSTE PARA BAIXO dos encargos.
enum TipoDeAjusteDosEncargos {
  /// Anulação parcial de uma LIQUIDAÇÃO não paga, feita pelo M05 (o lançamento é dele).
  ANULACAO_DE_LIQUIDACAO
  /// Anulação parcial de um EMPENHO na parte não liquidada, feita pelo M05.
  ANULACAO_DE_EMPENHO
  /// Valor JÁ PAGO acima do devido: nada foi anulado; fica a necessidade de restituição/compensação.
  RESTITUICAO_A_PROVIDENCIAR
}

/// O RASTRO DE CADA ATO DO AJUSTE PARA BAIXO — uma linha por ato, com a chave determinística que torna
/// a retomada idempotente (a resposta perdida depois do commit do M05 é reconhecida, não refeita).
///
/// ⚠️ O VALOR É SEMPRE POSITIVO: é o quanto o ato reduziu (ou o quanto falta restituir). Não há
/// empenho negativo, e a apuração anterior continua na memória como estava.
model AjusteDosEncargos {
  id String @id @default(cuid())

  /// `${apuracaoId}:${grupoId}:${tipo}:${documento ou sequência}` — a unicidade da retomada.
  chave String @unique

  apuracaoId String
  apuracao   ApuracaoDeEncargos @relation("AjustesDaApuracao", fields: [apuracaoId], references: [id])

  grupoId String
  grupo   GrupoDeEmpenhoDaFolha @relation("AjustesDosEncargos", fields: [grupoId], references: [id])

  tipo  TipoDeAjusteDosEncargos
  valor Decimal @db.Decimal(18, 2)

  /// O registro de anulação parcial do M05 (a linha de Empenho/Liquidacao com anulacaoParcialDeId).
  anulacaoDeEmpenhoId    String?     @unique
  anulacaoDeEmpenho      Empenho?    @relation("AnulacaoDeEmpenhoDosEncargos", fields: [anulacaoDeEmpenhoId], references: [id])
  anulacaoDeLiquidacaoId String?     @unique
  anulacaoDeLiquidacao   Liquidacao? @relation("AnulacaoDeLiquidacaoDosEncargos", fields: [anulacaoDeLiquidacaoId], references: [id])

  motivo String

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([apuracaoId])
  @@index([grupoId])
}

/// ═══ V7 M1 U3 — A GUIA DE RECOLHIMENTO: documento do EMISSOR, não da prefeitura ═══
///
/// Quatro objetos separados: a APURAÇÃO (o que o ente deve, calculado), a OBRIGAÇÃO (a liquidação
/// dos encargos, derivada — `lib/portas/recursos/obrigacoes-dos-encargos.ts`), a GUIA (o documento que
/// o arrecadador emite, com o arquivo dele anexado) e o PAGAMENTO (ato do M05/M09, fora daqui).
///
/// ⚠️ ESTE CADASTRO NÃO GERA GUIA. Não há código de barras, PIX nem autenticação produzidos pelo
/// sistema: o que se registra é a guia REAL recebida, com o arquivo, e "anexada" não é "validada pelo
/// emissor". Vencimento só com fundamento; sem ele, fica nulo e dito "não informado".
/// ⚠️ RECEBER A GUIA NÃO PAGA NADA. A baixa liga a guia a um PAGAMENTO do M05 que já aconteceu.
model GuiaDeRecolhimento {
  id String @id @default(cuid())

  folhaId String
  folha   FolhaDePagamento @relation("GuiasDaFolha", fields: [folhaId], references: [id])

  /// A obrigação é por grupo de empenho dos encargos (destinatário e natureza vêm dele).
  grupoId String
  grupo   GrupoDeEmpenhoDaFolha @relation("GuiasDoGrupo", fields: [grupoId], references: [id])

  /// O arrecadador/destinatário como consta na guia — conferido contra o credor do grupo.
  destinatarioId String
  destinatario   Pessoa @relation("DestinatarioDaGuia", fields: [destinatarioId], references: [id])

  /// Regime ou natureza como consta na guia (ex.: "Contribuição patronal RGPS").
  natureza String

  /// O número/identificador do documento como impresso pelo emissor.
  identificador String

  vencimento             DateTime?
  fundamentoDoVencimento String?

  principal   Decimal @db.Decimal(18, 2)
  /// Os demais componentes que a guia discrimina: [{ rotulo, valor }] (atualização, juros, multa).
  componentes Json
  total       Decimal @db.Decimal(18, 2)

  criadoEm  DateTime @default(now())
  criadoPor String

  anexos       Anexo[]              @relation("AnexoDaGuiaDeRecolhimento")
  baixa        BaixaDaGuia?
  cancelamento CancelamentoDaGuia?

  /// Duplicidade: o mesmo documento do mesmo emissor não entra duas vezes.
  @@unique([destinatarioId, identificador])
  @@index([folhaId])
  @@index([grupoId])
}

/// A BAIXA: a guia foi paga pelo PAGAMENTO indicado (M05), que já existe. Uma por guia.
model BaixaDaGuia {
  id String @id @default(cuid())

  guiaId String             @unique
  guia   GuiaDeRecolhimento @relation(fields: [guiaId], references: [id])

  pagamentoId String    @unique
  pagamento   Pagamento @relation("BaixaDeGuiaDeRecolhimento", fields: [pagamentoId], references: [id])

  observacao String

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// O CANCELAMENTO da guia (emitida errada, substituída pelo emissor). Uma por guia; guia baixada não cancela.
model CancelamentoDaGuia {
  id String @id @default(cuid())

  guiaId String             @unique
  guia   GuiaDeRecolhimento @relation(fields: [guiaId], references: [id])

  motivo String

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// V24 — O FATOR ACIDENTÁRIO DE PREVENÇÃO de um CNPJ num ano (Decreto 3.048/1999, art. 202-A): multiplicador
/// entre 0,5000 e 2,0000, com quatro casas (truncado na quarta, § 1º), publicado anualmente e consultado
/// pelo ente. Append-only; o vigente do ano é o APROVADO mais recente.
model FatorAcidentarioDePrevencao {
  id String @id @default(cuid())

  cnpj  String  @db.VarChar(14)
  ano   Int
  fator Decimal @db.Decimal(5, 4)
  /// De onde veio o valor: a consulta ao FAP do CNPJ, com a data, e o ato que o publicou.
  fonte String

  criadoEm  DateTime @default(now())
  criadoPor String

  aprovacao AprovacaoDoFatorAcidentario?

  @@index([cnpj, ano])
}

/// A aprovação do FAP — de outra pessoa que não a que cadastrou, como a das versões do encargo.
model AprovacaoDoFatorAcidentario {
  id String @id @default(cuid())

  fatorId String                      @unique
  fator   FatorAcidentarioDePrevencao @relation(fields: [fatorId], references: [id])

  criadoEm  DateTime @default(now())
  criadoPor String
}

/// V25 — O ESTABELECIMENTO (CNPJ completo) a que uma lotação pertence, a partir de uma competência. O FAP
/// é atribuído por estabelecimento (Portaria MPS/MF 10/2025, art. 1º, II; Decreto 3.048/1999, art. 202-A:
/// "individualizada pelo seu CNPJ"), e um ente com fundo de CNPJ próprio tem mais de um. A lotação sem
/// registro herda o da lotação acima; sem nenhum na cadeia, vale o CNPJ do ente.
///
/// Append-only, e não coluna da lotação: a lotação que muda de estabelecimento tem as folhas antigas
/// recalculadas com o CNPJ da época.
model EstabelecimentoDaLotacao {
  id String @id @default(cuid())

  lotacaoId String
  lotacao   Lotacao @relation(fields: [lotacaoId], references: [id])

  cnpj              String @db.VarChar(14)
  /// "AAAA-MM": vale desta competência em diante, até o registro seguinte da mesma lotação.
  competenciaInicio String @db.VarChar(7)
  /// O ato ou documento que liga a lotação ao estabelecimento (o cadastro no eSocial, a lei do fundo).
  fundamento        String

  criadoEm  DateTime @default(now())
  criadoPor String

  @@unique([lotacaoId, competenciaInicio])
  @@index([cnpj])
}
