// ============================================================================
// M21 — ACESSO À INFORMAÇÃO: o prazo que vem da NORMA, não do costume (V11 V5.1).
//
// ⚠️ A ARMADILHA QUE ESTE ARQUIVO EXISTE PARA NÃO PISAR. O pedido do lote manda "não
// reutilizar cegamente prazo da ouvidoria". O inventário mostrou algo pior que um prazo
// mal reaproveitado: **a ouvidoria não tem prazo nenhum**. `ManifestacaoDeOuvidoria`,
// `TriagemDaManifestacao` e `RespostaDaOuvidoria` têm só `criadoEm`. O que existe é
// `EtapaDoRoteiro.prazoDias` — prazo de ETAPA, do setor, sem fundamento legal — e um
// "20 dias" escrito à mão num seed de demonstração (`prisma/seed/cenario-ent02.ts`).
//
// Um prazo de acesso à informação é do PEDIDO, não da etapa; nasce de lei; admite
// prorrogação motivada e recurso por instância. Nada disso cabe em `EtapaDoRoteiro`, e
// cravá-lo em código seria inventar norma — federal e municipal de uma vez.
//
// ⚠️ O MOLDE É `VersaoDaConfiguracaoDaCertidao` (M34), e a doutrina é a mesma, palavra por
// palavra: "90 dias é o prazo de muitos municípios e não é o de todos". Aqui: 20 dias é o
// prazo que muita gente cita de cabeça, e este arquivo não é a fonte disso — a configuração
// publicada pelo ente é.
//
// ⚠️ NASCE VAZIA. Sem configuração vigente, o pedido continua sendo recebido e instruído — o
// que fica impedido é PROMETER DATA e PRORROGAR. Recusar o pedido do cidadão porque o ente
// não se configurou puniria quem tem o direito pelo que o ente não fez.
// ============================================================================

/// A CONFIGURAÇÃO DO ACESSO À INFORMAÇÃO — versionada por vigência, com as duas normas.
///
/// ⚠️ DUAS NORMAS, E ELAS NÃO SÃO A MESMA COISA. A federal fixa o direito e o teto do prazo;
/// a regulamentação local diz como o ente o cumpre. O lote pede as duas com publicação e
/// vigência — e pede que a ausência da LOCAL vire **pendência tratável**, não bloqueio. Por
/// isso a federal é obrigatória e a local é anulável: sem a local, o prazo federal continua
/// valendo e o sistema DIZ que o ente ainda não regulamentou. Zerar o prazo por falta da
/// regulamentação local seria transformar uma omissão administrativa em negativa de direito.
model VersaoDaConfiguracaoDoAcessoAInformacao {
  id String @id @default(cuid())

  /// ⚠️ A VERSÃO É @unique e é ela que desempata. Duas configurações podem começar a valer
  /// no mesmo dia (retificação publicada no mesmo diário); a de MAIOR versão é a que vale.
  /// Sem esse critério, "a vigente" dependeria da ordem em que o banco devolvesse as linhas.
  versao Int @unique

  /// Dia civil do ente, "AAAA-MM-DD". Dia civil, nunca instante UTC.
  vigenciaInicio String @db.VarChar(10)

  /// Dias CORRIDOS para responder, contados do protocolo do pedido.
  prazoDeRespostaEmDias Int

  /// Dias CORRIDOS que cada prorrogação acrescenta.
  prazoDeProrrogacaoEmDias Int

  /// ⚠️ QUANTAS prorrogações a norma admite. É DADO, não constante: "uma só" é a regra de
  /// muita norma e não é a de todas, e travá-la no código faria deste arquivo a fonte de um
  /// limite que ninguém conferiu contra a lei do ente.
  prorrogacoesPermitidas Int

  /// Quantas instâncias de recurso a norma prevê. Zero é resposta válida e declarada.
  instanciasDeRecurso Int

  /// Dias CORRIDOS para interpor recurso, contados da resposta.
  prazoDeRecursoEmDias Int

  /// A norma FEDERAL que fixa o direito — texto do ente, com a citação. Obrigatória.
  normaFederal String
  /// Quando ela foi publicada. ⚠️ Publicação NÃO é vigência: a vigência desta configuração é
  /// o `vigenciaInicio` acima, e as duas se separam de propósito.
  normaFederalPublicadaEm DateTime

  /// A regulamentação LOCAL (decreto, lei municipal). Anulável — a ausência é pendência
  /// tratável, nomeada, e não impede o pedido. O CHECK exige texto e data juntos: uma norma
  /// citada sem data de publicação não é conferível por quem for auditar.
  regulamentacaoLocal            String?
  regulamentacaoLocalPublicadaEm DateTime?

  observacao String?

  criadoEm  DateTime @default(now())
  criadoPor String

  @@index([vigenciaInicio])
}

// ============================================================================
// O PEDIDO E OS SEUS FATOS (V11 V5.3 — Fase B)
//
// ⚠️ O PEDIDO NÃO TEM JORNADA PRÓPRIA. Ele é executado por um `Processo` do M21: a
// distribuição, a tramitação entre setores e os anexos são os do processo, e não há uma
// segunda máquina de estados ao lado. O que este par acrescenta é o que o processo não
// sabe: sob QUE norma o pedido nasceu, e quais fatos do rito do acesso aconteceram.
//
// ⚠️ A VERSÃO DA CONFIGURAÇÃO É CONGELADA NO PEDIDO, e repetida em cada fato. Publicar uma
// versão nova não reescreve o prazo de quem já pediu — e um fato gravado sob outra versão
// seria a norma nova entrando por fora do congelamento. `configuracaoVersao` nula é estado
// legítimo: o ente ainda não publicou, o pedido corre, e o que falta é a DATA.
//
// ⚠️ VINCULAR AO PROCESSO NÃO TORNA O PEDIDO PÚBLICO. A projeção do requerente e a interna
// são separadas no domínio (`visaoDoSolicitante` e `visaoInternaDoPedido`), e o
// `fundamentoInterno` existe como coluna PRÓPRIA justamente para não viajar junto com a
// `mensagemAoRequerente` — é a doutrina de `DecisaoDaSolicitacao`.
// ============================================================================

/// A NATUREZA de um fato do rito do acesso. Espelha `NaturezaDoFato` do domínio puro
/// (`modules/m21-protocolo/pedido-de-acesso.ts`) — e o teste de censo cobra o espelho.
enum NaturezaDoFatoDoPedidoDeAcesso {
  PEDIDO_PROTOCOLADO
  PEDIDO_DISTRIBUIDO
  PEDIDO_RECEBIDO
  PRORROGACAO_CONCEDIDA
  RESPOSTA_PREVIA_REGISTRADA
  RESPOSTA_ENTREGUE
  RECURSO_INTERPOSTO
  RECURSO_DECIDIDO
  PEDIDO_ENCERRADO
}

enum ClassificacaoDaRespostaDeAcesso {
  ACESSO_CONCEDIDO
  ACESSO_PARCIAL
  ACESSO_NEGADO
}

enum ResultadoDoRecursoDeAcesso {
  PROVIDO
  PROVIDO_EM_PARTE
  DESPROVIDO
}

/// O PEDIDO DE ACESSO À INFORMAÇÃO — o cabeçalho IMUTÁVEL. Tudo o que acontece é fato.
model PedidoDeAcessoAInformacao {
  id String @id @default(cuid())

  /// O Processo que executa o pedido. `@unique`: um processo executa no máximo um pedido.
  processoId String   @unique
  processo   Processo @relation("PedidoDeAcessoDoProcesso", fields: [processoId], references: [id])

  /// O instante do protocolo. É dele que o prazo se conta — pela régua de `packages/datas`,
  /// no dia civil do ente, nunca por soma de milissegundos.
  protocoladoEm DateTime

  /// ⚠️ CONGELADA. A versão da configuração vigente NO DIA do protocolo. Nula quando o ente
  /// ainda não publicou nenhuma: o pedido corre sem data prometida, e isso vai dito ao
  /// requerente em vez de virar uma data inventada.
  configuracaoVersao Int?

  criadoEm  DateTime @default(now())
  criadoPor String

  fatos FatoDoPedidoDeAcesso[]

  @@index([configuracaoVersao])
  @@index([protocoladoEm])
}

/// UM FATO DO PEDIDO — append-only. Correção é fato novo, nunca `UPDATE`.
model FatoDoPedidoDeAcesso {
  id String @id @default(cuid())

  pedidoId String
  pedido   PedidoDeAcessoAInformacao @relation(fields: [pedidoId], references: [id])

  /// Repetido de propósito: a trilha interna é lida pelo processo, e um JOIN a mais por
  /// linha numa trilha é caro sem necessidade.
  processoId String
  processo   Processo @relation("FatosDeAcessoDoProcesso", fields: [processoId], references: [id])

  natureza NaturezaDoFatoDoPedidoDeAcesso

  /// Quem praticou. `"REQUERENTE"` quando o ato é do cidadão que não é usuário do sistema.
  ator String

  /// O instante e o DIA CIVIL do ente, gravado — não recalculado na leitura. Recalcular na
  /// leitura faz o mesmo fato mudar de dia quando alguém troca o fuso do servidor.
  em  DateTime
  dia String @db.VarChar(10)

  /// A versão EFETIVAMENTE aplicada. Tem de ser a do pedido — o caso de uso recusa divergência.
  configuracaoVersao Int?

  /// ⚠️ A CHAVE DE IDEMPOTÊNCIA, COM O ESCOPO DENTRO DELA: `acesso:<pedidoId>:<natureza>:<sufixo>`.
  /// `@unique` global porque o escopo já está na string — uma chave sem escopo colidiria
  /// entre pedidos e o segundo pedido receberia o replay do primeiro.
  chave String @unique

  /// ⚠️ DUAS COLUNAS, NÃO UMA. O que o cidadão lê e o que instrui o processo não se misturam:
  /// um texto só acaba vazando inteiro para o lado errado.
  mensagemAoRequerente String?
  fundamentoInterno    String?

  setorDestinoId String?
  setorDestino   Setor?  @relation("SetorDestinoDeAcesso", fields: [setorDestinoId], references: [id], onDelete: Restrict)

  documentoId String?
  documento   Anexo?  @relation("DocumentoDeFatoDeAcesso", fields: [documentoId], references: [id], onDelete: Restrict)

  classificacao      ClassificacaoDaRespostaDeAcesso?
  instancia          Int?
  resultadoDoRecurso ResultadoDoRecursoDeAcesso?

  criadoEm DateTime @default(now())

  @@index([pedidoId, em])
  @@index([processoId])
  @@index([natureza])
  @@index([setorDestinoId])
  @@index([documentoId])
}
