{
  "name": "@saas-municipal/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema/public": "./src/schema/public.ts",
    "./schema/tenant": "./src/schema/tenant.ts",
    "./tenancy": "./src/tenancy.ts",
    "./client": "./src/client.ts",
    "./seeds/folha-publico": "./src/seeds/folha-publico.ts",
    "./utils/hash-snapshot": "./src/utils/hash-snapshot.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:generate:tenant": "drizzle-kit generate --config=drizzle.tenant.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:seed": "tsx src/seed.ts",
    "db:migrate:tenants": "tsx src/migrate-tenants.ts",
    "db:seed:fiscal": "tsx src/seed-fiscal-existing.ts",
    "db:seed:pcasp-pr": "tsx src/seed-pcasp-pr.ts",
    "db:reseed:permissions": "tsx src/reseed-tenants.ts",
    "db:seed:orcamento-stn": "tsx src/seed-orcamento-stn.ts",
    "db:bootstrap:test": "tsx src/bootstrap-test-db.ts",
    "db:seed:folha:publico": "tsx src/seed-folha-publico.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@saas-municipal/auth": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
